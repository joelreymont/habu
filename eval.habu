;; eval.habu - Meta-circular evaluator for Habu (single-pass dispatch to avoid forward refs)
(defun env-empty () nil)
(defun env-extend (env name val) (cons (cons name val) env))
(defun sym-name-eq (s1 s2) (if (symbolp s1) (if (symbolp s2) (string= (symbol-name s1) (symbol-name s2)) nil) nil))
(defun env-lookup-aux (env name) (if (null env) nil (if (sym-name-eq (car (car env)) name) (car env) (env-lookup-aux (cdr env) name))))
(defun env-lookup (env name) (let ((pair (env-lookup-aux env name))) (if pair (cdr pair) nil)))
(defun atom? (x) (if (consp x) nil t))
(defun sym-eq (s name) (if (symbolp s) (string= (symbol-name s) name) nil))
(defun extend-env-args (params args env) (if (null params) env (env-extend (extend-env-args (cdr params) (cdr args) env) (car params) (car args))))
(defun habu-apply-prim (fn args) (if (sym-eq fn "+") (+ (car args) (car (cdr args))) (if (sym-eq fn "-") (- (car args) (car (cdr args))) (if (sym-eq fn "*") (* (car args) (car (cdr args))) (if (sym-eq fn "/") (/ (car args) (car (cdr args))) (if (sym-eq fn "=") (= (car args) (car (cdr args))) (if (sym-eq fn "<") (< (car args) (car (cdr args))) (if (sym-eq fn ">") (> (car args) (car (cdr args))) (if (sym-eq fn "cons") (cons (car args) (car (cdr args))) (if (sym-eq fn "car") (car (car args)) (if (sym-eq fn "cdr") (cdr (car args)) (if (sym-eq fn "null") (null (car args)) nil))))))))))))
(defun habu-eval (expr env mode acc) (if (= mode 0) (if (null expr) nil (if (atom? expr) (if (numberp expr) expr (if (symbolp expr) (env-lookup env expr) expr)) (let ((head (car expr))) (if (sym-eq head "quote") (car (cdr expr)) (if (sym-eq head "if") (let ((test (habu-eval (car (cdr expr)) env 0 nil))) (if test (habu-eval (car (cdr (cdr expr))) env 0 nil) (if (cdr (cdr (cdr expr))) (habu-eval (car (cdr (cdr (cdr expr)))) env 0 nil) nil))) (if (sym-eq head "let") (habu-eval (cdr (cdr expr)) (habu-eval (car (cdr expr)) env 1 env) 3 nil) (if (sym-eq head "lambda") (list4 (intern "lambda") (car (cdr expr)) (cdr (cdr expr)) env) (if (sym-eq head "progn") (habu-eval (cdr expr) env 3 nil) (let ((fn (habu-eval (car expr) env 0 nil)) (args (habu-eval (cdr expr) env 4 nil))) (if (consp fn) (if (sym-eq (car fn) "lambda") (habu-eval (car (cdr (cdr fn))) (extend-env-args (car (cdr fn)) args (car (cdr (cdr (cdr fn))))) 3 nil) (habu-apply-prim fn args)) (habu-apply-prim fn args))))))))))) (if (= mode 1) (if (null expr) acc (let ((b (car expr))) (habu-eval (cdr expr) env 1 (env-extend acc (car b) (habu-eval (car (cdr b)) acc 0 nil))))) (if (= mode 2) (habu-eval expr env 3 nil) (if (= mode 3) (if (null expr) nil (if (null (cdr expr)) (habu-eval (car expr) env 0 nil) (progn (habu-eval (car expr) env 0 nil) (habu-eval (cdr expr) env 3 nil)))) (if (= mode 4) (if (null expr) nil (cons (habu-eval (car expr) env 0 nil) (habu-eval (cdr expr) env 4 nil))) nil))))))
(defun prim-env () (env-extend (env-extend (env-extend (env-extend (env-extend (env-extend (env-extend (env-extend (env-extend (env-extend (env-extend (env-empty) (intern "+") (intern "+")) (intern "-") (intern "-")) (intern "*") (intern "*")) (intern "/") (intern "/")) (intern "=") (intern "=")) (intern "<") (intern "<")) (intern ">") (intern ">")) (intern "cons") (intern "cons")) (intern "car") (intern "car")) (intern "cdr") (intern "cdr")) (intern "null") (intern "null")))
(defun eval-string (s) (habu-eval (read-string s) (prim-env) 0 nil))
(defun test-eval () (progn (print (eval-string "42")) (print (eval-string "(+ 1 2)")) (print (eval-string "(if (< 1 2) 10 20)")) (print (eval-string "(let ((x 5)) (+ x 3))")) (print (eval-string "((lambda (x) (+ x 1)) 10)")) t))
