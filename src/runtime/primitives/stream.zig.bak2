//! File Stream Operations
const std = @import("std");
const Value = @import("../value.zig").Value;
const Heap = @import("../heap.zig").Heap;
const Vector = @import("../objects.zig").Vector;
const String = @import("../objects.zig").String;

/// Stream object stored as a vector with file handle
/// Layout: [type-tag file-handle is-open? path]
pub fn primOpen(heap: *Heap, args: []const Value) !Value {
    if (args.len < 2) return error.InvalidArgument;
    
    const path_val = args[0];
    const mode_val = args[1];
    
    if (!path_val.isString()) return error.InvalidArgument;
    if (!mode_val.isSymbol()) return error.InvalidArgument;
    
    const path_str = path_val.toPtr(String);
    _ = path_str; const path = path_str.data[0..path_str.len];
    
    // For now, just create a placeholder vector
    // Real implementation would need file handle storage
    const vec = try heap.allocVector(4);
    const sym_stream = heap.intern("stream");
    vec.data[0] = sym_stream;
    vec.data[1] = path_val;
    vec.data[2] = Value.t;  // is-open
    vec.data[3] = mode_val;
    
    return Value.fromPtr(vec);
}

pub fn primClose(_: *Heap, args: []const Value) !Value {
    if (args.len < 1) return error.InvalidArgument;
    
    const stream = args[0];
    if (!stream.isVector()) return error.InvalidArgument;
    
    const vec = stream.toPtr(Vector);
    if (vec.len < 3) return error.InvalidArgument;
    
    // Mark as closed
    vec.data[2] = Value.nil;
    
    return Value.t;
}

