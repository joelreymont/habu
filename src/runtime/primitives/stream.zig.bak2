pub fn primWriteLine(heap: *Heap, args: []const Value) !Value {
    if (args.len < 2) return error.InvalidArgument;
    
    const stream = args[0];
    const line = args[1];
    
    if (!stream.isVector()) return error.InvalidArgument;
    if (!line.isString()) return error.InvalidArgument;
    
    // Placeholder - would write to file
    _ = heap;
    return Value.t;
}

