(defun make-gen (gen-fn shrink-fn) (cons gen-fn shrink-fn))
(defun gen-value (g) ((car g)))
(defun shrink-value (g val) ((cdr g) val))
(defun gen-int (min max) (make-gen (lambda () (+ min (random (+ 1 (- max min))))) (lambda (n) nil)))
(defun gen-bool () (make-gen (lambda () (= 1 (random 2))) (lambda (b) (if b (list1 nil) nil))))
(defun gen-nat (max) (gen-int 0 max))
(defun gen-pos (max) (gen-int 1 max))
(defun gen-list-aux (gen n acc) (if (zerop n) (reverse acc) (gen-list-aux gen (dec n) (cons (gen-value gen) acc))))
(defun gen-list (elem-gen len) (make-gen (lambda () (gen-list-aux elem-gen len nil)) (lambda (lst) nil)))
(defun gen-pair (gen-a gen-b) (make-gen (lambda () (list2 (gen-value gen-a) (gen-value gen-b))) (lambda (pair) nil)))
(define *trials* 100)
(defun run-trials (gen prop n total) (if (zerop n) (list2 t total) (let ((val (gen-value gen))) (if (prop val) (run-trials gen prop (dec n) total) (list3 nil val val)))))
(defun check-prop (gen prop) (run-trials gen prop *trials* *trials*))
(defun run-prop (name gen prop) (let ((result (check-prop gen prop))) (if (first result) (progn (print name) (print t) t) (progn (print name) (print nil) (print (third result)) nil))))
(defun prop-add-commutes (pair) (let ((a (first pair)) (b (second pair))) (= (+ a b) (+ b a))))
(defun prop-map-length (lst) (= (length (map inc lst)) (length lst)))
(defun run-all-props () (progn (print 1) (run-prop 1 (gen-pair (gen-int -100 100) (gen-int -100 100)) prop-add-commutes) (run-prop 2 (gen-list (gen-int 0 50) 5) prop-map-length) t))
