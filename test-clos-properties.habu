;; Property-based tests for CLOS
;; Uses QuickCheck-style properties

(load "quickcheck.habu")

(print "=== CLOS Property Tests ===\n")

;; Property 1: Instance predicate always returns true for instances
(defun prop-instance-predicate (name age)
  (defclass person () name age)
  (define p (make-person name age))
  (person-p p))

(quickcheck prop-instance-predicate
  (string-gen)
  (fixnum-gen))

(print "✓ Property: Instances always satisfy their predicate\n")

;; Property 2: Accessor returns what was passed to constructor
(defun prop-accessor-returns-argument (x y)
  (defclass point () x y)
  (define p (make-point x y))
  (and (= (point-x p) x)
       (= (point-y p) y)))

(quickcheck prop-accessor-returns-argument
  (fixnum-gen)
  (fixnum-gen))

(print "✓ Property: Accessors return constructor arguments\n")

;; Property 3: make-instance equivalent to constructor
(defun prop-make-instance-equivalent (name age)
  (defclass person () name age)
  (define p1 (make-person name age))
  (define p2 (make-instance 'person :name name :age age))
  (and (person-p p1)
       (person-p p2)
       (equal (person-name p1) (person-name p2))
       (equal (person-age p1) (person-age p2))))

(quickcheck prop-make-instance-equivalent
  (string-gen)
  (fixnum-gen))

(print "✓ Property: make-instance equivalent to constructor\n")

;; Property 4: Inheritance includes all parent slots
(defun prop-inheritance-includes-parent ()
  (defclass base () x y)
  (defclass derived (base) z)
  (define d (make-derived 1 2 3))
  (and (derived-p d)
       (= (derived-x d) 1)
       (= (derived-y d) 2)
       (= (derived-z d) 3)))

(test-property prop-inheritance-includes-parent)

(print "✓ Property: Inheritance includes all parent slots\n")

;; Property 5: Class predicates are mutually exclusive
(defun prop-predicates-exclusive ()
  (defclass class-a () x)
  (defclass class-b () y)
  (define a (make-class-a 1))
  (define b (make-class-b 2))
  (and (class-a-p a)
       (not (class-b-p a))
       (class-b-p b)
       (not (class-a-p b))))

(test-property prop-predicates-exclusive)

(print "✓ Property: Class predicates are mutually exclusive\n")

;; Property 6: Slot order is deterministic
(defun prop-slot-order-deterministic ()
  (defclass ordered () a b c d e)
  (define o1 (make-ordered 1 2 3 4 5))
  (define o2 (make-ordered 1 2 3 4 5))
  (and (= (ordered-a o1) (ordered-a o2))
       (= (ordered-b o1) (ordered-b o2))
       (= (ordered-c o1) (ordered-c o2))
       (= (ordered-d o1) (ordered-d o2))
       (= (ordered-e o1) (ordered-e o2))))

(test-property prop-slot-order-deterministic)

(print "✓ Property: Slot order is deterministic\n")

;; Property 7: Generic functions preserve identity
(defun prop-generic-identity ()
  (defgeneric id (x))
  (defclass test-id () val)
  (defmethod id ((t test-id)) (test-id-val t))
  (define t (make-test-id 42))
  (= (id t) 42))

(test-property prop-generic-identity)

(print "✓ Property: Generic functions preserve identity\n")

;; Oracle: Compare with known reference implementation
(defun oracle-class-behavior ()
  ;; Define class
  (defclass ref-class () x y)

  ;; Create instance
  (define inst (make-ref-class 10 20))

  ;; Oracle checks
  (and
    ;; 1. Instance is correct type
    (ref-class-p inst)
    ;; 2. Not other types
    (not (consp inst))
    (not (symbolp inst))
    ;; 3. Accessors work
    (= (ref-class-x inst) 10)
    (= (ref-class-y inst) 20)
    ;; 4. Predicate works on non-instances
    (not (ref-class-p 42))
    (not (ref-class-p "string"))
    ;; 5. make-instance works
    (define inst2 (make-instance 'ref-class :x 30 :y 40))
    (and (ref-class-p inst2)
         (= (ref-class-x inst2) 30))))

(if (oracle-class-behavior)
    (print "✓ Oracle: Class behavior matches specification\n")
    (print "✗ FAIL: Oracle check failed\n"))

;; Metamorphic test: Inheritance transitivity
(defun metamorphic-inheritance ()
  (defclass a () x)
  (defclass b (a) y)
  (defclass c (b) z)

  (define obj (make-c 1 2 3))

  ;; Metamorphic property: c inherits from b which inherits from a
  ;; Therefore c should have all slots from a, b, and c
  (and (= (c-x obj) 1)  ; From a
       (= (c-y obj) 2)  ; From b
       (= (c-z obj) 3))) ; From c

(if (metamorphic-inheritance)
    (print "✓ Metamorphic: Inheritance is transitive\n")
    (print "✗ FAIL: Inheritance transitivity broken\n"))

;; Invariant: Instance structure
(defun invariant-instance-structure ()
  (defclass inv-test () a b c)
  (define inst (make-inv-test 1 2 3))

  ;; Invariant: Instance is a vector
  (and (vectorp inst)
       ;; First element is class name
       (eq (aref inst 0) 'inv-test)
       ;; Remaining elements are slot values
       (= (aref inst 1) 1)
       (= (aref inst 2) 2)
       (= (aref inst 3) 3)))

(if (invariant-instance-structure)
    (print "✓ Invariant: Instance structure preserved\n")
    (print "✗ FAIL: Instance structure broken\n"))

(print "\n=== All CLOS property tests passed! ===")
