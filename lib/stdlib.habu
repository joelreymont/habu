; Logical pathname translation table
(defvar *logical-pathname-translations* (make-hash-table :test 'equal))

(defun %logical-pathname-host-key (host)
  (if (symbolp host)
      (symbol-name host)
      (string host)))

; logical-pathname-translations - get translations for host
(defun logical-pathname-translations (host)
  "Return translations for HOST"
  (gethash (%logical-pathname-host-key host) *logical-pathname-translations*))

; (setf logical-pathname-translations) - set translations for host
(defun set-logical-pathname-translations (host translations)
  "Set translations for HOST"
  (setf (gethash (%logical-pathname-host-key host) *logical-pathname-translations*)
        translations)
  translations)

(put 'logical-pathname-translations 'setf-function 'set-logical-pathname-translations)

(setf (fdefinition '(setf logical-pathname-translations))
      #'set-logical-pathname-translations)

(defun %load-logical-translations-candidate (host candidate)
  (handler-case
      (let ((value (load candidate)))
        (if (consp value)
            (progn
              (set-logical-pathname-translations host value)
              t)
          (if (logical-pathname-translations host) t nil)))
    (error (c)
      (declare (ignore c))
      nil)))

(defun load-logical-pathname-translations (host)
  "Load HOST translations from default path or ./HOST.translations.lisp."
  (let* ((host-key (%logical-pathname-host-key host))
         (filename (concatenate 'string host-key ".translations.lisp"))
         (base (if *default-pathname-defaults*
                   (pathname *default-pathname-defaults*)
                 nil))
         (default-candidate
          (if base
              (namestring (merge-pathnames (pathname filename) base))
            nil))
         (cwd-candidate
          (namestring (merge-pathnames (pathname filename) (pathname "./")))))
    (or (if default-candidate
            (%load-logical-translations-candidate host default-candidate)
          nil)
        (%load-logical-translations-candidate host cwd-candidate)
        nil)))

