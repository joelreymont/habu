; Habu Standard Library

; Define stdlib in COMMON-LISP, then return to CL-USER.
(in-package "COMMON-LISP")

; Core sequence utilities - must be early (needed by macros)
; Internal helper: reverse proper list without relying on later stdlib defs.
(defun %map-reverse (lst)
  (let ((acc nil)
        (cur lst))
    (while (consp cur)
      (setq acc (cons (car cur) acc))
      (setq cur (cdr cur)))
    acc))

; Ensure APPLY/FUNCALL have function-cell bindings for SYMBOL-FUNCTION/FDEFINITION.
; Body calls to APPLY still compile to VM apply opcode.
(defun apply (fn &rest args)
  (if (null args)
      (error "APPLY requires at least one argument list")
    (let ((cur args)
          (head-rev nil))
      (while (consp (cdr cur))
        (setq head-rev (cons (car cur) head-rev))
        (setq cur (cdr cur)))
      (let ((tail (car cur)))
        (while (consp head-rev)
          (setq tail (cons (car head-rev) tail))
          (setq head-rev (cdr head-rev)))
        (apply fn tail)))))

(defun funcall (fn &rest args)
  (apply fn args))

; CL MAP: (map result-type function sequence &rest more-sequences)
(defun map (result-type fn &rest sequences)
  (if (null sequences)
      (error "MAP requires at least one sequence")
    (let ((all-lists t)
          (seq-check sequences))
      (while (consp seq-check)
        (let ((seq (car seq-check)))
          (if (or (null seq) (consp seq))
              nil
            (setq all-lists nil)))
        (setq seq-check (cdr seq-check)))
      (if all-lists
          (let ((acc nil)
                (active sequences))
            (block nil
              (while t
                (let ((scan active))
                  (while (consp scan)
                    (if (null (car scan))
                        (return-from nil nil)
                      nil)
                    (setq scan (cdr scan))))
                (let ((args nil)
                      (next-active nil)
                      (seqs active))
                  (while (consp seqs)
                    (let ((seq (car seqs)))
                      (setq args (cons (car seq) args))
                      (setq next-active (cons (cdr seq) next-active)))
                    (setq seqs (cdr seqs)))
                  (setq args (%map-reverse args))
                  (setq active (%map-reverse next-active))
                  (if result-type
                      (setq acc (cons (apply fn args) acc))
                    (apply fn args)))))
            (if result-type
                (let ((out (%map-reverse acc)))
                  (if (eq result-type 'list)
                      out
                    (coerce out result-type)))
              nil))
        (let ((limit (length (car sequences))))
          (let ((seqs (cdr sequences)))
            (while (consp seqs)
              (let ((seq-len (length (car seqs))))
                (if (< seq-len limit)
                    (setq limit seq-len)
                  nil))
              (setq seqs (cdr seqs))))
          (let ((acc nil)
                (i 0))
            (while (< i limit)
        (let ((args nil)
              (seqs sequences))
          (while (consp seqs)
            (let ((seq (car seqs)))
              (setq args
                    (cons (if (consp seq)
                              (nth i seq)
                              (aref seq i))
                          args)))
            (setq seqs (cdr seqs)))
                (setq args (%map-reverse args))
                (if result-type
                    (setq acc (cons (apply fn args) acc))
                  (apply fn args)))
              (setq i (+ i 1)))
            (if result-type
                (coerce (%map-reverse acc) result-type)
              nil)))))))

(defun mapcar (f &rest lists)
  (if (null lists)
      nil
    (if (null (cdr lists))
        (let ((acc nil)
              (cur (car lists)))
          (while (consp cur)
            (setq acc (cons (funcall f (car cur)) acc))
            (setq cur (cdr cur)))
          (%map-reverse acc))
      (if (null (cddr lists))
          (mapcar2 f (car lists) (cadr lists))
        (let ((acc nil)
              (active lists))
          (block nil
            (while t
              (let ((scan active))
                (while (consp scan)
                  (let ((seq (car scan)))
                    (if (or (null seq) (not (consp seq)))
                        (return-from nil nil)
                      nil))
                  (setq scan (cdr scan))))
              (let ((args nil)
                    (next-active nil)
                    (seqs active))
                (while (consp seqs)
                  (let ((seq (car seqs)))
                    (setq args (cons (car seq) args))
                    (setq next-active (cons (cdr seq) next-active)))
                  (setq seqs (cdr seqs)))
                (setq args (%map-reverse args))
                (setq active (%map-reverse next-active))
                (setq acc (cons (apply f args) acc)))))
          (%map-reverse acc))))))

(defun mapcar2 (f lst1 lst2)
  (let ((acc nil)
        (cur1 lst1)
        (cur2 lst2))
    (while (and (consp cur1) (consp cur2))
      (setq acc (cons (funcall f (car cur1) (car cur2)) acc))
      (setq cur1 (cdr cur1))
      (setq cur2 (cdr cur2)))
    (%map-reverse acc)))

; VECTOR function (for function designators like #'vector in APPLY/MAPCAR)
(defun vector (&rest elems)
  (let ((v (make-vector (length elems) nil))
        (i 0)
        (cur elems))
    (while (consp cur)
      (%svset v i (car cur))
      (setq i (+ i 1))
      (setq cur (cdr cur)))
    v))

; case - dispatch on value (must be early, uses mapcar)
; Note: In Habu, 't' at read time becomes the value t (= fixnum 1), not a symbol.
; So we check (eq keys t) not (eq keys 't)
(defmacro case (keyform &rest clauses)
  (let* ((key (gensym))
         (cond-clauses (mapcar
                        (lambda (clause)
                          (let ((keys (car clause))
                                (body (cdr clause)))
                            (if (or (eq keys t) (eq keys 'otherwise))
                                (cons t body)
                                `((member ,key ',(if (consp keys) keys (list keys)))
                                  (progn ,@body)))))
                        clauses)))
    `(let ((,key ,keyform))
       (cond ,@cond-clauses))))

; quasiquote/backquote - must be first (no dependencies)
(defun qq-expand (x)
  (if (not (consp x))
      (list 'quote x)
    (if (eq (car x) 'unquote)
        (cadr x)
      (if (and (consp (car x)) (eq (caar x) 'unquote-splicing))
          (list 'append (cadar x) (qq-expand (cdr x)))
        (list 'cons (qq-expand (car x)) (qq-expand (cdr x)))))))

(defmacro quasiquote (x)
  (qq-expand x))

; defconstant - define constant (same as defvar for now)
(defmacro defconstant (name value &optional doc)
  (declare (ignore doc))
  `(defvar ,name ,value))

; defparameter - define parameter (same as defvar)
(defmacro defparameter (name value &optional doc)
  (declare (ignore doc))
  `(defvar ,name ,value))

; Mathematical constants
(defvar pi 3.141592653589793)
(defvar e 2.718281828459045)

