; restart-bind - bind restart handlers
(defmacro restart-bind (bindings &body body)
  "Establish restart bindings"
  (let ((form `(progn ,@body)))
    (dolist (binding (reverse bindings) form)
      (let* ((name (car binding))
             (fn (cadr binding)))
        (setq form
              `(restart-case
                   ,form
                 (,name ()
                        (funcall ,fn))))))))

