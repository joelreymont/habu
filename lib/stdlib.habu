(defconstant most-negative-fixnum -4611686018427387904) ; -2^62
(defconstant array-dimension-limit 4611686018427387903)
(defconstant array-rank-limit 65536)
(defconstant array-total-size-limit 4611686018427387903)
(defconstant call-arguments-limit 65536)
(defconstant char-code-limit 1114112) ; Unicode range
(defconstant lambda-parameters-limit 65536)
(defconstant multiple-values-limit 256)

