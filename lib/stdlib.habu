;; Habu Standard Library

;; List utilities
(defun list3 (a b c)
  "Create a 3-element list"
  (cons a (cons b (cons c nil))))

(defun reverse (lst)
  "Reverse a list"
  (let ((acc nil))
    (while (not (null? lst))
      (set! acc (cons (car lst) acc))
      (set! lst (cdr lst)))
    acc))

(defun map (fn lst)
  "Apply function to each element of list"
  (if (null? lst)
      nil
      (cons (fn (car lst))
            (map fn (cdr lst)))))

;; Logic operations
(defun logorc1 (a b)
  "Bitwise OR with NOT of first argument"
  (logior (lognot a) b))

(defun logorc2 (a b)
  "Bitwise OR with NOT of second argument"
  (logior a (lognot b)))

(defun logtest (a b)
  "Test if any bits set in both arguments"
  (not (zerop (logand a b))))
