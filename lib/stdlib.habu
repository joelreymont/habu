;;; Habu Standard Library
;;; Core functions for self-hosting

;;; Helper: format with args list (since format isn't first-class)
(defun format-args (msg args)
  ;; Manually expand common cases since we can't apply format
  (let ((n (length args)))
    (cond
      ((= n 0) (format nil msg))
      ((= n 1) (format nil msg (car args)))
      ((= n 2) (format nil msg (car args) (cadr args)))
      ((= n 3) (format nil msg (car args) (cadr args) (caddr args)))
      (t msg))))  ; fallback - just return message

;;; Error signaling
;; error - signal an error with formatted message (throws 'error for catch/ignore-errors)
(defun error (message &rest args)
  (let ((msg (if args (format-args message args) message)))
    (throw 'error msg)))

;;; Control flow macros (now with &rest support)
(defmacro when (test &rest body)
  `(if ,test (progn ,@body) nil))

(defmacro unless (test &rest body)
  `(if ,test nil (progn ,@body)))

(defmacro when-let (bindings &rest body)
  (let ((var (car (car bindings)))
        (expr (car (cdr (car bindings)))))
    `(let ((,var ,expr))
       (when ,var
         ,@body))))

(defmacro if-let (bindings then &optional else)
  (let ((var (car (car bindings)))
        (expr (car (cdr (car bindings)))))
    `(let ((,var ,expr))
       (if ,var
           ,then
           ,else))))

(defmacro assert (test &rest args)
  `(unless ,test
     (error "Assertion failed: ~S" ',test)))

;; ignore-errors - evaluate form, return nil on error
(defmacro ignore-errors (&rest forms)
  `(catch 'error (progn ,@forms)))

;; destructuring-bind - bind variables from a destructured list
;; Simple version - supports flat and nested lists
(defun db-gen-bindings (pattern expr)
  "Generate let bindings for destructuring-bind"
  (cond
    ((null pattern) nil)
    ((symbolp pattern)
     ;; Single variable binds whole expression
     (list (list pattern expr)))
    ((consp pattern)
     ;; List pattern - destructure
     (let ((car-pat (car pattern))
           (cdr-pat (cdr pattern)))
       (append
        (db-gen-bindings car-pat `(car ,expr))
        (db-gen-bindings cdr-pat `(cdr ,expr)))))
    (t nil)))

(defmacro destructuring-bind (pattern expr &rest body)
  (let ((tmp (gensym "val")))
    `(let ((,tmp ,expr))
       (let* ,(db-gen-bindings pattern tmp)
         ,@body))))

;; case - dispatch on symbol value
;; Helper function must come BEFORE macro (like do*-bindings before do*)
(defun case-to-cond (key clauses)
  (if (null clauses)
      nil
      (let ((clause (car clauses)))
        (let ((keys (car clause))
              (body (cdr clause)))
          (cons
           (if (eq keys 't)
               (cons 't body)
               (if (eq keys 'otherwise)
                   (cons 't body)
                   (if (consp keys)
                       (cons (list 'member key (list 'quote keys)) body)
                       (cons (list 'eq key (list 'quote keys)) body))))
           (case-to-cond key (cdr clauses)))))))

(defmacro case (keyform &rest clauses)
  (let ((key (gensym "key")))
    `(let ((,key ,keyform))
       (cond ,@(case-to-cond key clauses)))))

;; ecase - exhaustive case (error if no match)
(defun ecase-to-cond (key clauses)
  (if (null clauses)
      (list (list 't (list 'error "ecase: no matching clause")))
      (let ((clause (car clauses)))
        (let ((keys (car clause))
              (body (cdr clause)))
          (cons
           (if (consp keys)
               (cons (list 'member key (list 'quote keys)) body)
               (cons (list 'eq key (list 'quote keys)) body))
           (ecase-to-cond key (cdr clauses)))))))

(defmacro ecase (keyform &rest clauses)
  (let ((key (gensym "key")))
    `(let ((,key ,keyform))
       (cond ,@(ecase-to-cond key clauses)))))

;; typecase - dispatch on type
(defun typecase-to-cond (key clauses)
  (if (null clauses)
      nil
      (let ((clause (car clauses)))
        (let ((type-spec (car clause))
              (body (cdr clause)))
          (cons
           (if (eq type-spec 't)
               (cons 't body)
               (if (eq type-spec 'otherwise)
                   (cons 't body)
                   (cons (list 'typep key (list 'quote type-spec)) body)))
           (typecase-to-cond key (cdr clauses)))))))

(defmacro typecase (keyform &rest clauses)
  (let ((key (gensym "key")))
    `(let ((,key ,keyform))
       (cond ,@(typecase-to-cond key clauses)))))

;; return - return from nil block (shorthand for return-from nil)
(defmacro return (&optional value)
  `(return-from nil ,value))

;; prog - establish local bindings with implicit block for return
;; Note: Uses let-style bindings ((var init) ...) not CL-style (var) or (var init)
(defmacro prog (bindings &rest body)
  `(block nil
     (let ,bindings
       ,@body)))

;; prog* - like prog but with sequential bindings
(defmacro prog* (bindings &rest body)
  `(block nil
     (let* ,bindings
       ,@body)))

;;; Iteration macros
(defmacro dolist (binding &rest body)
  ;; (dolist (var list) body...) or (dolist (var list result) body...)
  (let ((var (car binding))
        (list-form (cadr binding))
        (result-form (if (cddr binding) (caddr binding) nil))
        (list-var (gensym "list")))
    `(let ((,list-var ,list-form))
       (block nil
         (while ,list-var
           (let ((,var (car ,list-var)))
             ,@body)
           (setq ,list-var (cdr ,list-var)))
         ,result-form))))

(defmacro dotimes (binding &rest body)
  ;; (dotimes (var count) body...) or (dotimes (var count result) body...)
  (let ((var (car binding))
        (count-form (cadr binding))
        (result-form (if (cddr binding) (caddr binding) nil))
        (count-var (gensym "count")))
    `(let ((,count-var ,count-form)
           (,var 0))
       (block nil
         (while (< ,var ,count-var)
           ,@body
           (setq ,var (+ ,var 1)))
         ,result-form))))

;;; Helper: extract (var init) pairs from do* bindings
(defun do*-bindings (bindings)
  (if (null bindings)
      nil
      (let ((b (car bindings)))
        (cons (list (car b) (cadr b))
              (do*-bindings (cdr bindings))))))

;;; Helper: extract (setq var step) forms from do* bindings
(defun do*-steps (bindings)
  (if (null bindings)
      nil
      (let ((b (car bindings)))
        (if (cddr b)  ; has step form?
            (cons (list 'setq (car b) (caddr b))
                  (do*-steps (cdr bindings)))
            (do*-steps (cdr bindings))))))

;;; do* - sequential iteration with stepping
;;; (do* ((var init step)...) (end-test result...) body...)
;;; Example: (do* ((i 0 (+ i 1))) ((>= i 5) i) (print i))
(defmacro do* (bindings end-clause &rest body)
  ;; Build let* bindings: ((var init) ...) from ((var init step) ...)
  (let ((let-bindings (do*-bindings bindings))
        (step-forms (do*-steps bindings))
        (end-test (car end-clause))
        (result-forms (cdr end-clause)))
    `(let* ,let-bindings
       (block nil
         (while (not ,end-test)
           ,@body
           ,@step-forms)
         ,@result-forms))))

;;; Helper: generate gensyms for parallel step
(defun do-gensyms (bindings)
  (if (null bindings)
      nil
      (cons (gensym "step") (do-gensyms (cdr bindings)))))

;;; Helper: build ((gensym step) ...) for bindings with steps
(defun do-temp-bindings (bindings gensyms)
  (if (null bindings)
      nil
      (let ((b (car bindings))
            (g (car gensyms)))
        (if (cddr b)  ; has step?
            (cons (list g (caddr b))
                  (do-temp-bindings (cdr bindings) (cdr gensyms)))
            (do-temp-bindings (cdr bindings) (cdr gensyms))))))

;;; Helper: build (setq var gensym) forms
(defun do-assigns (bindings gensyms)
  (if (null bindings)
      nil
      (let ((b (car bindings))
            (g (car gensyms)))
        (if (cddr b)  ; has step?
            (cons (list 'setq (car b) g)
                  (do-assigns (cdr bindings) (cdr gensyms)))
            (do-assigns (cdr bindings) (cdr gensyms))))))

;;; Helper: build parallel step form
;;; (let ((g1 step1) (g2 step2)...) (setq v1 g1) (setq v2 g2)...)
(defun do-parallel-step (bindings gensyms)
  (let ((temp-binds (do-temp-bindings bindings gensyms))
        (assigns (do-assigns bindings gensyms)))
    `(let ,temp-binds ,@assigns)))

;;; do - parallel iteration with stepping
;;; (do ((var init step)...) (end-test result...) body...)
;;; Example: (do ((i 0 (+ i 1)) (sum 0 (+ sum i))) ((>= i 5) sum))
;;; Unlike do*, all step forms see old values (parallel assignment)
(defmacro do (bindings end-clause &rest body)
  (let ((let-bindings (do*-bindings bindings))
        (step-gensyms (do-gensyms bindings))
        (end-test (car end-clause))
        (result-forms (cdr end-clause)))
    ;; Generate: (let ((v1 init1)...) (while (not end-test) body... (let ((g1 step1)...) (setq v1 g1)...)))
    `(let ,let-bindings
       (block nil
         (while (not ,end-test)
           ,@body
           ,(do-parallel-step bindings step-gensyms))
         ,@result-forms))))

;;; Simple loop macro - handles common cases
;;; Examples:
;;;   (loop for i from 1 to 5 collect i)        => (1 2 3 4 5)
;;;   (loop for x in '(1 2 3) collect (* x x))  => (1 4 9)
;;;   (loop repeat 3 collect "hi")              => ("hi" "hi" "hi")

;;; for VAR from START to END collect EXPR [finally FORMS*]
(defmacro loop-for-from-collect (var start end expr &rest maybe-finally)
  (let ((end-var (gensym "end"))
        (result (gensym "result"))
        (finally-forms nil))
    ;; Check if maybe-finally starts with 'finally keyword
    (if (and maybe-finally (eq (car maybe-finally) 'finally))
        (setq finally-forms (cdr maybe-finally))
        (setq finally-forms maybe-finally))
    `(let ((,var ,start)
           (,end-var ,end)
           (,result nil))
       (while (<= ,var ,end-var)
         (push ,expr ,result)
         (setq ,var (+ ,var 1)))
       ,@finally-forms
       (reverse ,result))))

;;; for VAR in LIST collect EXPR
(defmacro loop-for-in-collect (var lst expr)
  (let ((list-var (gensym "list"))
        (result (gensym "result")))
    `(let ((,list-var ,lst)
           (,result nil))
       (while ,list-var
         (let ((,var (car ,list-var)))
           (push ,expr ,result))
         (setq ,list-var (cdr ,list-var)))
       (reverse ,result))))

;;; repeat N collect EXPR
(defmacro loop-repeat-collect (n expr)
  (let ((count (gensym "count"))
        (i (gensym "i"))
        (result (gensym "result")))
    `(let ((,count ,n)
           (,i 0)
           (,result nil))
       (while (< ,i ,count)
         (push ,expr ,result)
         (setq ,i (+ ,i 1)))
       (reverse ,result))))

;;; for VAR from START to END sum EXPR - sum numeric values
(defmacro loop-for-from-sum (var start end expr &rest maybe-finally)
  (let ((end-var (gensym "end"))
        (sum (gensym "sum"))
        (finally-forms nil))
    ;; Check if maybe-finally starts with 'finally keyword
    (if (and maybe-finally (eq (car maybe-finally) 'finally))
        (setq finally-forms (cdr maybe-finally))
        (setq finally-forms maybe-finally))
    `(let ((,var ,start)
           (,end-var ,end)
           (,sum 0))
       (while (<= ,var ,end-var)
         (setq ,sum (+ ,sum ,expr))
         (setq ,var (+ ,var 1)))
       ,@finally-forms
       ,sum)))

;;; for VAR from START to END count EXPR - count truthy values
(defmacro loop-for-from-count (var start end expr &rest maybe-finally)
  (let ((end-var (gensym "end"))
        (count (gensym "count"))
        (finally-forms nil))
    ;; Check if maybe-finally starts with 'finally keyword
    (if (and maybe-finally (eq (car maybe-finally) 'finally))
        (setq finally-forms (cdr maybe-finally))
        (setq finally-forms maybe-finally))
    `(let ((,var ,start)
           (,end-var ,end)
           (,count 0))
       (while (<= ,var ,end-var)
         (if ,expr
             (setq ,count (+ ,count 1)))
         (setq ,var (+ ,var 1)))
       ,@finally-forms
       ,count)))

;;; for VAR from START to END append EXPR - concatenate result lists
(defmacro loop-for-from-append (var start end expr &rest maybe-finally)
  (let ((end-var (gensym "end"))
        (result (gensym "result"))
        (finally-forms nil))
    ;; Check if maybe-finally starts with 'finally keyword
    (if (and maybe-finally (eq (car maybe-finally) 'finally))
        (setq finally-forms (cdr maybe-finally))
        (setq finally-forms maybe-finally))
    `(let ((,var ,start)
           (,end-var ,end)
           (,result nil))
       (while (<= ,var ,end-var)
         (setq ,result (append ,result ,expr))
         (setq ,var (+ ,var 1)))
       ,@finally-forms
       ,result)))

;;; for VAR from START to END do BODY - execute body for side effects
(defmacro loop-for-from-do (var start end body finally-forms)
  (let ((end-var (gensym "end")))
    `(let ((,var ,start)
           (,end-var ,end))
       (while (<= ,var ,end-var)
         ,@body
         (setq ,var (+ ,var 1)))
       ,@finally-forms
       nil)))

;;; while CONDITION do BODY - loop while condition is true
(defmacro loop-while-do (condition &rest body)
  `(progn
     (while ,condition
       ,@body)
     nil))

;;; until CONDITION do BODY - loop until condition becomes true
(defmacro loop-until-do (condition &rest body)
  `(progn
     (while (not ,condition)
       ,@body)
     nil))

;;; Extended loop macro - supports:
;;;   (loop with VAR = EXPR for ...)
;;;   (loop for VAR from START to END collect EXPR [finally FORMS*])
;;;   (loop for VAR from START to END do BODY* [finally FORMS*])
;;;   (loop while CONDITION do BODY* [finally FORMS*])
;;;   (loop until CONDITION do BODY* [finally FORMS*])
;;; For other patterns, use the specialized macros directly
(defmacro loop (&rest clauses)
  (if (null clauses)
      nil
      (let ((first (car clauses)))
        (cond
          ;; (loop with var = expr ...rest...)
          ((eq first 'with)
           (let ((rest1 (cdr clauses)))  ;; (var = expr ...rest...)
             (if (null rest1) nil)
             (let ((var (car rest1))
                   (rest2 (cdr rest1)))  ;; (= expr ...rest...)
               (if (null rest2) nil)
               (if (not (eq (car rest2) '=)) nil)
               (let ((rest3 (cdr rest2)))  ;; (expr ...rest...)
                 (if (null rest3) nil)
                 (let ((init-expr (car rest3))
                       (rest4 (cdr rest3)))  ;; (...rest...)
                   ;; Recursively process the rest of the loop
                   (let ((inner-loop (cons 'loop rest4)))
                     `(let ((,var ,init-expr))
                        ,inner-loop)))))))

          ;; (loop while condition do forms*)
          ((eq first 'while)
           (if (and (cdr clauses) (cdr (cdr clauses)) (eq (car (cdr (cdr clauses))) 'do))
               (cons 'loop-while-do (cons (car (cdr clauses)) (cdr (cdr (cdr clauses)))))
               nil))

          ;; (loop until condition do forms*)
          ((eq first 'until)
           (if (and (cdr clauses) (cdr (cdr clauses)) (eq (car (cdr (cdr clauses))) 'do))
               (cons 'loop-until-do (cons (car (cdr clauses)) (cdr (cdr (cdr clauses)))))
               nil))

          ;; (loop for var from start to end collect expr)
          ;; (loop for var from start to end do body*)
          ;; clauses = (for var from start to end collect/do ...)
          ((eq first 'for)
           (let ((rest1 (cdr clauses)))  ;; (var from start to end collect/do ...)
             (if (null rest1) nil)
             (let ((var (car rest1))
                   (rest2 (cdr rest1)))  ;; (from start to end collect/do ...)
               (if (null rest2) nil)
               (if (not (eq (car rest2) 'from)) nil)
               (let ((rest3 (cdr rest2)))  ;; (start to end collect/do ...)
                 (if (null rest3) nil)
                 (let ((start (car rest3))
                       (rest4 (cdr rest3)))  ;; (to end collect/do ...)
                   (if (null rest4) nil)
                   (if (not (eq (car rest4) 'to)) nil)
                   (let ((rest5 (cdr rest4)))  ;; (end collect/do ...)
                     (if (null rest5) nil)
                     (let ((end (car rest5))
                           (rest6 (cdr rest5)))  ;; (collect/do ...)
                       (if (null rest6) nil)
                       (let ((action (car rest6)))
                         (cond
                           ((eq action 'collect)
                            (let ((rest7 (cdr rest6)))  ;; (expr [finally forms*])
                              (if (null rest7) nil)
                              (let ((expr (car rest7))
                                    (rest8 (cdr rest7)))  ;; ([finally forms*])
                                ;; rest8 may be (finally form1 form2 ...) or just ()
                                ;; Pass expr and all of rest8 to the macro
                                (cons 'loop-for-from-collect (cons var (cons start (cons end (cons expr rest8))))))))
                           ((eq action 'sum)
                            (let ((rest7 (cdr rest6)))  ;; (expr [finally forms*])
                              (if (null rest7) nil)
                              (let ((expr (car rest7))
                                    (rest8 (cdr rest7)))  ;; ([finally forms*])
                                (cons 'loop-for-from-sum (cons var (cons start (cons end (cons expr rest8))))))))
                           ((eq action 'count)
                            (let ((rest7 (cdr rest6)))  ;; (expr [finally forms*])
                              (if (null rest7) nil)
                              (let ((expr (car rest7))
                                    (rest8 (cdr rest7)))  ;; ([finally forms*])
                                (cons 'loop-for-from-count (cons var (cons start (cons end (cons expr rest8))))))))
                           ((eq action 'do)
                            (let ((body (cdr rest6)))  ;; (body*)
                              (cons 'loop-for-from-do (cons var (cons start (cons end body))))))
                           ((eq action 'append)
                            (let ((rest7 (cdr rest6)))
                              (if (null rest7) nil)
                              (let ((expr (car rest7))
                                    (rest8 (cdr rest7)))
                                (cons 'loop-for-from-append (cons var (cons start (cons end (cons expr rest8))))))))
                           (t nil))))))))))

          ;; Simple loop: (loop body...) - expands to (block nil (while t body...))
          (t `(block nil (while t ,@clauses)))))))

;;; Mutation macros (fixed arity)
(defmacro incf (place)
  `(setf ,place (+ ,place 1)))

(defmacro decf (place)
  `(setf ,place (- ,place 1)))

(defmacro incf-by (place delta)
  `(setf ,place (+ ,place ,delta)))

(defmacro decf-by (place delta)
  `(setf ,place (- ,place ,delta)))

;;; List mutation macros
(defmacro push (item place)
  `(setf ,place (cons ,item ,place)))

(defmacro pop (place)
  `(let ((result (car ,place)))
     (setf ,place (cdr ,place))
     result))


;;; List predicates (return nil or t)
(defun null? (x) (eq x nil))
(defun atom? (x) (not (consp x)))
(defun list? (x) (if (null? x) t (consp x)))

;;; List accessors
(defun caar ((x cons)) (car (car x)))
(defun cadr ((x cons)) (car (cdr x)))
(defun cdar ((x cons)) (cdr (car x)))
(defun cddr ((x cons)) (cdr (cdr x)))
(defun caaar ((x cons)) (car (car (car x))))
(defun caadr ((x cons)) (car (car (cdr x))))
(defun cadar ((x cons)) (car (cdr (car x))))
(defun caddr ((x cons)) (car (cdr (cdr x))))
(defun first ((x cons)) (car x))
(defun second ((x cons)) (cadr x))
(defun third ((x cons)) (caddr x))
(defun rest ((x cons)) (cdr x))

;;; List constructors
(defun (list1 -> cons) (a) (cons a nil))
(defun (list2 -> cons) (a b) (cons a (cons b nil)))
(defun (list3 -> cons) (a b c) (cons a (cons b (cons c nil))))

;;; List operations
;; length, append, reverse are built-in primitives

(defun (reverse-acc -> list) ((lst list) (acc list))
  (if (null? lst)
      acc
      (reverse-acc (cdr lst) (cons (car lst) acc))))

;; make-list - create a list of N copies of initial-element
;; Supports both positional and keyword argument forms
(defun make-list-helper (size init)
  (if (<= size 0)
      nil
      (cons init (make-list-helper (- size 1) init))))

(defun make-list (size &rest args)
  (let ((init (cond
                ((null args) nil)
                ((keywordp (car args))  ; keyword form: :initial-element val
                 (if (eq (car args) :initial-element)
                     (cadr args)
                     nil))
                (t (car args)))))       ; positional form
    (make-list-helper size init)))

;; list* - like list but last arg becomes tail of resulting list
(defun list* (&rest args)
  (cond
    ((null args) nil)
    ((null (cdr args)) (car args))
    (t (cons (car args) (apply #'list* (cdr args))))))

;; list-length - return length of proper list, nil if circular
(defun list-length-helper (slow fast len)
  (cond
    ((null? fast) len)
    ((null? (cdr fast)) (+ len 1))
    ((eq slow fast) nil)  ; circular
    (t (list-length-helper (cdr slow) (cdr (cdr fast)) (+ len 2)))))

(defun list-length (lst)
  (if (null? lst)
      0
      (list-length-helper lst (cdr lst) 1)))

(defun nth ((n fixnum) (lst list))
  (if (= n 0)
      (car lst)
      (nth (- n 1) (cdr lst))))

(defun nthcdr ((n fixnum) (lst list))
  (if (= n 0)
      lst
      (nthcdr (- n 1) (cdr lst))))

(defun elt (seq n)
  (if (listp seq)
      (nth n seq)
      (aref seq n)))

(defun last ((lst cons))
  (if (null? (cdr lst))
      (car lst)
      (last (cdr lst))))

;;; Higher-order functions
(defun (map -> list) ((f closure) (lst list))
  (if (null? lst)
      nil
      (cons (f (car lst)) (map f (cdr lst)))))

(defun (mapcar -> list) ((f closure) (lst list))
  (map f lst))

(defun (mapc -> list) ((f closure) (lst list))
  (if (null? lst)
      lst
      (progn
        (f (car lst))
        (mapc f (cdr lst))
        lst)))

(defun (maplist -> list) ((f closure) (lst list))
  (if (null? lst)
      nil
      (cons (f lst) (maplist f (cdr lst)))))

(defun (filter -> list) ((pred closure) (lst list))
  (if (null? lst)
      nil
      (if (pred (car lst))
          (cons (car lst) (filter pred (cdr lst)))
          (filter pred (cdr lst)))))

(defun foldl ((f closure) acc (lst list))
  (if (null? lst)
      acc
      (foldl f (f acc (car lst)) (cdr lst))))

(defun foldr ((f closure) acc (lst list))
  (if (null? lst)
      acc
      (f (car lst) (foldr f acc (cdr lst)))))

(defun for-each ((f closure) (lst list))
  (if (null? lst)
      nil
      (progn
        (f (car lst))
        (for-each f (cdr lst)))))

;;; Association lists
;; assoc is a built-in primitive

(defun assoc-ref (key (alist list))
  (let ((pair (assoc key alist)))
    (if pair (cdr pair) nil)))

;; acons - add key-value pair to association list
(defun acons (key value alist)
  (cons (cons key value) alist))

;; pairlis - construct association list from two lists
(defun pairlis (keys values &optional alist)
  (if (or (null? keys) (null? values))
      alist
      (pairlis (cdr keys) (cdr values)
               (acons (car keys) (car values) alist))))

;; copy-list - shallow copy of a list
(defun copy-list (lst)
  (if (null lst)
      nil
      (cons (car lst) (copy-list (cdr lst)))))

;; copy-tree - deep copy of a tree structure
(defun copy-tree (tree)
  (if (consp tree)
      (cons (copy-tree (car tree)) (copy-tree (cdr tree)))
      tree))

;; copy-alist - copy an association list
(defun copy-alist (alist)
  (if (null? alist)
      nil
      (acons (car (car alist))
             (cdr (car alist))
             (copy-alist (cdr alist)))))

;;; Membership
;; member is a built-in primitive

(defun memq (x (lst list))
  (member x lst))

;;; Numeric utilities
;; abs is a built-in primitive

(defun min2 ((a fixnum) (b fixnum))
  (if (< a b) a b))

(defun max2 ((a fixnum) (b fixnum))
  (if (> a b) a b))

(defun zero? ((n fixnum)) (= n 0))
(defun positive? ((n fixnum)) (> n 0))
(defun negative? ((n fixnum)) (< n 0))
(defun even? ((n fixnum)) (= (mod n 2) 0))
(defun odd? ((n fixnum)) (not (even? n)))

;;; Boolean operations
(defun and2 (a b) (if a b nil))
(defun or2 (a b) (if a a b))

;;; String utilities (assuming string primitives exist)
;; (defun string-empty? (s) (= (string-length s) 0))

;; String comparison helper - returns <0, 0, or >0
(defun string-compare-helper (s1 s2 i len1 len2)
  (cond
    ((and (>= i len1) (>= i len2)) 0)      ; both exhausted - equal
    ((>= i len1) -1)                        ; s1 shorter
    ((>= i len2) 1)                         ; s2 shorter
    (t (let ((c1 (char s1 i))
             (c2 (char s2 i)))
         (cond
           ((< c1 c2) -1)
           ((> c1 c2) 1)
           (t (string-compare-helper s1 s2 (+ i 1) len1 len2)))))))

(defun string-compare (s1 s2)
  (string-compare-helper s1 s2 0 (string-length s1) (string-length s2)))

;; string< - lexicographic less than
(defun string< (s1 s2)
  (< (string-compare s1 s2) 0))

;; string> - lexicographic greater than
(defun string> (s1 s2)
  (> (string-compare s1 s2) 0))

;; string= - string equality
(defun string= (s1 s2)
  (= (string-compare s1 s2) 0))

;; string<= - lexicographic less than or equal
(defun string<= (s1 s2)
  (<= (string-compare s1 s2) 0))

;; string>= - lexicographic greater than or equal
(defun string>= (s1 s2)
  (>= (string-compare s1 s2) 0))

;; Helper: check if character code is in character-bag (bag contains character objects)
(defun char-in-bag (c bag)
  (if (null bag)
      nil
      (if (= c (char-code (car bag)))
          t
          (char-in-bag c (cdr bag)))))

;; Helper: find first non-whitespace from start
(defun string-trim-left-idx (s bag i len)
  (if (>= i len)
      len
      (if (char-in-bag (char s i) bag)
          (string-trim-left-idx s bag (+ i 1) len)
          i)))

;; Helper: find last non-whitespace from end
(defun string-trim-right-idx (s bag i)
  (if (<= i 0)
      0
      (if (char-in-bag (char s (- i 1)) bag)
          (string-trim-right-idx s bag (- i 1))
          i)))

;; string-trim - remove characters from both ends
(defun string-trim (char-bag string)
  (let* ((bag (if (stringp char-bag) (string-to-list char-bag) char-bag))
         (len (string-length string))
         (start (string-trim-left-idx string bag 0 len))
         (end (string-trim-right-idx string bag len)))
    (if (>= start end)
        ""
        (substring string start end))))

;; string-left-trim - remove characters from left
(defun string-left-trim (char-bag string)
  (let* ((bag (if (stringp char-bag) (string-to-list char-bag) char-bag))
         (len (string-length string))
         (start (string-trim-left-idx string bag 0 len)))
    (if (>= start len)
        ""
        (substring string start len))))

;; string-right-trim - remove characters from right
(defun string-right-trim (char-bag string)
  (let* ((bag (if (stringp char-bag) (string-to-list char-bag) char-bag))
         (len (string-length string))
         (end (string-trim-right-idx string bag len)))
    (if (<= end 0)
        ""
        (substring string 0 end))))

;;; Equality
(defun equal? (a b)
  (if (and2 (consp a) (consp b))
      (and2 (equal? (car a) (car b))
            (equal? (cdr a) (cdr b)))
      (eq a b)))

;;; CL-style reduce (alias for foldl)
(defun reduce ((f closure) (lst list))
  (if (null? lst)
      nil
      (if (null? (cdr lst))
          (car lst)
          (foldl f (car lst) (cdr lst)))))

;;; every/some/notevery/notany
(defun every ((pred closure) (lst list))
  (if (null? lst)
      t
      (if (pred (car lst))
          (every pred (cdr lst))
          nil)))

(defun some ((pred closure) (lst list))
  (if (null? lst)
      nil
      (if (pred (car lst))
          (car lst)
          (some pred (cdr lst)))))

(defun notevery ((pred closure) (lst list))
  (not (every pred lst)))

(defun notany ((pred closure) (lst list))
  (not (some pred lst)))

;;; find-if/remove-if/count-if
(defun find-if ((pred closure) (lst list))
  (if (null? lst)
      nil
      (if (pred (car lst))
          (car lst)
          (find-if pred (cdr lst)))))

(defun (remove-if -> list) ((pred closure) (lst list))
  (if (null? lst)
      nil
      (if (pred (car lst))
          (remove-if pred (cdr lst))
          (cons (car lst) (remove-if pred (cdr lst))))))

(defun (remove-if-not -> list) ((pred closure) (lst list))
  (filter pred lst))

(defun (count-if -> fixnum) ((pred closure) (lst list))
  (if (null? lst)
      0
      (if (pred (car lst))
          (+ 1 (count-if pred (cdr lst)))
          (count-if pred (cdr lst)))))

;;; rassoc - reverse assoc (search by value)
(defun rassoc (val (alist list))
  (if (null? alist)
      nil
      (if (eq val (cdar alist))
          (car alist)
          (rassoc val (cdr alist)))))

;;; butlast - all but last element
(defun (butlast -> list) ((lst list))
  (if (null? lst)
      nil
      (if (null? (cdr lst))
          nil
          (cons (car lst) (butlast (cdr lst))))))

;;; nthcdr - cdr n times
(defun (nthcdr -> list) ((n fixnum) (lst list))
  (if (= n 0)
      lst
      (nthcdr (- n 1) (cdr lst))))

;;; subseq - subsequence (simple version for lists)
(defun subseq (lst start end)
  (if (>= start end)
      nil
      (cons (nth start lst) (subseq lst (+ start 1) end))))

;;; identity function
(defun (identity -> any) (x) x)

;;; constantly - return a function that always returns the same value
(defun (constantly -> closure) (val)
  (lambda (x) val))

;;; complement - return a function that returns the opposite of pred
(defun (complement -> closure) ((pred closure))
  (lambda (x) (not (pred x))))

;;; Math utilities

;;; gcd - greatest common divisor (Euclidean algorithm)
(defun (gcd -> fixnum) ((a fixnum) (b fixnum))
  (if (= b 0)
      (abs a)
      (gcd b (mod a b))))

;;; lcm - least common multiple
(defun (lcm -> fixnum) ((a fixnum) (b fixnum))
  (if (or2 (= a 0) (= b 0))
      0
      (abs (* (/ a (gcd a b)) b))))

;;; expt - exponentiation (positive integer exponents)
(defun (expt -> fixnum) ((base fixnum) (exp fixnum))
  (if (= exp 0)
      1
      (if (even? exp)
          (let ((half (expt base (/ exp 2))))
            (* half half))
          (* base (expt base (- exp 1))))))

;;; Integer division utilities (for fixnums only)
(defun (truncate -> fixnum) ((n fixnum) (d fixnum))
  (/ n d))

(defun (floor-div -> fixnum) ((n fixnum) (d fixnum))
  (let ((q (/ n d)))
    (if (and2 (negative? (mod n d))
              (or2 (positive? n) (positive? d)))
        (if (and2 (negative? n) (positive? d))
            (- q 1)
            (if (and2 (positive? n) (negative? d))
                (- q 1)
                q))
        q)))

(defun (ceiling-div -> fixnum) ((n fixnum) (d fixnum))
  (let ((q (/ n d))
        (r (mod n d)))
    (if (= r 0)
        q
        (if (or2 (and2 (positive? n) (positive? d))
                (and2 (negative? n) (negative? d)))
            (+ q 1)
            q))))

;;; Sorting

;;; insert - insert element into sorted list
(defun (insert -> list) (x (lst list) (pred closure))
  (if (null? lst)
      (list1 x)
      (if (pred x (car lst))
          (cons x lst)
          (cons (car lst) (insert x (cdr lst) pred)))))

;;; sort - insertion sort (simple, stable)
(defun (sort -> list) ((lst list) (pred closure))
  (if (null? lst)
      nil
      (insert (car lst) (sort (cdr lst) pred) pred)))

;;; merge - merge two sorted lists
(defun (merge-lists -> list) ((lst1 list) (lst2 list) (pred closure))
  (cond
    ((null? lst1) lst2)
    ((null? lst2) lst1)
    ((pred (car lst1) (car lst2))
     (cons (car lst1) (merge-lists (cdr lst1) lst2 pred)))
    (t (cons (car lst2) (merge-lists lst1 (cdr lst2) pred)))))

;;; split-at - split list at position n
(defun (split-at -> cons) ((n fixnum) (lst list))
  (if (= n 0)
      (cons nil lst)
      (let ((rest (split-at (- n 1) (cdr lst))))
        (cons (cons (car lst) (car rest)) (cdr rest)))))

;;; split-half - split list into two halves
(defun (split-half -> cons) ((lst list))
  (let ((len (length lst)))
    (split-at (/ len 2) lst)))

;;; merge-sort - stable O(n log n) sort
(defun (merge-sort -> list) ((lst list) (pred closure))
  (if (or2 (null? lst) (null? (cdr lst)))
      lst
      (let ((halves (split-half lst)))
        (merge-lists (merge-sort (car halves) pred)
                     (merge-sort (cdr halves) pred)
                     pred))))

;;; Convenience
(defun (sort-asc -> list) ((lst list)) (sort lst (lambda (a b) (< a b))))
(defun (sort-desc -> list) ((lst list)) (sort lst (lambda (a b) (> a b))))

;;; Type introspection
;;; typep - check if value is of given type
(defun typep (x (type symbol))
  (eq (type-of x) type))

;;; Arithmetic helpers
(defun (inc -> fixnum) ((n fixnum)) (+ n 1))
(defun (dec -> fixnum) ((n fixnum)) (- n 1))

;;; Primitive wrappers (for passing to higher-order functions)
;;; Use: (reduce #'plus '(1 2 3 4)) instead of (reduce + ...)

;; Arithmetic
(defun (plus -> fixnum) ((a fixnum) (b fixnum)) (+ a b))
(defun (minus -> fixnum) ((a fixnum) (b fixnum)) (- a b))
(defun (times -> fixnum) ((a fixnum) (b fixnum)) (* a b))
(defun (divide -> fixnum) ((a fixnum) (b fixnum)) (/ a b))

;; Comparison
(defun less-than ((a fixnum) (b fixnum)) (< a b))
(defun greater-than ((a fixnum) (b fixnum)) (> a b))
(defun less-or-equal ((a fixnum) (b fixnum)) (<= a b))
(defun greater-or-equal ((a fixnum) (b fixnum)) (>= a b))
(defun equals ((a fixnum) (b fixnum)) (= a b))

;; Predicates (unary type wrappers)
(defun pos? ((x fixnum)) (plusp x))
(defun neg? ((x fixnum)) (minusp x))
(defun cons-pair? (x) (consp x))
(defun symbol-val? (x) (symbolp x))
(defun number-val? (x) (numberp x))
(defun string-val? (x) (stringp x))
(defun vector-val? (x) (vectorp x))

;; List ops
(defun (pair -> cons) (a b) (cons a b))

;;; zip - combine two lists into list of pairs
(defun (zip -> list) ((lst1 list) (lst2 list))
  (if (or2 (null? lst1) (null? lst2))
      nil
      (cons (cons (car lst1) (car lst2))
            (zip (cdr lst1) (cdr lst2)))))

;;; zip-with - combine two lists using function
(defun (zip-with -> list) ((f closure) (lst1 list) (lst2 list))
  (if (or2 (null? lst1) (null? lst2))
      nil
      (cons (funcall f (car lst1) (car lst2))
            (zip-with f (cdr lst1) (cdr lst2)))))

;;; partition - split list by predicate into (passing . failing)
(defun (partition -> cons) ((pred closure) (lst list))
  (if (null? lst)
      (cons nil nil)
      (let ((rest (partition pred (cdr lst))))
        (if (funcall pred (car lst))
            (cons (cons (car lst) (car rest)) (cdr rest))
            (cons (car rest) (cons (car lst) (cdr rest)))))))

;;; take-while - take elements while predicate holds
(defun (take-while -> list) ((pred closure) (lst list))
  (if (null? lst)
      nil
      (if (funcall pred (car lst))
          (cons (car lst) (take-while pred (cdr lst)))
          nil)))

;;; drop-while - drop elements while predicate holds
(defun (drop-while -> list) ((pred closure) (lst list))
  (if (null? lst)
      nil
      (if (funcall pred (car lst))
          (drop-while pred (cdr lst))
          lst)))

;;; assoc-update - add elem to list associated with key
(defun (assoc-update -> list) (key elem (alist list))
  (if (null? alist)
      (list1 (cons key (list1 elem)))
      (if (eq key (caar alist))
          (cons (cons key (cons elem (cdar alist))) (cdr alist))
          (cons (car alist) (assoc-update key elem (cdr alist))))))

;;; group-by-helper - helper for group-by
(defun (group-by-helper -> list) ((key-fn closure) (groups list) elem)
  (assoc-update (funcall key-fn elem) elem groups))

;;; group-by - group elements by key function
(defun (group-by -> list) ((key-fn closure) (lst list))
  (foldl (lambda (groups elem) (group-by-helper key-fn groups elem))
         nil
         lst))
;;; defstruct - define structure type with constructor, predicate, and accessors
;;; Example: (defstruct point x y) creates:
;;;   - Constructor: (make-point x y)
;;;   - Predicate: (point-p obj)
;;;   - Accessors: (point-x obj) (point-y obj)
;;; Implementation: Uses vectors with type tag at index 0
(defmacro defstruct (name-and-options &rest slots)
  (let* ((name (if (consp name-and-options)
                   (car name-and-options)
                   name-and-options))
         (options (if (consp name-and-options)
                      (cdr name-and-options)
                      nil))
         (constructor-name (intern (concatenate 'string "make-" (string-downcase (string-downcase (symbol-name name))))))
         (predicate-name (intern (concatenate 'string (string-downcase (string-downcase (symbol-name name))) "-p")))
         (slot-names (mapcar (lambda (s) (if (consp s) (car s) s)) slots))
         (slot-count (length slot-names)))

    ; Parse slot defaults
    (let ((slot-defaults (mapcar (lambda (s)
                                   (if (consp s)
                                       (if (cdr s) (cadr s) nil)
                                       nil))
                                 slots)))

      ; Generate forms
      (list 'progn
            ; Constructor: (defun make-NAME (arg1 arg2 ...) (vector 'NAME arg1 arg2 ...))
            (list 'defun constructor-name slot-names
                  (cons 'vector (cons (list 'quote name) slot-names)))

            ; Predicate: (defun NAME-p (obj) (and (vectorp obj) (> (length obj) 0) (eq (svref obj 0) 'NAME)))
            (list 'defun predicate-name '(obj)
                  (list 'and '(vectorp obj)
                        (list '> '(length obj) 0)
                        (list 'eq '(svref obj 0) (list 'quote name))))

            ; Accessors: (defun NAME-SLOT (obj) (svref obj N))
            (cons 'progn
                  (let ((i 1))
                    (mapcar (lambda (slot)
                              (let ((accessor-name (intern (concatenate 'string
                                                                        (string-downcase (symbol-name name))
                                                                        "-"
                                                                        (symbol-name slot))))
                                    (index i))
                                (setq i (+ i 1))
                                (list 'defun accessor-name '(obj)
                                      (list 'svref 'obj index))))
                            slot-names)))))))

;;; Generalized Reference (SETF)

;; setf macro - simplified inline expansion for built-in places
;; Extensibility via define-setf-expander would require runtime expansion
;; For now, keep the direct expansion for performance
(defmacro setf (place value)
  (if (consp place)
      (let ((op (car place))
            (args (cdr place)))
        (cond
          ((eq op 'car) `(rplaca ,(car args) ,value))
          ((eq op 'cdr) `(rplacd ,(car args) ,value))
          ((eq op 'aref) (let ((arr (car args))
                              (idx (car (cdr args))))
                          `(%aset ,arr ,idx ,value)))
          ((eq op 'gethash) `(puthash ,(car args) ,value ,(car (cdr args))))
          ((eq op 'nth) `(rplaca (nthcdr ,(car args) ,(car (cdr args))) ,value))
          ((eq op 'elt) (let ((seq-expr (car args))
                             (idx-expr (car (cdr args))))
                         `(let ((seq-temp ,seq-expr)
                                (idx-temp ,idx-expr))
                            (if (listp seq-temp)
                                (rplaca (nthcdr idx-temp seq-temp) ,value)
                                (%aset seq-temp idx-temp ,value)))))
          ((eq op 'slot-value) `(%set-slot-value ,(car args) ,(car (cdr args)) ,value))
          (t `(quote unsupported-setf-place))))
      `(setq ,place ,value)))

;; psetq helpers (must come before macro)
(defun psetq-pairs (args)
  (if (null args)
      nil
      (cons (cons (car args) (car (cdr args)))
            (psetq-pairs (cdr (cdr args))))))

(defun psetq-temps (n)
  (if (<= n 0)
      nil
      (cons (gensym "TEMP") (psetq-temps (- n 2)))))

(defun psetq-bindings (pairs temps)
  (if (null pairs)
      nil
      (cons (list (car temps) (cdr (car pairs)))
            (psetq-bindings (cdr pairs) (cdr temps)))))

(defun psetq-assignments (pairs temps)
  (if (null pairs)
      nil
      (cons `(setq ,(car (car pairs)) ,(car temps))
            (psetq-assignments (cdr pairs) (cdr temps)))))

;; psetq - parallel setq (evaluate all values before any assignment)
(defmacro psetq (&rest args)
  (if (null args)
      nil
      (let ((pairs (psetq-pairs args))
            (temps (psetq-temps (length args))))
        `(let ,(psetq-bindings pairs temps)
           ,@(psetq-assignments pairs temps)
           nil))))

;; rotatef helpers (must come before macro)
(defun rotatef-temps (n)
  (if (<= n 0)
      nil
      (cons (gensym "ROTATE") (rotatef-temps (- n 1)))))

(defun rotatef-bindings (places temps)
  (if (null places)
      nil
      (cons (list (car temps) (car places))
            (rotatef-bindings (cdr places) (cdr temps)))))

(defun rotatef-assignments-helper (places temps first-temp)
  ;; Rotate left: each place gets the next temp, last place gets first-temp
  (if (null places)
      nil
      (cons `(setf ,(car places) ,(if (null (cdr places))
                                       first-temp           ; last gets first
                                       (car (cdr temps))))  ; others get next
            (rotatef-assignments-helper (cdr places) (cdr temps) first-temp))))

;; rotatef - rotate values through places
(defmacro rotatef (&rest places)
  (if (null places)
      nil
      (if (null (cdr places))
          nil
          (let ((temps (rotatef-temps (length places))))
            `(let ,(rotatef-bindings places temps)
               ,@(rotatef-assignments-helper places temps (car temps))
               nil)))))

;;; List search and membership functions

;; member - find element in list, return tail from that element
(defun member (item lst)
  (cond
    ((null? lst) nil)
    ((eq (car lst) item) lst)
    (t (member item (cdr lst)))))

;; assoc - find key in association list
(defun assoc (key alist)
  (cond
    ((null? alist) nil)
    ((eq (car (car alist)) key) (car alist))
    (t (assoc key (cdr alist)))))

;; remove - remove all occurrences of item from list
(defun remove (item lst)
  (cond
    ((null? lst) nil)
    ((eq (car lst) item) (remove item (cdr lst)))
    (t (cons (car lst) (remove item (cdr lst))))))

;; position - find index of item in list (0-based)
(defun position-helper (item lst idx)
  (cond
    ((null? lst) nil)
    ((eq (car lst) item) idx)
    (t (position-helper item (cdr lst) (+ idx 1)))))

(defun position (item lst)
  (position-helper item lst 0))

;; find - find item in list, return the item (not the tail)
(defun find (item lst)
  (cond
    ((null? lst) nil)
    ((eq (car lst) item) item)
    (t (find item (cdr lst)))))

(defun find-if (predicate lst)
  (cond
    ((null? lst) nil)
    ((funcall predicate (car lst)) (car lst))
    (t (find-if predicate (cdr lst)))))

(defun position-if-helper (predicate lst idx)
  (cond
    ((null? lst) nil)
    ((funcall predicate (car lst)) idx)
    (t (position-if-helper predicate (cdr lst) (+ idx 1)))))

(defun position-if (predicate lst)
  (position-if-helper predicate lst 0))

;;; Standard CL type predicates

(defun listp (x)
  (if (null? x) t (consp x)))

;; Note: Habu's primitive numberp only checks fixnum
;; We define integerp as an alias and leave numberp as the primitive
(defun integerp (x)
  (numberp x))  ; In Habu, only fixnums are integers

(defun stringp (x)
  (stringp x))  ; Use the primitive

(defun functionp (x)
  (closurep x))

(defun characterp (x)
  (numberp x))  ; In CL, characters are separate but Habu uses fixnums

;; endp - test for end of list (nil or error if not list)
(defun endp (x)
  (null? x))

;;; Type coercion

;; Helper: convert vector to list (uses svref for simple vectors)
(defun vector-to-list-helper (vec idx len)
  (if (>= idx len)
      nil
      (cons (svref vec idx) (vector-to-list-helper vec (+ idx 1) len))))

(defun vector-to-list (vec)
  (vector-to-list-helper vec 0 (vector-length vec)))

;; Helper: convert list to vector (fill helper must come first)
(defun list-to-vector-fill (vec lst idx)
  (if (null lst)
      nil
      (progn
        (%aset vec idx (car lst))
        (list-to-vector-fill vec (cdr lst) (+ idx 1)))))

(defun list-to-vector (lst)
  (let ((v (make-array (length lst))))
    (list-to-vector-fill v lst 0)
    v))

;; coerce - convert obj to specified type
(defun coerce (obj result-type)
  (case result-type
    (list
     (cond
       ((listp obj) obj)
       ((stringp obj) (string-to-list obj))
       ((vectorp obj) (vector-to-list obj))
       (t (error "Cannot coerce to list"))))
    (vector
     (cond
       ((vectorp obj) obj)
       ((listp obj) (list-to-vector obj))
       ((stringp obj) (list-to-vector (string-to-list obj)))
       (t (error "Cannot coerce to vector"))))
    (string
     (cond
       ((stringp obj) obj)
       ((listp obj) (list-to-string obj))
       ((symbolp obj) (symbol-name obj))
       (t (error "Cannot coerce to string"))))
    (character
     (cond
       ((numberp obj) obj)
       ((and (stringp obj) (= (length obj) 1))
        (char obj 0))
       (t (error "Cannot coerce to character"))))
    (t (error "Unknown result type for coerce"))))

;;; Utility functions

;; identity - return the argument unchanged
(defun identity (x) x)

;; constantly - return a function that always returns the given value
(defun constantly (value)
  (lambda (x) value))

;; complement - return logical negation of predicate
(defun complement (pred)
  (lambda (x) (not (funcall pred x))))

;; incf/decf - increment/decrement place macros
(defmacro incf (place &optional (delta 1))
  `(setf ,place (+ ,place ,delta)))

(defmacro decf (place &optional (delta 1))
  `(setf ,place (- ,place ,delta)))

;; min - return minimum of numbers
(defun min (&rest numbers)
  (if (null numbers)
      (error "MIN called with no arguments")
      (reduce (lambda (a b) (if (< a b) a b)) numbers)))

;; max - return maximum of numbers
(defun max (&rest numbers)
  (if (null numbers)
      (error "MAX called with no arguments")
      (reduce (lambda (a b) (if (> a b) a b)) numbers)))

;;; Tree operations

;; subst - substitute new for old in tree (recursive)
(defun subst (new old tree)
  (cond
    ((eq tree old) new)
    ((atom tree) tree)
    (t (cons (subst new old (car tree))
             (subst new old (cdr tree))))))

;; substitute - replace occurrences in sequence (flat, not recursive)
(defun substitute (new old seq)
  (if (null seq)
      nil
      (cons (if (eql (car seq) old) new (car seq))
            (substitute new old (cdr seq)))))

;; tree-equal - test if two trees are structurally equal
(defun tree-equal (x y)
  (cond
    ((and (atom x) (atom y)) (eq x y))
    ((or (atom x) (atom y)) nil)
    (t (and (tree-equal (car x) (car y))
            (tree-equal (cdr x) (cdr y))))))

;;; Set operations (treating lists as sets)

;; union - return union of two sets
(defun union (set1 set2)
  (cond
    ((null? set1) set2)
    ((member (car set1) set2) (union (cdr set1) set2))
    (t (cons (car set1) (union (cdr set1) set2)))))

;; intersection - return intersection of two sets
(defun intersection (set1 set2)
  (cond
    ((null? set1) nil)
    ((member (car set1) set2)
     (cons (car set1) (intersection (cdr set1) set2)))
    (t (intersection (cdr set1) set2))))

;; set-difference - return elements in set1 not in set2
(defun set-difference (set1 set2)
  (cond
    ((null? set1) nil)
    ((member (car set1) set2) (set-difference (cdr set1) set2))
    (t (cons (car set1) (set-difference (cdr set1) set2)))))

;;; Property list functions

;; getf - get property from plist
(defun getf (plist key)
  (cond
    ((null? plist) nil)
    ((eq (car plist) key) (car (cdr plist)))
    (t (getf (cdr (cdr plist)) key))))

;;; Multiple value utilities

;; nth-value - return nth value from a multiple-value form
;; Uses multiple-value-list which captures all values as a list
(defmacro nth-value (n form)
  `(nth ,n (multiple-value-list ,form)))

;; Helper for multiple-value-setq
(defun mv-setq-gen (vars vals-sym idx)
  (if (null vars)
      nil
      (cons `(setq ,(car vars) (nth ,idx ,vals-sym))
            (mv-setq-gen (cdr vars) vals-sym (+ idx 1)))))

;; multiple-value-setq - set variables from multiple values
;; (multiple-value-setq (a b) form) sets a and b from values of form
(defmacro multiple-value-setq (vars form)
  (let ((vals (gensym "vals")))
    `(let ((,vals (multiple-value-list ,form)))
       ,@(mv-setq-gen vars vals 0)
       ,(car vars))))

;;; Additional list utilities

;; butlast - return list without last element
(defun butlast (lst)
  (if (null? (cdr lst))
      nil
      (cons (car lst) (butlast (cdr lst)))))

;; ldiff - return prefix of list1 before list2
(defun ldiff (list1 list2)
  (if (eq list1 list2)
      nil
      (cons (car list1) (ldiff (cdr list1) list2))))

;; tailp - test if sublist is a tail of list
(defun tailp (sublist list)
  (cond
    ((eq sublist list) t)
    ((null? list) nil)
    (t (tailp sublist (cdr list)))))

;; nconc - destructively concatenate lists
(defun nconc (list1 list2)
  (if (null? list1)
      list2
      (let ((tail (last list1)))
        (rplacd tail list2)
        list1)))

;; nreverse - destructively reverse list
(defun nreverse-helper (lst result)
  (if (null? lst)
      result
      (let ((next (cdr lst)))
        (rplacd lst result)
        (nreverse-helper next lst))))

(defun nreverse (lst)
  (nreverse-helper lst nil))

;; revappend - reverse list and append tail (non-destructive)
(defun revappend (lst tail)
  (append (reverse lst) tail))

;; nreconc - destructively reverse list and append tail
(defun nreconc (lst tail)
  (nconc (nreverse lst) tail))

;; mapcan - like mapcar but nconc results
(defun (mapcan -> list) ((f closure) (lst list))
  (if (null? lst)
      nil
      (nconc (f (car lst)) (mapcan f (cdr lst)))))

;; mapcon - like maplist but nconc results
(defun (mapcon -> list) ((f closure) (lst list))
  (if (null? lst)
      nil
      (nconc (f lst) (mapcon f (cdr lst)))))

;; Numeric predicates - wrappers for #'function syntax support
(defun zerop (x) (zerop x))
(defun plusp (x) (plusp x))
(defun minusp (x) (minusp x))
(defun evenp (x) (evenp x))
(defun oddp (x) (oddp x))
(defun abs (x) (abs x))

;;; Output Functions

;; prin1 - print object with escaping (machine-readable)
(defun prin1 (obj &optional stream)
  (format (or stream t) "~S" obj)
  obj)

;; write - standard CL write function
(defun write (obj &key stream)
  (format (or stream t) "~S" obj)
  obj)

;;; Stream I/O Operations

(defun open (path mode)
  (%open path mode))

(defun close (stream)
  (%close stream))

(defun read-line (stream)
  (%read-line stream))

(defun write-line (stream text)
  (%write-line stream text))

(defun read-byte (stream)
  (%read-byte stream))

(defun write-byte (stream byte)
  (%write-byte stream byte))

(defun file-position (stream)
  (%file-position stream))

(defun file-length (stream)
  (%file-length stream))

(defun finish-output (stream)
  (%finish-output stream))

(defun force-output (stream)
  (%force-output stream))

;;; SETF Expander Registry
;;; Global hash table mapping symbols to setf expander functions
;;; Used by define-setf-expander and get-setf-expansion
;;; defvar is a primitive that creates global variables

(defvar *setf-expanders* (make-hash-table))

;;; get-setf-expansion - retrieve the 5-value expansion for a place
;;; Returns: (values vars vals store-vars writer-form reader-form)
;;; For now, simplified version that returns list of 5 values

;; Helper functions must come first
(defun get-builtin-setf-expansion (op args)
  (case op
    (car
     (let ((obj (car args))
           (obj-temp (gensym "OBJ"))
           (store (gensym "STORE")))
       (list (list obj-temp) (list obj) (list store)
             (list 'rplaca obj-temp store)
             (list 'car obj-temp))))
    (cdr
     (let ((obj (car args))
           (obj-temp (gensym "OBJ"))
           (store (gensym "STORE")))
       (list (list obj-temp) (list obj) (list store)
             (list 'rplacd obj-temp store)
             (list 'cdr obj-temp))))
    (aref
     ;; Simplified: only handle single-index case for now
     (let ((arr (car args))
           (idx (car (cdr args)))
           (arr-temp (gensym "ARR"))
           (idx-temp (gensym "IDX"))
           (store (gensym "STORE")))
       (list (list arr-temp idx-temp)
             (list arr idx)
             (list store)
             (list '%aset arr-temp idx-temp store)
             (list 'aref arr-temp idx-temp))))
    (nth
     (let ((idx (car args))
           (lst (car (cdr args)))
           (idx-temp (gensym "IDX"))
           (lst-temp (gensym "LST"))
           (store (gensym "STORE")))
       (list (list idx-temp lst-temp) (list idx lst) (list store)
             (list 'rplaca (list 'nthcdr idx-temp lst-temp) store)
             (list 'nth idx-temp lst-temp))))
    (elt
     (let ((seq (car args))
           (idx (car (cdr args)))
           (seq-temp (gensym "SEQ"))
           (idx-temp (gensym "IDX"))
           (store (gensym "STORE")))
       (list (list seq-temp idx-temp) (list seq idx) (list store)
             (list 'if (list 'listp seq-temp)
                   (list 'rplaca (list 'nthcdr idx-temp seq-temp) store)
                   (list '%aset seq-temp idx-temp store))
             (list 'elt seq-temp idx-temp))))
    (gethash
     (let ((key (car args))
           (table (car (cdr args)))
           (key-temp (gensym "KEY"))
           (table-temp (gensym "TABLE"))
           (store (gensym "STORE")))
       (list (list key-temp table-temp) (list key table) (list store)
             (list 'puthash key-temp store table-temp)
             (list 'gethash key-temp table-temp))))
    (t
     ;; Unknown place type
     (list nil nil nil nil nil))))

(defun get-variable-setf-expansion (place)
  (let ((store (gensym "STORE")))
    (list nil nil (list store)
          (list 'setq place store)
          place)))

(defun get-compound-setf-expansion (place)
  (let ((op (car place))
        (args (cdr place)))
    (let ((expander (gethash op *setf-expanders*)))
      (if expander
          (apply expander args)
          (get-builtin-setf-expansion op args)))))

(defun get-setf-expansion (place)
  (if (consp place)
      (get-compound-setf-expansion place)
      (get-variable-setf-expansion place)))

;;; define-setf-expander - define custom setf expander
;;; Syntax: (define-setf-expander name lambda-list &body body)
;;; The body should return 5 values: vars, vals, store-vars, writer, reader

(defmacro define-setf-expander (name lambda-list &rest body)
  `(progn
     (puthash ',name
              (lambda ,lambda-list ,@body)
              *setf-expanders*)
     ',name))
