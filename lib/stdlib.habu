; compile - compile function
(defun compile (name &optional definition)
  "Compile NAME as a function and return (values function-or-name warnings-p failure-p)."
  (cond
    ((and (null name) definition)
     (let ((fn (if (functionp definition) definition (eval definition))))
       (values fn nil nil)))
    ((and name definition)
     (let ((fn (if (functionp definition) definition (eval definition))))
       (eval (list 'setf
                   (list 'fdefinition (list 'quote name))
                   fn))
       (values name nil nil)))
    (name
     (values (fdefinition name) nil nil))
    (t
     (values nil nil t))))

; compile-file - compile file (stub)
(defun compile-file (input-file &key output-file verbose print external-format)
  "Compile INPUT-FILE"
  (declare (ignore verbose print external-format))
  (let* ((in-path (pathname input-file))
         (out-path (compile-file-pathname in-path :output-file output-file)))
    (setf *compile-file-truename* in-path)
    (setf *compile-file-pathname* out-path)
    ;; Habu currently returns pathname metadata only; codegen is handled elsewhere.
    (values out-path nil nil)))

; compile-file-pathname - get output pathname (stub)
(defun compile-file-pathname (input-file &key output-file &allow-other-keys)
  "Return the pathname that compile-file would write"
  (let ((in-path (pathname input-file)))
    (if output-file
        (pathname output-file)
        (make-pathname :type "fasl" :defaults in-path))))

; disassemble - show bytecode disassembly
(defun disassemble (fn)
  "Display the disassembly of FN"
  (format t "~&Disassembly of ~A:~%" fn)
  (%disassemble fn))

; read-delimited-list - read until delimiter (stub)
(defun read-delimited-list (char &optional stream recursive-p)
  "Read objects until CHAR is encountered"
  (declare (ignore char recursive-p))
  (let ((result nil))
    (loop
      (let ((obj (read stream nil 'eof)))
        (when (eq obj 'eof)
          (return (nreverse result)))
        (push obj result)))))

; read-preserving-whitespace - read without consuming trailing whitespace
(defun read-preserving-whitespace (&optional stream eof-error-p eof-value recursive-p)
  "Read an object, preserving trailing whitespace"
  ;; In our simple implementation, same as read
  (read stream eof-error-p eof-value recursive-p))

