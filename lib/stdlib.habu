(put 'compiler-macro-function 'setf-function 'set-compiler-macro-function)

; read-sequence - read into sequence (stub)
(defun read-sequence (sequence stream &key (start 0) end)
  "Read elements into SEQUENCE from STREAM"
  (declare (ignore end))
  (let ((pos start))
    (if (stringp sequence)
        (dotimes (i (- (length sequence) start))
          (let ((ch (read-char stream nil nil)))
            (if ch
                (progn
                  (setf (char sequence pos) ch)
                  (incf pos))
                (return pos))))
        pos)
    pos))

; write-sequence - write from sequence (stub)
(defun write-sequence (sequence stream &key (start 0) end)
  "Write elements from SEQUENCE to STREAM"
  (let ((end-pos (or end (length sequence))))
    (if (stringp sequence)
        (do ((i start (1+ i)))
            ((>= i end-pos))
          (write-char (char sequence i) stream))
        (do ((i start (1+ i)))
            ((>= i end-pos))
          (write (elt sequence i) stream))))
  sequence)

