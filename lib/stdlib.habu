;;; Habu Standard Library
;;; Core functions for self-hosting

;;; List predicates
(defun null? (x) (eq x nil))
(defun atom? (x) (not (consp x)))
(defun list? (x) (if (null? x) t (consp x)))

;;; List accessors
(defun caar (x) (car (car x)))
(defun cadr (x) (car (cdr x)))
(defun cdar (x) (cdr (car x)))
(defun cddr (x) (cdr (cdr x)))
(defun caaar (x) (car (car (car x))))
(defun caadr (x) (car (car (cdr x))))
(defun cadar (x) (car (cdr (car x))))
(defun caddr (x) (car (cdr (cdr x))))
(defun first (x) (car x))
(defun second (x) (cadr x))
(defun third (x) (caddr x))
(defun rest (x) (cdr x))

;;; List constructors
(defun list1 (a) (cons a nil))
(defun list2 (a b) (cons a (cons b nil)))
(defun list3 (a b c) (cons a (cons b (cons c nil))))

;;; List operations
(defun length (lst)
  (if (null? lst)
      0
      (+ 1 (length (cdr lst)))))

(defun append (lst1 lst2)
  (if (null? lst1)
      lst2
      (cons (car lst1) (append (cdr lst1) lst2))))

(defun reverse-acc (lst acc)
  (if (null? lst)
      acc
      (reverse-acc (cdr lst) (cons (car lst) acc))))

(defun reverse (lst)
  (reverse-acc lst nil))

(defun nth (n lst)
  (if (= n 0)
      (car lst)
      (nth (- n 1) (cdr lst))))

(defun last (lst)
  (if (null? (cdr lst))
      (car lst)
      (last (cdr lst))))

;;; Higher-order functions
(defun map (f lst)
  (if (null? lst)
      nil
      (cons (f (car lst)) (map f (cdr lst)))))

(defun mapcar (f lst)
  (map f lst))

(defun mapc (f lst)
  (if (null? lst)
      lst
      (progn
        (f (car lst))
        (mapc f (cdr lst))
        lst)))

(defun maplist (f lst)
  (if (null? lst)
      nil
      (cons (f lst) (maplist f (cdr lst)))))

(defun filter (pred lst)
  (if (null? lst)
      nil
      (if (pred (car lst))
          (cons (car lst) (filter pred (cdr lst)))
          (filter pred (cdr lst)))))

(defun foldl (f acc lst)
  (if (null? lst)
      acc
      (foldl f (f acc (car lst)) (cdr lst))))

(defun foldr (f acc lst)
  (if (null? lst)
      acc
      (f (car lst) (foldr f acc (cdr lst)))))

(defun for-each (f lst)
  (if (null? lst)
      nil
      (progn
        (f (car lst))
        (for-each f (cdr lst)))))

;;; Association lists
(defun assoc (key alist)
  (if (null? alist)
      nil
      (if (eq key (caar alist))
          (car alist)
          (assoc key (cdr alist)))))

(defun assoc-ref (key alist)
  (let ((pair (assoc key alist)))
    (if pair (cdr pair) nil)))

;;; Membership
(defun member (x lst)
  (if (null? lst)
      nil
      (if (eq x (car lst))
          lst
          (member x (cdr lst)))))

(defun memq (x lst)
  (member x lst))

;;; Numeric utilities
(defun abs (n)
  (if (< n 0) (- 0 n) n))

(defun min (a b)
  (if (< a b) a b))

(defun max (a b)
  (if (> a b) a b))

(defun zero? (n) (= n 0))
(defun positive? (n) (> n 0))
(defun negative? (n) (< n 0))
(defun even? (n) (= (mod n 2) 0))
(defun odd? (n) (not (even? n)))

;;; Boolean operations
(defun and2 (a b) (if a b nil))
(defun or2 (a b) (if a a b))

;;; String utilities (assuming string primitives exist)
;; (defun string-empty? (s) (= (string-length s) 0))

;;; Equality
(defun equal? (a b)
  (if (and2 (consp a) (consp b))
      (and2 (equal? (car a) (car b))
            (equal? (cdr a) (cdr b)))
      (eq a b)))

;;; CL-style reduce (alias for foldl)
(defun reduce (f lst)
  (if (null? lst)
      nil
      (if (null? (cdr lst))
          (car lst)
          (foldl f (car lst) (cdr lst)))))

;;; every/some/notevery/notany
(defun every (pred lst)
  (if (null? lst)
      t
      (if (pred (car lst))
          (every pred (cdr lst))
          nil)))

(defun some (pred lst)
  (if (null? lst)
      nil
      (if (pred (car lst))
          (car lst)
          (some pred (cdr lst)))))

(defun notevery (pred lst)
  (not (every pred lst)))

(defun notany (pred lst)
  (not (some pred lst)))

;;; find-if/remove-if/count-if
(defun find-if (pred lst)
  (if (null? lst)
      nil
      (if (pred (car lst))
          (car lst)
          (find-if pred (cdr lst)))))

(defun remove-if (pred lst)
  (if (null? lst)
      nil
      (if (pred (car lst))
          (remove-if pred (cdr lst))
          (cons (car lst) (remove-if pred (cdr lst))))))

(defun remove-if-not (pred lst)
  (filter pred lst))

(defun count-if (pred lst)
  (if (null? lst)
      0
      (if (pred (car lst))
          (+ 1 (count-if pred (cdr lst)))
          (count-if pred (cdr lst)))))

;;; rassoc - reverse assoc (search by value)
(defun rassoc (val alist)
  (if (null? alist)
      nil
      (if (eq val (cdar alist))
          (car alist)
          (rassoc val (cdr alist)))))

;;; butlast - all but last element
(defun butlast (lst)
  (if (null? lst)
      nil
      (if (null? (cdr lst))
          nil
          (cons (car lst) (butlast (cdr lst))))))

;;; nthcdr - cdr n times
(defun nthcdr (n lst)
  (if (= n 0)
      lst
      (nthcdr (- n 1) (cdr lst))))

;;; subseq - subsequence (simple version)
(defun subseq (lst start end)
  (if (= start end)
      nil
      (cons (nth start lst) (subseq lst (+ start 1) end))))

;;; identity function
(defun identity (x) x)

;;; constantly - return a function that always returns the same value
(defun constantly (val)
  (lambda (x) val))

;;; complement - return a function that returns the opposite of pred
(defun complement (pred)
  (lambda (x) (not (pred x))))

;;; Math utilities

;;; gcd - greatest common divisor (Euclidean algorithm)
(defun gcd (a b)
  (if (= b 0)
      (abs a)
      (gcd b (mod a b))))

;;; lcm - least common multiple
(defun lcm (a b)
  (if (or2 (= a 0) (= b 0))
      0
      (abs (* (/ a (gcd a b)) b))))

;;; expt - exponentiation (positive integer exponents)
(defun expt (base exp)
  (if (= exp 0)
      1
      (if (even? exp)
          (let ((half (expt base (/ exp 2))))
            (* half half))
          (* base (expt base (- exp 1))))))

;;; Integer division utilities (for fixnums only)
(defun truncate (n d)
  (/ n d))

(defun floor-div (n d)
  (let ((q (/ n d)))
    (if (and2 (negative? (mod n d))
              (or2 (positive? n) (positive? d)))
        (if (and2 (negative? n) (positive? d))
            (- q 1)
            (if (and2 (positive? n) (negative? d))
                (- q 1)
                q))
        q)))

(defun ceiling-div (n d)
  (let ((q (/ n d))
        (r (mod n d)))
    (if (= r 0)
        q
        (if (or2 (and2 (positive? n) (positive? d))
                (and2 (negative? n) (negative? d)))
            (+ q 1)
            q))))
