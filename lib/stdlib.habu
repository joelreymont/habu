; Habu Standard Library

; Define stdlib in COMMON-LISP, then return to CL-USER.
(in-package "COMMON-LISP")

; Core list utilities - must be early (needed by macros)
(defun map (f lst)
  (if (null lst)
      nil
      (cons (funcall f (car lst)) (map f (cdr lst)))))

(defun mapcar (f &rest lists)
  (cond
    ((null lists) nil)
    ((null (cdr lists)) (map f (car lists)))
    ((null (cddr lists)) (mapcar2 f (car lists) (cadr lists)))
    (t (error "mapcar: >2 lists not yet supported"))))

(defun mapcar2 (f lst1 lst2)
  (if (or (null lst1) (null lst2))
      nil
    (cons (funcall f (car lst1) (car lst2))
          (mapcar2 f (cdr lst1) (cdr lst2)))))

; case - dispatch on value (must be early, uses mapcar)
; Note: In Habu, 't' at read time becomes the value t (= fixnum 1), not a symbol.
; So we check (eq keys t) not (eq keys 't)
(defmacro case (keyform &rest clauses)
  (let* ((key (gensym))
         (cond-clauses (mapcar
                        (lambda (clause)
                          (let ((keys (car clause))
                                (body (cdr clause)))
                            (if (or (eq keys t) (eq keys 'otherwise))
                                (cons t body)
                                `((member ,key ',(if (consp keys) keys (list keys)))
                                  (progn ,@body)))))
                        clauses)))
    `(let ((,key ,keyform))
       (cond ,@cond-clauses))))

; quasiquote/backquote - must be first (no dependencies)
(defun qq-expand (x)
  (if (not (consp x))
      (list 'quote x)
    (if (eq (car x) 'unquote)
        (cadr x)
      (if (and (consp (car x)) (eq (caar x) 'unquote-splicing))
          (list 'append (cadar x) (qq-expand (cdr x)))
        (list 'cons (qq-expand (car x)) (qq-expand (cdr x)))))))

(defmacro quasiquote (x)
  (qq-expand x))

; defconstant - define constant (same as defvar for now)
(defmacro defconstant (name value &optional doc)
  (declare (ignore doc))
  `(defvar ,name ,value))

; defparameter - define parameter (same as defvar)
(defmacro defparameter (name value &optional doc)
  (declare (ignore doc))
  `(defvar ,name ,value))

; Mathematical constants
(defvar pi 3.141592653589793)
(defvar e 2.718281828459045)

; Implementation limits
(defconstant most-positive-fixnum 4611686018427387903)  ; 2^62 - 1
(defconstant most-negative-fixnum -4611686018427387904) ; -2^62
(defconstant array-dimension-limit 4611686018427387903)
(defconstant array-rank-limit 65536)
(defconstant array-total-size-limit 4611686018427387903)
(defconstant call-arguments-limit 65536)
(defconstant char-code-limit 1114112) ; Unicode range
(defconstant lambda-parameters-limit 65536)
(defconstant multiple-values-limit 256)

; Float constants (using 64-bit IEEE 754)
(defconstant most-positive-double-float 1.7976931348623157e308)
(defconstant most-negative-double-float -1.7976931348623157e308)
(defconstant least-positive-double-float 2.2250738585072014e-308)
(defconstant least-negative-double-float -2.2250738585072014e-308)
(defconstant least-positive-normalized-double-float 2.2250738585072014e-308)
(defconstant least-negative-normalized-double-float -2.2250738585072014e-308)
(defconstant double-float-epsilon 2.220446049250313e-16)
(defconstant double-float-negative-epsilon 1.1102230246251565e-16)

; Single/long/short float = double (no separate types)
(defconstant most-positive-single-float most-positive-double-float)
(defconstant most-negative-single-float most-negative-double-float)
(defconstant least-positive-single-float least-positive-double-float)
(defconstant least-negative-single-float least-negative-double-float)
(defconstant least-positive-normalized-single-float least-positive-normalized-double-float)
(defconstant least-negative-normalized-single-float least-negative-normalized-double-float)
(defconstant single-float-epsilon double-float-epsilon)
(defconstant single-float-negative-epsilon double-float-negative-epsilon)
(defconstant most-positive-short-float most-positive-double-float)
(defconstant most-negative-short-float most-negative-double-float)
(defconstant least-positive-short-float least-positive-double-float)
(defconstant least-negative-short-float least-negative-double-float)
(defconstant least-positive-normalized-short-float least-positive-normalized-double-float)
(defconstant least-negative-normalized-short-float least-negative-normalized-double-float)
(defconstant short-float-epsilon double-float-epsilon)
(defconstant short-float-negative-epsilon double-float-negative-epsilon)
(defconstant most-positive-long-float most-positive-double-float)
(defconstant most-negative-long-float most-negative-double-float)
(defconstant least-positive-long-float least-positive-double-float)
(defconstant least-negative-long-float least-negative-double-float)
(defconstant least-positive-normalized-long-float least-positive-normalized-double-float)
(defconstant least-negative-normalized-long-float least-negative-normalized-double-float)
(defconstant long-float-epsilon double-float-epsilon)
(defconstant long-float-negative-epsilon double-float-negative-epsilon)

; Boole operation constants
(defconstant boole-clr 0)
(defconstant boole-set 1)
(defconstant boole-1 2)
(defconstant boole-2 3)
(defconstant boole-c1 4)
(defconstant boole-c2 5)
(defconstant boole-and 6)
(defconstant boole-ior 7)
(defconstant boole-xor 8)
(defconstant boole-eqv 9)
(defconstant boole-nand 10)
(defconstant boole-nor 11)
(defconstant boole-andc1 12)
(defconstant boole-andc2 13)
(defconstant boole-orc1 14)
(defconstant boole-orc2 15)

; Lambda list keywords constant
(defconstant lambda-list-keywords '(&optional &rest &key &aux &body &whole &environment &allow-other-keys))

; Internal time units (microseconds)
(defconstant internal-time-units-per-second 1000000)

; sleep - sleep for N seconds (stub - implement via FFI later)
(defun sleep (seconds)
  (declare (ignore seconds))
  nil)

; Printer control variables
(defvar *print-escape* t)
(defvar *print-case* :upcase)
(defvar *print-readably* nil)
(defvar *print-length* nil)
(defvar *print-level* nil)
(defvar *print-base* 10)
(defvar *print-radix* nil)
(defvar *print-gensym* t)
(defvar *print-array* t)
(defvar *print-circle* nil)
(defvar *print-pretty* nil)
(defvar *print-lines* nil)
(defvar *print-miser-width* nil)
(defvar *print-pprint-dispatch* nil)
(defvar *print-right-margin* nil)

; Reader control variables
(defvar *read-base* 10)
(defvar *read-default-float-format* 'double-float)
