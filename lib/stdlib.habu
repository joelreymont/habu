;; ============================================================
;; Condition System (CLOS-based)
;; ============================================================

;; Base condition class
(defclass condition ()
  ((format-control :initform nil)
   (format-arguments :initform nil)))

;; define-condition - define a condition type
;; Expands to defclass with the parent types (or condition if none)
(defmacro define-condition (name parent-types slots &rest options)
  (declare (ignore options))  ; TODO: support :report, :documentation
  (let ((parents (if (null parent-types) '(condition) parent-types)))
    `(defclass ,name ,parents ,slots)))

;; make-condition - alias for make-instance for condition types
;; Note: In Habu, defclass generates make-<classname> constructors,
;; so make-condition is already generated for the condition class.
;; Users can also use (make-instance 'condition-type ...) directly.

;; condition-type - get type of condition (class name)
(defun condition-type (condition)
  (if (and (consp condition) (symbolp (car condition)))
      (car condition)
    (class-name (class-of condition))))

(defun %condition-payload (condition)
  (if (and (consp condition) (symbolp (car condition)))
      (cdr condition)
    condition))

;; condition-slot - get slot value from condition
(defun condition-slot (condition slot-name)
  (slot-value condition slot-name))

;; Standard condition hierarchy
(define-condition simple-condition (condition)
  ((format-control :initform nil)
   (format-arguments :initform nil)))

(define-condition warning (condition) ())

(define-condition simple-warning (simple-condition warning) ())

(define-condition serious-condition (condition) ())

(define-condition error (serious-condition) ())

(define-condition simple-error (simple-condition error) ())

(define-condition type-error (error)
  ((datum :initform nil)
   (expected-type :initform nil)))

(define-condition cell-error (error)
  ((name :initform nil)))

(define-condition unbound-variable (cell-error) ())

(define-condition undefined-function (cell-error) ())

(define-condition control-error (error) ())

(define-condition program-error (error) ())

(define-condition arithmetic-error (error)
  ((operation :initform nil)
   (operands :initform nil)))

(define-condition division-by-zero (arithmetic-error) ())

(define-condition floating-point-inexact (arithmetic-error) ())

(define-condition floating-point-invalid-operation (arithmetic-error) ())

(define-condition floating-point-overflow (arithmetic-error) ())

(define-condition floating-point-underflow (arithmetic-error) ())

(define-condition unbound-slot (cell-error)
  ((instance :initform nil)))

(define-condition print-not-readable (error)
  ((object :initform nil)))

(define-condition file-error (error)
  ((pathname :initform nil)))

(define-condition stream-error (error)
  ((stream :initform nil)))

(define-condition package-error (error)
  ((package :initform nil)))

(define-condition end-of-file (stream-error) ())

(define-condition parse-error (error) ())

(define-condition reader-error (parse-error stream-error) ())

(define-condition simple-type-error (simple-condition type-error) ())

(define-condition storage-condition (serious-condition) ())

(define-condition style-warning (warning) ())

;; signal - signal a condition (can be handled and declined)
;; For now, uses throw; proper implementation would check handlers first
(defun signal-condition (condition)
  (throw '%condition% condition))

;; cerror - continuable error
(defun cerror (continue-format datum &rest arguments)
  "Signal a continuable SIMPLE-ERROR."
  (declare (ignore continue-format))
  (let ((condition (if (and (symbolp datum) (null arguments))
                       (make-condition datum)
                       (make-condition 'simple-error
                                       :format-control datum
                                       :format-arguments arguments))))
    (restart-case
      (signal 'simple-error condition)
      (continue (&optional c)
        (declare (ignore c))
        nil))))

;; Standard restart functions
;; These invoke the corresponding named restarts

; psetf - parallel setf (evaluate all values before assigning)
(defmacro psetf (&rest pairs)
  (if (null pairs)
      nil
      (let ((places nil)
            (values nil)
            (temps nil))
        ; Collect places, values, and generate temps
        (let ((rest pairs))
          (while rest
            (let ((place (car rest))
                  (value (cadr rest))
                  (temp (gensym "TEMP")))
              (push place places)
              (push (list temp value) temps)
              (push temp values)
              (setq rest (cddr rest)))))
        ; Generate let with all temps, then setf all places
        (let ((setf-forms nil)
              (pl (nreverse places))
              (vl (nreverse values)))
          (while pl
            (push (list 'setf (car pl) (car vl)) setf-forms)
            (setq pl (cdr pl))
            (setq vl (cdr vl)))
          (list 'let (nreverse temps)
                (cons 'progn (nreverse setf-forms)))))))

; rotatef - rotate values through places
; (rotatef a b c) => a gets old b, b gets old c, c gets old a
(defmacro rotatef (&rest places)
  (cond
    ((null places) nil)
    ((null (cdr places)) nil)
    ((null (cddr places))
     ; Two places: (rotatef a b)
     (let ((a (car places))
           (b (cadr places))
           (t1 (gensym))
           (t2 (gensym)))
       (list 'let (list (list t1 a) (list t2 b))
             (list 'setf a t2)
             (list 'setf b t1)
             nil)))
    ((null (cdddr places))
     ; Three places: (rotatef a b c)
     (let ((a (car places))
           (b (cadr places))
           (c (caddr places))
           (t1 (gensym))
           (t2 (gensym))
           (t3 (gensym)))
       (list 'let (list (list t1 a) (list t2 b) (list t3 c))
             (list 'setf a t2)
             (list 'setf b t3)
             (list 'setf c t1)
             nil)))
    (t
     ; Four+ places - rare, not yet supported
     (error "rotatef: more than 3 places not yet supported"))))


; shiftf - shift values through places, return first
; (shiftf a b c val) => returns old-a, sets a=old-b, b=old-c, c=val
(defmacro shiftf (&rest places-and-value)
  (let ((places (butlast places-and-value))
        (value (car (last places-and-value))))
    (cond
      ((null places) value)
      ((null (cdr places))
       ; One place: (shiftf a val) => (prog1 a (setf a val))
       (let ((result (gensym)))
         (list 'let (list (list result (car places)))
               (list 'setf (car places) value)
               result)))
      ((null (cddr places))
       ; Two places: (shiftf a b val)
       (let ((result (gensym))
             (t1 (gensym)))
         (list 'let (list (list result (car places))
                          (list t1 (cadr places)))
               (list 'setf (car places) t1)
               (list 'setf (cadr places) value)
               result)))
      ((null (cdddr places))
       ; Three places: (shiftf a b c val)
       (let ((result (gensym))
             (t1 (gensym))
             (t2 (gensym)))
         (list 'let (list (list result (car places))
                          (list t1 (cadr places))
                          (list t2 (caddr places)))
               (list 'setf (car places) t1)
               (list 'setf (cadr places) t2)
               (list 'setf (caddr places) value)
               result)))
      (t (error "shiftf: more than 3 places not yet supported")))))

;; ============================================================
;; Additional Utilities
;; ============================================================

; constantly - return a function that always returns value
(defun constantly (value)
  (lambda (&rest _args)
    value))

; complement - return negation of predicate
(defun complement (fn)
  (lambda (&rest args)
    (not (apply fn args))))

; compose - compose two functions
(defun compose (f g)
  (lambda (&rest args)
    (funcall f (apply g args))))

; identity - return argument unchanged
(defun identity (x) x)

; conjoin - combine predicates with AND
(defun conjoin (&rest predicates)
  (lambda (&rest args)
    (every (lambda (p) (apply p args)) predicates)))

; disjoin - combine predicates with OR
(defun disjoin (&rest predicates)
  (lambda (&rest args)
    (some (lambda (p) (apply p args)) predicates)))

; curry - partial application (first arg)
(defun curry (fn arg)
  (lambda (&rest args)
    (apply fn arg args)))

; rcurry - partial application (last arg)
(defun rcurry (fn arg)
  (lambda (&rest args)
    (apply fn (append args (list arg)))))

; flip - swap first two arguments
(defun flip (fn)
  (lambda (a b &rest args)
    (apply fn b a args)))

; juxt - apply multiple functions, return list of results
(defun juxt (&rest fns)
  (lambda (&rest args)
    (mapcar (lambda (f) (apply f args)) fns)))

;; ============================================================
;; List Utilities
;; ============================================================

; iota - generate list of integers
(defun iota (count &optional (start 0) (step 1))
  (if (<= count 0)
      nil
      (cons start (iota (- count 1) (+ start step) step))))

; partition - split list by predicate
(defun partition (pred lst)
  (let ((yes nil)
        (no nil))
    (dolist (x lst (values (nreverse yes) (nreverse no)))
      (if (funcall pred x)
          (push x yes)
          (push x no)))))

; partition-if - same as partition
(defun partition-if (pred lst)
  (partition pred lst))

; group-by - group elements by key function
(defun group-by (key-fn lst)
  (let ((groups (make-hash-table :test 'equal)))
    (dolist (x lst)
      (let ((k (funcall key-fn x)))
        (sethash k groups (cons x (gethash k groups nil)))))
    ; Convert to alist with reversed lists
    (let ((result nil))
      (dolist (pair (hash-table-alist groups) result)
        (setq result (cons (cons (car pair) (nreverse (cdr pair))) result))))))

; frequencies - count occurrences
(defun frequencies (lst)
  (let ((counts (make-hash-table :test 'equal)))
    (dolist (x lst)
      (sethash x counts (+ 1 (gethash x counts 0))))
    (hash-table-alist counts)))

; interpose - insert separator between elements
(defun interpose (sep lst)
  (if (or (null lst) (null (cdr lst)))
      lst
      (cons (car lst)
            (cons sep
                  (interpose sep (cdr lst))))))

; intersperse - same as interpose
(defun intersperse (sep lst)
  (interpose sep lst))

;; ============================================================
;; Tree and Association List Operations
;; ============================================================

; tree-equal - compare trees for structural equality
(defun tree-equal (a b &key (test #'eql))
  (cond
    ((and (consp a) (consp b))
     (and (tree-equal (car a) (car b) :test test)
          (tree-equal (cdr a) (cdr b) :test test)))
    ((or (consp a) (consp b)) nil)
    (t (funcall test a b))))

; subst - substitute new for old in tree
(defun subst (new old tree &key (test #'eql))
  (cond
    ((funcall test tree old) new)
    ((consp tree)
     (let ((new-car (subst new old (car tree) :test test))
           (new-cdr (subst new old (cdr tree) :test test)))
       (if (and (eq new-car (car tree))
                (eq new-cdr (cdr tree)))
           tree
           (cons new-car new-cdr))))
    (t tree)))

; subst-if - substitute new for elements satisfying pred
(defun subst-if (new pred tree)
  (cond
    ((funcall pred tree) new)
    ((consp tree)
     (cons (subst-if new pred (car tree))
           (subst-if new pred (cdr tree))))
    (t tree)))

; subst-if-not - substitute new for elements not satisfying pred
(defun subst-if-not (new pred tree)
  (subst-if new (lambda (x) (not (funcall pred x))) tree))

; nsubst - destructive tree substitution
(defun nsubst (new old tree &key (test #'eql))
  (cond
    ((funcall test tree old) new)
    ((consp tree)
     (setf (car tree) (nsubst new old (car tree) :test test))
     (setf (cdr tree) (nsubst new old (cdr tree) :test test))
     tree)
    (t tree)))

; nsubst-if - destructive substitute if predicate
(defun nsubst-if (new pred tree)
  (cond
    ((funcall pred tree) new)
    ((consp tree)
     (setf (car tree) (nsubst-if new pred (car tree)))
     (setf (cdr tree) (nsubst-if new pred (cdr tree)))
     tree)
    (t tree)))

; nsubst-if-not - destructive substitute if not predicate
(defun nsubst-if-not (new pred tree)
  (nsubst-if new (lambda (x) (not (funcall pred x))) tree))

; acons - add entry to front of alist
(defun acons (key value alist)
  (cons (cons key value) alist))

; pairlis - construct alist from parallel lists
(defun pairlis (keys values &optional alist)
  (if (or (null keys) (null values))
      alist
      (acons (car keys) (car values)
             (pairlis (cdr keys) (cdr values) alist))))

; rassoc - reverse assoc (search by value)
(defun rassoc (item alist &key (test #'eql))
  (if (null alist)
      nil
      (if (funcall test item (cdar alist))
          (car alist)
          (rassoc item (cdr alist) :test test))))

; rassoc-if - reverse assoc with predicate
(defun rassoc-if (pred alist)
  (if (null alist)
      nil
      (if (funcall pred (cdar alist))
          (car alist)
          (rassoc-if pred (cdr alist)))))

(defun rassoc-if-not (pred alist)
  (rassoc-if (lambda (x) (not (funcall pred x))) alist))

; copy-alist - copy association list (shallow copy of pairs)
(defun copy-alist (alist)
  (if (null alist)
      nil
      (cons (cons (caar alist) (cdar alist))
            (copy-alist (cdr alist)))))

;; ============================================================
;; Set Operations
;; ============================================================

; union - set union
(defun union (list1 list2 &key (test #'eql))
  (let ((result (copy-list list2)))
    (dolist (x list1 result)
      (unless (member x result :test test)
        (push x result)))))

(defun nunion (list1 list2 &key (test #'eql))
  (dolist (x list1 list2)
    (unless (member x list2 :test test)
      (push x list2))))

; intersection - set intersection
(defun intersection (list1 list2 &key (test #'eql))
  (let ((result nil))
    (dolist (x list1 (nreverse result))
      (when (member x list2 :test test)
        (push x result)))))

; nintersection - destructive intersection (same as intersection for now)
(defun nintersection (list1 list2 &key (test #'eql))
  (intersection list1 list2 :test test))

; set-difference - elements in list1 not in list2
(defun set-difference (list1 list2 &key (test #'eql))
  (let ((result nil))
    (dolist (x list1 (nreverse result))
      (unless (member x list2 :test test)
        (push x result)))))

; nset-difference - destructive set-difference (same for now)
(defun nset-difference (list1 list2 &key (test #'eql))
  (set-difference list1 list2 :test test))

; set-exclusive-or - symmetric difference
(defun set-exclusive-or (list1 list2 &key (test #'eql))
  (append (set-difference list1 list2 :test test)
          (set-difference list2 list1 :test test)))

(defun nset-exclusive-or (list1 list2 &key (test #'eql))
  (nconc (nset-difference list1 list2 :test test)
         (nset-difference list2 list1 :test test)))

; subsetp - check if list1 is subset of list2
; Note: wrapped to avoid tail-call closure bug with keyword args
(defun subsetp (list1 list2 &key (test #'eql))
  (every (lambda (x) (let ((r (member x list2 :test test))) r)) list1))

; adjoin - add item to set if not present
(defun adjoin (item list &key (test #'eql))
  (if (member item list :test test)
      list
      (cons item list)))

;; ============================================================
;; Numeric Utilities
;; ============================================================

; max - maximum of numbers
(defun max (first &rest rest)
  (foldl (lambda (a b) (if (> a b) a b)) first rest))

; min - minimum of numbers
(defun min (first &rest rest)
  (foldl (lambda (a b) (if (< a b) a b)) first rest))

; gcd - greatest common divisor
(defun gcd (&rest integers)
  (reduce #'gcd2 integers :initial-value 0))

(defun gcd2 (a b)
  (if (= b 0)
      (abs a)
      (gcd2 b (mod a b))))

; lcm - least common multiple
(defun lcm (&rest integers)
  (reduce #'lcm2 integers :initial-value 1))

(defun lcm2 (a b)
  (if (or (= a 0) (= b 0))
      0
      (abs (* (truncate a (gcd2 a b)) b))))

; expt - exponentiation
(defun expt (base power)
  (cond
    ((= power 0) 1)
    ((< power 0) (/ 1 (expt base (- power))))
    ((evenp power)
     (let ((half (expt base (truncate power 2))))
       (* half half)))
    (t (* base (expt base (- power 1))))))

; isqrt - integer square root
(defun isqrt (n)
  (cond
    ((< n 0) (error "ISQRT: negative argument ~A" n))
    ((< n 2) n)
    (t (let ((x n))
         (let ((y (truncate (+ x 1) 2)))
           (while (< y x)
             (setq x y)
             (setq y (truncate (+ x (truncate n x)) 2)))
           x)))))

; signum - sign of number
(defun signum (n)
  (cond ((< n 0) -1)
        ((> n 0) 1)
        (t 0)))

; truncate - truncate toward zero, returns (values quotient remainder)
; truncate - truncation division, returns (values quotient remainder)
; Note: uses helper to avoid if-values bug (if doesn't propagate secondary values)
(defun %truncate-impl (number divisor)
  (if (or (floatp number) (floatp divisor))
      (let* ((q-float (/ number divisor))
             (q (if (< q-float 0)
                    (%ceiling q-float)
                    (%floor q-float)))
             (r (- number (* q divisor))))
        (values q r))
      (let* ((q (quot number divisor))
             (r (- number (* q divisor))))
        (values q r))))

(defun truncate (number &optional (divisor 1))
  (%truncate-impl number divisor))

; floor - floor division, returns (values quotient remainder)
(defun %floor-impl (number divisor)
  (multiple-value-bind (q r) (%truncate-impl number divisor)
    (if (and (not (zerop r))
             (if (< divisor 0) (> number 0) (< number 0)))
        (values (- q 1) (+ r divisor))
        (values q r))))

(defun floor (number &optional (divisor 1))
  (%floor-impl number divisor))

; ceiling - ceiling division, returns (values quotient remainder)
(defun %ceiling-impl (number divisor)
  (multiple-value-bind (q r) (%truncate-impl number divisor)
    (if (and (not (zerop r))
             (if (< divisor 0) (< number 0) (> number 0)))
        (values (+ q 1) (- r divisor))
        (values q r))))

(defun ceiling (number &optional (divisor 1))
  (%ceiling-impl number divisor))

; round - round to nearest, returns (values quotient remainder)
(defun %round-impl (number divisor)
  (multiple-value-bind (q r) (%truncate-impl number divisor)
    (let* ((abs-r (abs r))
           (half (/ (abs divisor) 2))
           (rq (cond
                 ((< abs-r half) q)
                 ((> abs-r half) (if (< (* number divisor) 0) (- q 1) (+ q 1)))
                 ((evenp q) q)
                 (t (if (< (* number divisor) 0) (- q 1) (+ q 1))))))
      (values rq (- number (* rq divisor))))))

(defun round (number &optional (divisor 1))
  (%round-impl number divisor))

(defun ffloor (number &optional (divisor 1))
  (float (floor number divisor)))

(defun fceiling (number &optional (divisor 1))
  (float (ceiling number divisor)))

(defun ftruncate (number &optional (divisor 1))
  (float (truncate number divisor)))

(defun fround (number &optional (divisor 1))
  (float (round number divisor)))

; gcd - greatest common divisor
(defun gcd (&rest args)
  (labels ((gcd2 (a b)
             (let ((x (abs a))
                   (y (abs b)))
               (if (zerop y)
                   x
                   (gcd2 y (mod x y))))))
    (if (null args)
        0
        (reduce #'gcd2 args))))

; lcm - least common multiple
(defun lcm (&rest args)
  (if (null args)
      1
      (reduce (lambda (a b)
                (let ((x (abs a))
                      (y (abs b)))
                  (if (or (zerop x) (zerop y))
                      0
                      (quot (* x y) (gcd x y)))))
              args)))

; CL aliases for primitive names
(defun realpart (z)
  (real-part z))

(defun imagpart (z)
  (imag-part z))

; complex constructor used by #. reader tests
(defun complex (realpart &optional (imagpart 0))
  (if (zerop imagpart)
      realpart
      (make-complex realpart imagpart)))

; phase - angle of complex number (returns real)
(defun phase (z)
  (if (complexp z)
      (atan (imag-part z) (real-part z))
      (if (< z 0) pi 0)))

; cis - e^(i*theta) = cos(theta) + i*sin(theta)
(defun cis (theta)
  (make-complex (cos theta) (sin theta)))

(defun realpart (z)
  (real-part z))

(defun imagpart (z)
  (imag-part z))

(defun complex (realpart &optional (imagpart 0))
  (cond
    ((complexp realpart)
     (if (zerop imagpart)
         realpart
         (error "COMPLEX with complex realpart requires zero imagpart")))
    ((zerop imagpart) realpart)
    (t (make-complex realpart imagpart))))

(defun conjugate (z)
  (if (complexp z)
      (make-complex (realpart z) (- (imagpart z)))
      z))

; float - coerce a real to floating-point, honoring prototype shape (single impl here)
(defun float (number &optional prototype)
  (declare (ignore prototype))
  (cond
    ((floatp number) number)
    ((complexp number) (error "FLOAT expects a real number"))
    (t (+ number 0.0))))

; rational - convert number to exact rational
(defun rational (x) x)

; rationalize - convert float to approximate rational
(defun rationalize (x) x)

; upper-case-p - check if char is uppercase
(defun upper-case-p (c)
  (and (alpha-char-p c)
       (char= c (char-upcase c))))

; lower-case-p - check if char is lowercase
(defun lower-case-p (c)
  (and (alpha-char-p c)
       (char= c (char-downcase c))))

; both-case-p - check if char has case variants
(defun both-case-p (c)
  (and (alpha-char-p c)
       (char/= (char-upcase c) (char-downcase c))))

; alphanumericp - check if char is alphanumeric
(defun alphanumericp (c)
  (or (alpha-char-p c) (digit-char-p c)))

; graphic-char-p - check if char is graphic (printable)
(defun graphic-char-p (c)
  (let ((code (char-code c)))
    (and (>= code 32) (<= code 126))))

; standard-char-p - check if char is standard
(defun standard-char-p (c)
  (graphic-char-p c))

(defun char-int (c)
  (char-code c))

(defun digit-char-p (c &optional (radix 10))
  (let ((cc (char-code c)))
    (cond
      ((and (>= cc 48) (<= cc 57))  ; 0-9
       (let ((d (- cc 48)))
         (if (< d radix) d nil)))
      ((and (>= cc 65) (<= cc 90))  ; A-Z
       (let ((d (+ 10 (- cc 65))))
         (if (< d radix) d nil)))
      ((and (>= cc 97) (<= cc 122)) ; a-z
       (let ((d (+ 10 (- cc 97))))
         (if (< d radix) d nil)))
      (t nil))))

(defun digit-char (weight &optional (radix 10))
  (if (and (>= weight 0) (< weight radix) (< radix 37))
      (cond
        ((< weight 10) (code-char (+ weight 48)))
        (t (code-char (+ (- weight 10) 65))))
      nil))

(defun char-name (c)
  (case (char-code c)
    (32 "Space")
    (10 "Newline")
    (9 "Tab")
    (13 "Return")
    (0 "Null")
    (t nil)))

(defun name-char (name)
  (cond
    ((string-equal name "Space") #\Space)
    ((string-equal name "Newline") #\Newline)
    ((string-equal name "Tab") #\Tab)
    ((string-equal name "Return") #\Return)
    ((string-equal name "Null") (code-char 0))
    (t nil)))

;; ============================================================
;; Character Comparison Functions
;; ============================================================

; char<= - character less than or equal
(defun char<= (a b)
  (or (char< a b) (char= a b)))

; char>= - character greater than or equal
(defun char>= (a b)
  (or (char> a b) (char= a b)))

; char/= - character not equal
(defun char/= (a b)
  (not (char= a b)))

; char-equal - case-insensitive character equality
(defun char-equal (a b)
  (char= (char-upcase a) (char-upcase b)))

(defun char-not-equal (a b)
  (not (char-equal a b)))

; char-lessp - case-insensitive character less than
(defun char-lessp (a b)
  (char< (char-upcase a) (char-upcase b)))

; char-greaterp - case-insensitive character greater than
(defun char-greaterp (a b)
  (char> (char-upcase a) (char-upcase b)))

; char-not-greaterp - case-insensitive <=
(defun char-not-greaterp (a b)
  (or (char-lessp a b) (char-equal a b)))

; char-not-lessp - case-insensitive >=
(defun char-not-lessp (a b)
  (or (char-greaterp a b) (char-equal a b)))

;; ============================================================
;; String Case Functions
;; ============================================================

; string-equal - case-insensitive string equality
(defun string-equal (s1 s2)
  (string= (string-upcase s1) (string-upcase s2)))

; string-not-equal - case-insensitive string inequality
(defun string-not-equal (s1 s2)
  (not (string-equal s1 s2)))

; string-lessp - case-insensitive string <
(defun string-lessp (s1 s2)
  (string< (string-upcase s1) (string-upcase s2)))

; string-greaterp - case-insensitive string >
(defun string-greaterp (s1 s2)
  (string> (string-upcase s1) (string-upcase s2)))

; string-not-lessp - case-insensitive string >=
(defun string-not-lessp (s1 s2)
  (not (string-lessp s1 s2)))

; string-not-greaterp - case-insensitive string <=
(defun string-not-greaterp (s1 s2)
  (not (string-greaterp s1 s2)))

; string-capitalize - capitalize first letter of each word
(defun string-capitalize (s)
  (string-capitalize-aux s 0 (length s) t nil))

(defun string-capitalize-aux (s i len cap-next acc)
  (if (>= i len)
      (coerce (nreverse acc) 'string)
      (let ((c (char s i)))
        (if (alpha-char-p c)
            (string-capitalize-aux s (+ i 1) len nil
                                   (cons (if cap-next (char-upcase c) (char-downcase c)) acc))
            (string-capitalize-aux s (+ i 1) len t (cons c acc))))))

; nstring-upcase - destructive uppercase (same as string-upcase for now)
(defun nstring-upcase (s)
  (string-upcase s))

; nstring-downcase - destructive lowercase
(defun nstring-downcase (s)
  (string-downcase s))

; nstring-capitalize - destructive capitalize
(defun nstring-capitalize (s)
  (string-capitalize s))

; string-append - concatenate strings
(defun string-append (&rest strings)
  (if (null strings)
      ""
      (foldl (lambda (a b) (string-concat (string a) (string b)))
             (string (car strings))
             (cdr strings))))

;; ============================================================
;; Additional Sequence Functions
;; ============================================================

; elt - generic sequence element access
(defun elt (sequence index)
  (cond
    ((stringp sequence) (char sequence index))
    ((vectorp sequence) (svref sequence index))
    ((arrayp sequence) (aref sequence index))
    (t (nth index sequence))))

; (setf elt) is handled by setf expansion

(defun map-into (result-sequence function &rest sequences)
  (let ((len (length result-sequence))
        (is-list (listp result-sequence)))
    (labels ((set-result (idx val)
               (if is-list
                   (setf (nth idx result-sequence) val)
                   (setf (aref result-sequence idx) val))))
      (cond
        ((null sequences)
         (dotimes (j len result-sequence)
           (set-result j (funcall function))))
        ((null (cdr sequences))
         (let ((src (car sequences))
               (src-len (length (car sequences))))
           (dotimes (j (min len src-len) result-sequence)
             (set-result j (funcall function (elt src j))))))
        (t
         (let ((min-len len))
           (dolist (s sequences)
             (setq min-len (min min-len (length s))))
           (dotimes (j min-len result-sequence)
             (set-result j
                         (apply function (mapcar (lambda (s) (elt s j)) sequences))))))))))

; make-sequence - create sequence of given type
(defun make-sequence (type size &key initial-element)
  (cond
    ((eq type 'list)
     (make-list size :initial-element initial-element))
    ((eq type 'vector)
     (make-vector size initial-element))
    ((eq type 'string)
     (make-string size (or initial-element #\Space)))
    (t (error "Unknown sequence type"))))

; make-list - create list of given size
(defun make-list (size &key initial-element)
  (if (<= size 0)
      nil
      (cons initial-element (make-list (- size 1) :initial-element initial-element))))

; delete - destructive remove (for now, same as remove)
; delete - remove all occurrences of item from sequence
; Note: uses remove-if to support variable test functions
(defun delete (item sequence &key (test #'eql))
  (remove-if (lambda (x) (let ((r (funcall test x item))) r)) sequence))

; delete-if - destructive remove-if
(defun delete-if (pred sequence)
  (remove-if pred sequence))

; delete-if-not - destructive remove-if-not
(defun delete-if-not (pred sequence)
  (remove-if-not pred sequence))

; delete-duplicates - remove duplicate elements
; remove-duplicates-with-key - helper with key support
(defun %member-with-test (item seen cmp)
  (block nil
    (while t
      (when (null seen) (return-from nil nil))
      (when (funcall cmp item (car seen)) (return-from nil t))
      (setq seen (cdr seen)))))

(defun remove-duplicates-with-key (sequence test key)
  (let ((cmp (or test #'eql))
        (src (reverse sequence))
        (seen nil)
        (result nil))
    (block nil
      (while t
        (when (null src) (return-from nil result))
        (let* ((item (car src))
               (item-key (if key (funcall key item) item)))
          (unless (%member-with-test item-key seen cmp)
            (setq seen (cons item-key seen))
            (setq result (cons item result))))
        (setq src (cdr src))))))

; remove-duplicates - non-destructive duplicate removal
(defun remove-duplicates (sequence &key test key)
  (remove-duplicates-with-key sequence test key))

; delete-duplicates - destructive remove-duplicates (for now, same impl)
(defun delete-duplicates (sequence &key (test #'eql) key)
  (remove-duplicates sequence :test test :key key))

; nreverse - destructive reverse (for now, same as reverse)
(defun nreverse (sequence)
  (reverse sequence))

; nconc - destructive append (for now, use non-destructive approach)
; Helper to fold binary append over a list of lists
(defun nconc-2 (a b)
  "Destructively concatenate two lists."
  (if (null a) b
      (progn
        (let ((tail a))
          (while (cdr tail) (setq tail (cdr tail)))
          (rplacd tail b))
        a)))

(defun nconc-helper (lists)
  (if (null lists) nil
      (if (null (cdr lists)) (car lists)
          (nconc-2 (car lists) (nconc-helper (cdr lists))))))

(defun nconc (&rest lists)
  (nconc-helper lists))

; revappend - reverse first list and append second
(defun revappend (list tail)
  (append (reverse list) tail))

; nreconc - destructive revappend
(defun nreconc (list tail)
  (revappend list tail))

; tailp - check if sublist is a tail of list
(defun tailp (sublist list)
  (cond ((eq sublist list) t)
        ((null list) nil)
        (t (tailp sublist (cdr list)))))

; ldiff - return list elements before sublist
(defun ldiff (list sublist)
  (if (or (null list) (eq list sublist))
      nil
      (cons (car list) (ldiff (cdr list) sublist))))

; sublis - substitute multiple associations in tree
(defun sublis (alist tree)
  (let ((pair (assoc tree alist)))
    (if pair
        (cdr pair)
        (if (consp tree)
            (cons (sublis alist (car tree))
                  (sublis alist (cdr tree)))
            tree))))

; nsublis - destructive substitute multiple associations in tree
(defun nsublis (alist tree)
  (let ((pair (assoc tree alist)))
    (if pair
        (cdr pair)
        (if (consp tree)
            (progn
              (rplaca tree (nsublis alist (car tree)))
              (rplacd tree (nsublis alist (cdr tree)))
              tree)
            tree))))

;; ============================================================
;; Control Flow Utilities
;; ============================================================

; case - key-based dispatch (already exists as special form, but add as macro backup)
; Note: The compiler handles case specially

; when-let - bind and conditionally execute
; Usage: (when-let (var expr) body...)
(defmacro when-let (binding &rest body)
  (let ((var (car binding))
        (expr (cadr binding)))
    (list 'let (list (list var expr))
          (cons 'when (cons var body)))))

; if-let - bind and branch
; Usage: (if-let (var expr) then else)
(defmacro if-let (binding then &optional else)
  (let ((var (car binding))
        (expr (cadr binding)))
    (list 'let (list (list var expr))
          (list 'if var then else))))

; unless - execute unless condition is true
; (already a special form, adding for completeness)

; with-gensyms - create gensyms for hygiene
(defmacro with-gensyms (names &rest body)
  (list 'let
        (mapcar (lambda (n)
                  (list n (list 'gensym (symbol-name n))))
                names)
        (cons 'progn body)))

; once-only - evaluate expressions once
(defmacro once-only (names &rest body)
  (let ((gensyms (mapcar (lambda (n)
                           (declare (ignore n))
                           (gensym))
                         names)))
    (list 'let (mapcar #'list gensyms names)
          (cons 'progn body))))

;; ============================================================
;; Assertions and Debugging
;; ============================================================

; assert - check condition, signal error if false
(defmacro assert (test-form &optional places datum &rest arguments)
  (declare (ignore places))
  (if datum
      (list 'unless test-form
            (cons 'error (cons datum arguments)))
      (list 'unless test-form
            (list 'error "Assertion failed"))))

; check-type - verify type of place
(defmacro check-type (place typespec &optional string)
  (declare (ignore string))
  `(unless (typep ,place ',typespec)
     (error "Type check failed")))

; ecase - exhaustive case (already defined above)

; etypecase - exhaustive typecase (already defined above)

;; ============================================================
;; I/O Utilities
;; ============================================================

; fresh-line - output newline if not at beginning of line
(defun fresh-line (&optional stream)
  (declare (ignore stream))
  (terpri)
  t)

; write-string - write string to output
(defun write-string (string &optional stream)
  (if stream
      (%write-string stream string)
      (princ string))
  string)

; write-line - write string followed by newline
(defun write-line (string &optional stream)
  (if stream
      (%write-line stream string)
      (progn (princ string) (terpri)))
  string)

; read-line - read line from input
; read - optionally from a stream
(defun read (&optional stream (eof-error-p t) eof-value recursive-p)
  (declare (ignore recursive-p))
  (if stream
      ;; Read from stream: collect chars until we have a complete form
      (let ((chars nil)
            (done nil))
        (loop
          (let ((c (read-char stream nil nil)))
            (when (null c)
              (setq done t)
              (return))
            (push c chars)))
        (if chars
            (let ((str (coerce (nreverse chars) 'string)))
              (read-from-string str))
            (if eof-error-p
                (error "End of file on stream")
                eof-value)))
      ;; Read from stdin (use primitive)
      (%read)))

(defun read-line (&optional stream eof-error-p eof-value)
  (declare (ignore eof-error-p))
  (if stream
      (let ((result (%read-line stream)))
        (if result result eof-value))
      (let ((chars nil)
            (c (read-char)))
        (loop
          (when (or (null c) (char= c #\Newline))
            (return))
          (push c chars)
          (setq c (read-char nil nil nil)))
        (if chars
            (coerce (nreverse chars) 'string)
            ""))))

; read-from-string - keyword-aware wrapper around primitive one-arg reader
(defun read-from-string (string &optional (eof-error-p t) eof-value
                         &key (start 0) end preserve-whitespace (allow-other-keys nil))
  (declare (ignore preserve-whitespace allow-other-keys))
  (let* ((limit (or end (length string)))
         (slice (if (and (= start 0) (= limit (length string)))
                    string
                    (subseq string start limit))))
    (if (and (>= (length slice) 2)
             (char= (char slice 0) #\#)
             (char= (char slice 1) #\.))
        (if common-lisp::*read-suppress*
            (values eof-value start)
            (multiple-value-bind (form pos)
                (read-from-string (subseq slice 2))
              (values (eval form) (+ start 2 pos))))
        (if eof-error-p
            (multiple-value-bind (obj pos)
                (read-from-string slice)
              (values obj (+ start pos)))
            (handler-case
                (multiple-value-bind (obj pos)
                    (read-from-string slice)
                  (values obj (+ start pos)))
              (error () (values eof-value start)))))))

; write-to-string - keyword-aware wrapper around primitive one-arg writer
(defun write-to-string (object &key array base case circle escape gensym length level lines
                         miser-width pprint-dispatch pretty radix readably right-margin
                         stream (allow-other-keys nil))
  (declare (ignore array base case circle escape gensym length level lines
                   miser-width pprint-dispatch pretty radix readably right-margin stream
                   allow-other-keys))
  (write-to-string object))

; y-or-n-p - prompt for yes/no answer (single char)
(defun y-or-n-p (&optional format-string &rest args)
  (when format-string
    (apply #'format t format-string args)
    (princ " (y/n) "))
  (loop
    (let ((answer (read-line)))
      (when (or (string-equal answer "y") (string-equal answer "yes"))
        (return t))
      (when (or (string-equal answer "n") (string-equal answer "no"))
        (return nil))
      (princ "Please answer y or n: "))))

; yes-or-no-p - prompt for yes/no answer (full word)
(defun yes-or-no-p (&optional format-string &rest args)
  (when format-string
    (apply #'format t format-string args)
    (princ " (yes/no) "))
  (loop
    (let ((answer (read-line)))
      (when (string-equal answer "yes")
        (return t))
      (when (string-equal answer "no")
        (return nil))
      (princ "Please answer yes or no: "))))

; prin1-to-string - convert to string with escaping
; princ-to-string - convert to string without escaping
(defun princ-to-string (object)
  (if (stringp object)
      object
      (write-to-string object)))

; prin1-to-string - convert to string with escaping (readable)
(defun prin1-to-string (object)
  (let ((*print-escape* t))
    (write-to-string object)))

; parse-integer with keyword arguments
; The primitive parse-integer only handles simple cases.
; This wrapper adds :start, :end, :radix, :junk-allowed support.
(defun parse-integer (string &key (start 0) end (radix 10) junk-allowed)
  (declare (ignore junk-allowed))
  (let* ((end (or end (length string)))
         (i start)
         (result 0)
         (negative nil)
         (found-digit nil))
    ;; skip leading whitespace
    (do ()
        ((or (>= i end) (let ((cc (char-code (char string i))))
                           (not (or (= cc 32) (= cc 9) (= cc 10))))))
      (setq i (+ i 1)))
    ;; check sign
    (when (< i end)
      (let ((cc (char-code (char string i))))
        (cond
          ((= cc 45) (setq negative t) (setq i (+ i 1)))  ; #\-
          ((= cc 43) (setq i (+ i 1))))))                  ; #\+
    ;; parse digits
    (do ()
        ((>= i end))
      (let* ((cc (char-code (char string i)))
             (digit (cond
                      ((and (>= cc 48) (<= cc 57)) (- cc 48))      ; 0-9
                      ((and (>= cc 97) (<= cc 122)) (- cc 87))     ; a-z
                      ((and (>= cc 65) (<= cc 90)) (- cc 55))      ; A-Z
                      (t nil))))
        (if (and digit (< digit radix))
            (progn
              (setq result (+ (* result radix) digit))
              (setq found-digit t)
              (setq i (+ i 1)))
            (return nil))))
    (values (if found-digit (if negative (- result) result) nil) i)))

; stream-princ - write object to stream without escaping
(defun stream-princ (object stream)
  (write-to-stream (if (stringp object)
                       object
                       (write-to-string object))
                   stream)
  object)

; stream-print - write object to stream with newline
(defun stream-print (object stream)
  (stream-princ object stream)
  (write-to-stream (string #\Newline) stream)
  object)

; clear-input - clear any buffered input (returns nil)
(defun clear-input (&optional (stream *standard-input*))
  (%clear-input stream))

; finish-output - flush output and wait
(defun finish-output (&optional (stream *standard-output*))
  (%finish-output stream))

; force-output - flush output without waiting
(defun force-output (&optional (stream *standard-output*))
  (%force-output stream))

; clear-output - discard buffered output (returns nil)
(defun clear-output (&optional (stream *standard-output*))
  (%clear-output stream))

; with-output-to-string - capture output to string
; Usage:
;   (with-output-to-string (var) body...) -> fresh string result
;   (with-output-to-string (var existing-string) body...) -> append into existing-string
(defmacro with-output-to-string (spec &rest body)
  (let ((var (car spec))
        (dest (cadr spec))
        (tmp (gensym "WOS-TMP"))
        (i (gensym "WOS-I")))
    (if dest
        `(let ((,var (make-string-output-stream)))
           ,@body
           (let ((,tmp (get-output-stream-string ,var)))
             (if (vectorp ,dest)
                 (dotimes (,i (length ,tmp))
                   (vector-push-extend (char ,tmp ,i) ,dest))
                 (setq ,dest ,tmp))
             ,dest))
        `(let ((,var (make-string-output-stream)))
           ,@body
           (get-output-stream-string ,var)))))

;; ============================================================
;; Symbol Utilities
;; ============================================================

; symbol-plist - get symbol's property list
(defun symbol-plist (symbol)
  ;; Compiles to VM primitive opcode; keeps #', SYMBOL-FUNCTION, and FUNCALL paths aligned.
  (symbol-plist symbol))

; get, put, remprop - implemented as VM primitives (opcodes.zig)
; No stdlib wrapper needed - compiler generates direct opcode calls

; getl - return tail of plist at first matching indicator
; Accepts symbol plist source or (head . plist) cons source for compatibility
(defun getl (plist indicator-list)
  (cond
    ((symbolp plist)
     (setq plist (symbol-plist plist)))
    ((consp plist)
     (setq plist (cdr plist)))
    (t (return-from getl nil)))
  (do ((tail plist (cddr tail)))
      ((null tail) nil)
    (when (member (car tail) indicator-list :test #'eq)
      (return tail))))

; getf - get property from plist
(defun getf (plist indicator &optional default)
  (if (null plist)
      default
      (if (eq (car plist) indicator)
          (cadr plist)
          (getf (cddr plist) indicator default))))

; %plist-update! - internal: update value in plist if key exists
; Returns t if updated, nil if key not found
(defun %plist-update! (plist key value)
  (cond
    ((null plist) nil)
    ((eq (car plist) key)
     (rplacd plist (cons value (cddr plist)))
     t)
    (t (%plist-update! (cddr plist) key value))))

; putf - helper to set property in plist (returns new plist)
(defun putf (plist indicator value)
  (cons indicator (cons value plist)))

; adjust-array - resize array (creates new array, copies elements)
(defun adjust-array (array new-dimensions &rest args)
  (let ((init-elem (getf args :initial-element nil))
        (old-size (array-total-size array))
        (new-size (if (numberp new-dimensions) new-dimensions (car new-dimensions))))
    (let ((new-arr (make-array new-size :initial-element init-elem))
          (copy-len (min old-size new-size)))
      (dotimes (i copy-len)
        (setf (aref new-arr i) (aref array i)))
      new-arr)))

; string-upcase - with optional :start/:end
(defun string-upcase (str &rest args)
  (let* ((s (string str))
         (start (getf args :start 0))
         (end (getf args :end (length s))))
    (if (and (= start 0) (= end (length s)))
        (%string-upcase s)
        (concatenate 'string
                     (subseq s 0 start)
                     (%string-upcase (subseq s start end))
                     (subseq s end)))))

; string-downcase - with optional :start/:end
(defun string-downcase (str &rest args)
  (let* ((s (string str))
         (start (getf args :start 0))
         (end (getf args :end (length s))))
    (if (and (= start 0) (= end (length s)))
        (%string-downcase s)
        (concatenate 'string
                     (subseq s 0 start)
                     (%string-downcase (subseq s start end))
                     (subseq s end)))))

; remf-helper - helper for remf, removes property and returns new plist
(defun remf-helper (plist indicator)
  (cond
    ((null plist) nil)
    ((eq (car plist) indicator) (cddr plist))
    (t (cons (car plist)
             (cons (cadr plist)
                   (remf-helper (cddr plist) indicator))))))

; remf - destructively remove property from plist
(defmacro remf (place indicator)
  (list 'setf place (list 'remf-helper place indicator)))

; get-properties - search plist for any of the indicators
; Returns three values: indicator, value, tail
(defun get-properties (plist indicator-list)
  (cond
    ((null plist) (values nil nil nil))
    ((member (car plist) indicator-list)
     (values (car plist) (cadr plist) plist))
    (t (get-properties (cddr plist) indicator-list))))

; keywordp - check if symbol is keyword (already primitive)

; make-symbol - create uninterned symbol
(defun make-symbol (name)
  (%make-symbol name))

;; ============================================================
;; Mapping Variations
;; ============================================================

; mapcan - map and nconc results
(defun mapcan (fn list &rest more-lists)
  (apply #'nconc (apply #'mapcar fn list more-lists)))

; mapcon - maplist and nconc results
(defun mapcon (fn list &rest more-lists)
  (apply #'nconc (apply #'maplist fn list more-lists)))

; maplist - map over successive cdrs
(defun maplist (fn list &rest more-lists)
  (if (or (null list) (some #'null more-lists))
      nil
      (cons (apply fn list more-lists)
            (apply #'maplist fn (cdr list) (mapcar #'cdr more-lists)))))

; mapl - like maplist but for side effects
(defun mapl (fn list &rest more-lists)
  (let ((lists (cons list more-lists)))
    (while (notany #'null lists)
      (apply fn lists)
      (setq lists (mapcar #'cdr lists))))
  list)

;; ============================================================
;; Loop Extensions
;; ============================================================

; dotimes* - dotimes with explicit step
; Usage: (dotimes* (var count [result [step]]) body...)
(defmacro dotimes* (spec &rest body)
  (let ((var (car spec))
        (count (cadr spec))
        (result (caddr spec))
        (step (cadddr spec)))
    (let ((max (gensym "MAX"))
          (s (or step 1)))
      (list 'let (list (list max count))
            (list 'do (list (list var 0 (list '+ var s)))
                      (list (list '>= var max) result)
                  (cons 'progn body))))))

; doseq - iterate over any sequence
; Usage: (doseq (var sequence [result]) body...)
(defmacro doseq (spec &rest body)
  (let ((var (car spec))
        (sequence (cadr spec))
        (result (caddr spec)))
    (let ((seq (gensym "SEQ"))
          (i (gensym "I"))
          (len (gensym "LEN")))
      (list 'let* (list (list seq sequence)
                        (list len (list 'length seq)))
            (list 'if (list 'vectorp seq)
                  (list 'dotimes (list i len result)
                        (list 'let (list (list var (list 'svref seq i)))
                              (cons 'progn body)))
                  (list 'dolist (list var seq result)
                        (cons 'progn body)))))))

;; ============================================================
;; Predicates
;; ============================================================

; endp - check for end of proper list
(defun endp (x)
  (if (null x)
      t
      (if (consp x)
          nil
          (error "Not a list"))))

; functionp - check if callable
(defun functionp (x)
  (or (closurep x) (symbolp x)))

; compiled-function-p - check if compiled
(defun compiled-function-p (x)
  (closurep x))

; constantp - check if form is constant (self-evaluating)
(defun constantp (form)
  (cond
    ((null form) t)
    ((eq form t) t)
    ((numberp form) t)
    ((stringp form) t)
    ((characterp form) t)
    ((keywordp form) t)
    ((vectorp form) t)  ; vectors are self-evaluating
    ; (quote x) forms are constant
    ((and (consp form) (eq (car form) 'quote)) t)
    (t nil)))

; arrayp - check if array (vectors are arrays)
(defun arrayp (x)
  (let ((ty (type-of x)))
    (or (vectorp x)
        (eq ty 'array)
        (eq ty 'simple-array)
        (eq ty 'simple-vector)
        (eq ty 'string)
        (eq ty 'simple-string))))

; simple-vector-p - check if simple vector
(defun simple-vector-p (x)
  (vectorp x))

; simple-string-p - check if simple string
(defun simple-string-p (x)
  (stringp x))

; bit-vector-p - check if vector contains only 0 and 1
(defun bit-vector-p (x)
  "Return T if X is a bit vector (vector with all elements 0 or 1)."
  (and (vectorp x)
       (let ((len (length x))
             (i 0)
             (result t))
         (block nil
           (loop
             (when (>= i len) (return-from nil result))
             (let ((e (aref x i)))
               (unless (or (eql e 0) (eql e 1))
                 (setq result nil)
                 (return-from nil nil)))
             (setq i (+ i 1)))))))

; simple-bit-vector-p - same as bit-vector-p (all our vectors are simple)
(defun simple-bit-vector-p (x)
  "Return T if X is a simple bit vector."
  (bit-vector-p x))

; adjustable-array-p - no adjustable arrays yet (all static)
(defun adjustable-array-p (x)
  (declare (ignore x))
  nil)

; array-has-fill-pointer-p - check if array has fill pointer
(defun array-has-fill-pointer-p (x)
  (if (%fill-pointer x) t nil))

; packagep - no packages yet
(defun packagep (x)
  (declare (ignore x))
  nil)

; gentemp - generate temporary symbol (interned)
(defvar *gentemp-counter* 0)
(defun gentemp (&optional prefix package)
  (declare (ignore package))
  (setq *gentemp-counter* (+ *gentemp-counter* 1))
  (intern (concatenate 'string
                       (if prefix prefix "T")
                       (write-to-string *gentemp-counter*))))

; special-operator-p - check if symbol names a special operator
(defun special-operator-p (symbol)
  (if (member symbol '(block catch eval-when flet function go if labels
                       let let* load-time-value locally macrolet
                       multiple-value-call multiple-value-prog1 progn progv
                       quote return-from setq symbol-macrolet tagbody the
                       throw unwind-protect))
      t nil))

; pathnamep - check if object is a pathname
(defun pathnamep (x)
  (eq (type-of x) 'pathname))

; streamp - no stream objects yet
(defun streamp (x)
  (declare (ignore x))
  nil)

; readtablep - no readtable objects
(defun readtablep (x)
  (declare (ignore x))
  nil)

;;; ============================================================================
;;; CL LOOP Macro
;;; ============================================================================

; Canonicalize LOOP clause keywords across packages (e.g. CL-TEST::FOR -> :FOR)
(defun loop-kw-canon (x)
  (if (symbolp x)
      (let ((name (string-upcase (symbol-name x))))
        (cond
          ((string= name "FOR") :for)
          ((string= name "AS") :as)
          ((string= name "WITH") :with)
          ((string= name "REPEAT") :repeat)
          ((string= name "WHILE") :while)
          ((string= name "UNTIL") :until)
          ((string= name "DO") :do)
          ((string= name "DOING") :doing)
          ((string= name "COLLECT") :collect)
          ((string= name "COLLECTING") :collecting)
          ((string= name "APPEND") :append)
          ((string= name "APPENDING") :appending)
          ((string= name "NCONC") :nconc)
          ((string= name "NCONCING") :nconcing)
          ((string= name "SUM") :sum)
          ((string= name "SUMMING") :summing)
          ((string= name "COUNT") :count)
          ((string= name "COUNTING") :counting)
          ((string= name "MAXIMIZE") :maximize)
          ((string= name "MAXIMIZING") :maximizing)
          ((string= name "MINIMIZE") :minimize)
          ((string= name "MINIMIZING") :minimizing)
          ((string= name "INTO") :into)
          ((string= name "FINALLY") :finally)
          ((string= name "INITIALLY") :initially)
          ((string= name "RETURN") :return)
          ((string= name "FROM") :from)
          ((string= name "DOWNFROM") :downfrom)
          ((string= name "TO") :to)
          ((string= name "UPTO") :upto)
          ((string= name "BELOW") :below)
          ((string= name "DOWNTO") :downto)
          ((string= name "ABOVE") :above)
          ((string= name "BY") :by)
          ((string= name "IN") :in)
          ((string= name "ON") :on)
          ((string= name "ACROSS") :across)
          ((string= name "=") :=)
          ((string= name "THEN") :then)
          ((string= name "IF") :if)
          ((string= name "WHEN") :when)
          ((string= name "UNLESS") :unless)
          ((string= name "ELSE") :else)
          ((string= name "END") :end)
          ((string= name "AND") :and)
          ((string= name "NAMED") :named)
          ((string= name "ALWAYS") :always)
          ((string= name "NEVER") :never)
          ((string= name "THEREIS") :thereis)
          ((string= name "LOOP-FINISH") :loop-finish)
          ((string= name "BEING") :being)
          ((string= name "THE") :the)
          ((string= name "EACH") :each)
          ((string= name "OF") :of)
          ((string= name "USING") :using)
          ((string= name "HASH-KEYS") :hash-keys)
          ((string= name "HASH-KEY") :hash-key)
          ((string= name "HASH-VALUES") :hash-values)
          ((string= name "HASH-VALUE") :hash-value)
          ((string= name "SYMBOLS") :symbols)
          ((string= name "SYMBOL") :symbol)
          ((string= name "PRESENT-SYMBOLS") :present-symbols)
          ((string= name "PRESENT-SYMBOL") :present-symbol)
          ((string= name "EXTERNAL-SYMBOLS") :external-symbols)
          ((string= name "EXTERNAL-SYMBOL") :external-symbol)
          (t nil)))
      nil))

; Helper: Check if symbol is a loop keyword
(defun loop-keyword-p (x)
  (not (null (loop-kw-canon x))))

; c[ad]r accessors - all 28 compositions
(defun caaar (x) (car (caar x)))
(defun caadr (x) (car (cadr x)))
(defun cadar (x) (car (cdar x)))
(defun cdaar (x) (cdr (caar x)))
(defun cdadr (x) (cdr (cadr x)))
(defun cddar (x) (cdr (cdar x)))
(defun caaaar (x) (car (caaar x)))
(defun caaadr (x) (car (caadr x)))
(defun caadar (x) (car (cadar x)))
(defun caaddr (x) (car (caddr x)))
(defun cadaar (x) (car (cdaar x)))
(defun cadadr (x) (car (cdadr x)))
(defun caddar (x) (car (cddar x)))
(defun cadddr (x) (car (cdddr x)))
(defun cdaaar (x) (cdr (caaar x)))
(defun cdaadr (x) (cdr (caadr x)))
(defun cdadar (x) (cdr (cadar x)))
(defun cdaddr (x) (cdr (caddr x)))
(defun cddaar (x) (cdr (cdaar x)))
(defun cddadr (x) (cdr (cdadr x)))
(defun cdddar (x) (cdr (cddar x)))
(defun cddddr (x) (cdr (cdddr x)))

; Helper: Parse FOR clause - returns (var init step-form end-test remaining-clauses)
; Supports: FROM/TO/BELOW/ABOVE/DOWNFROM/DOWNTO/BY
(defun parse-loop-for-arithmetic (var clauses)
  (let ((from-val 0)
        (to-val nil)
        (by-val 1)
        (to-op nil)  ; '< '<= '> '>=
        (downp nil)
        (rest clauses))
    ; Parse modifiers using while loop
    (while (and rest (member (loop-kw-canon (car rest)) '(:from :downfrom :to :upto :below :downto :above :by)))
      (case (loop-kw-canon (car rest))
        ((:from)
         (setq from-val (cadr rest))
         (setq rest (cddr rest)))
        ((:downfrom)
         (setq from-val (cadr rest))
         (setq downp t)
         (setq rest (cddr rest)))
        ((:to)
         (setq to-val (cadr rest))
         (setq to-op (if downp '>= '<=))
         (setq rest (cddr rest)))
        ((:upto)
         (setq to-val (cadr rest))
         (setq to-op '<=)
         (setq rest (cddr rest)))
        ((:below)
         (setq to-val (cadr rest))
         (setq to-op '<)
         (setq rest (cddr rest)))
        ((:downto)
         (setq to-val (cadr rest))
         (setq to-op '>=)
         (setq downp t)
         (setq rest (cddr rest)))
        ((:above)
         (setq to-val (cadr rest))
         (setq to-op '>)
         (setq downp t)
         (setq rest (cddr rest)))
        ((:by)
         (setq by-val (cadr rest))
         (setq rest (cddr rest)))))
    ; Generate: (var init step-form end-test remaining-clauses)
    (let* ((step-expr (if downp
                          (list '- var by-val)
                          (list '+ var by-val)))
           (end-test (if to-val
                         (list 'not (list to-op var to-val))
                         nil)))
      (list var from-val step-expr end-test rest))))

; Helper: detect boundaries when parsing IF/WHEN/UNLESS DO actions
; Conditional DO bodies stop when the next LOOP clause keyword starts.
(defun loop-conditional-boundary-p (x)
  (loop-keyword-p x))

; Helper: parse DO/DOING action in IF/WHEN/UNLESS into (:do form...)
(defun loop-parse-do-action (rest)
  (let ((do-sym (car rest))
        (forms nil)
        (remaining (cdr rest)))
    (while (and remaining (not (loop-conditional-boundary-p (car remaining))))
      (push (car remaining) forms)
      (setq remaining (cdr remaining)))
    (when (null forms)
      (error "DO requires at least one form"))
    (list (cons do-sym (nreverse forms)) remaining)))

; Helper: rewrite LOOP-FINISH forms once block-name is known
(defun loop-rewrite-control-form (form block-name result-expr)
  (if (and (consp form)
           (eq (loop-kw-canon (car form)) :loop-finish)
           (null (cdr form)))
      (list 'return-from block-name result-expr)
    form))

; Helper: convert action (:do f1 f2 ...) into one executable form
(defun loop-do-action-form (action block-name result-expr)
  (let ((forms (mapcar (lambda (form)
                         (loop-rewrite-control-form form block-name result-expr))
                       (cdr action))))
    (if (null (cdr forms))
        (car forms)
      (cons 'progn forms))))

; Generate loop code from parsed components
(defun loop-generate-code (vars step-forms end-tests body-forms
                           collect-var collect-forms named-collects
                           sum-var sum-forms
                           count-var count-forms
                           append-var append-forms
                           nconc-var nconc-forms
                           max-var max-forms
                           min-var min-forms
                           always-forms never-forms thereis-forms
                           block-name
                           finally-forms initially-forms)
  (let* ((all-vars (nreverse vars))
         (has-collect (not (null collect-forms)))
         (has-sum (not (null sum-forms)))
         (has-count (not (null count-forms)))
         (has-append (not (null append-forms)))
         (has-nconc (not (null nconc-forms)))
         (has-max (not (null max-forms)))
         (has-min (not (null min-forms)))
         (has-always (not (null always-forms)))
         (has-never (not (null never-forms)))
         (has-thereis (not (null thereis-forms)))
         (loop-body nil)
         (result-expr nil))

    ; Add accumulator variables
    (when has-collect
      (push (list collect-var nil) all-vars))
    ;; Add named collect variables
    (dolist (nc named-collects)
      (push (list (car nc) nil) all-vars))
    (when has-sum
      (push (list sum-var 0) all-vars))
    (when has-count
      (push (list count-var 0) all-vars))
    (when has-append
      (push (list append-var nil) all-vars))
    (when has-nconc
      (push (list nconc-var nil) all-vars))
    (when has-max
      (push (list max-var nil) all-vars))
    (when has-min
      (push (list min-var nil) all-vars))

    ; Build end test
    (let ((end-test (if (null end-tests)
                        nil
                      (if (= (length end-tests) 1)
                          (car end-tests)
                        (cons 'or (nreverse end-tests))))))

      ; Determine result expression first (needed for end-test)
      ; Priority: always/never/thereis > collect > append > nconc > sum > count > max > min
      (setq result-expr
            (cond
              (has-always t)  ; always returns T on success
              (has-never t)   ; never returns T on success
              (has-thereis nil) ; thereis returns value found, or nil
              (has-collect collect-var)
              (has-append append-var)
              (has-nconc nconc-var)
              (has-sum sum-var)
              (has-count count-var)
              (has-max max-var)
              (has-min min-var)
              (t nil)))

      ; Build loop body using nested binary appends
      (let ((end-test-forms (when end-test
                              (list (list 'when end-test (list 'return-from block-name result-expr)))))
            (main-body (mapcar (lambda (form)
                                 (loop-rewrite-control-form form block-name result-expr))
                               body-forms))
            (collect-body (append
                           ;; Default collect forms
                           (mapcar (lambda (expr)
                                     (if (and (consp expr) (member (car expr) '(when unless)))
                                         (list (car expr) (cadr expr)
                                               (list 'setq collect-var
                                                     (list 'nconc collect-var (list 'list (caddr expr)))))
                                         (list 'setq collect-var
                                               (list 'nconc collect-var (list 'list expr)))))
                                   (nreverse collect-forms))
                           ;; Named collect forms
                           (let ((nc-body nil))
                             (dolist (nc named-collects)
                               (let ((var (car nc))
                                     (forms (cdr nc)))
                                 (dolist (expr (nreverse forms))
                                   (push (if (and (consp expr) (member (car expr) '(when unless)))
                                             (list (car expr) (cadr expr)
                                                   (list 'setq var
                                                         (list 'nconc var (list 'list (caddr expr)))))
                                             (list 'setq var
                                                   (list 'nconc var (list 'list expr))))
                                         nc-body))))
                             (nreverse nc-body))))
            (sum-body (mapcar (lambda (expr)
                                (if (and (consp expr) (member (car expr) '(when unless)))
                                    (list (car expr) (cadr expr)
                                          (list 'setq sum-var (list '+ sum-var (caddr expr))))
                                    (list 'setq sum-var (list '+ sum-var expr))))
                              (nreverse sum-forms)))
            (count-body (mapcar (lambda (expr)
                                  (list 'when expr
                                        (list 'setq count-var (list '+ count-var 1))))
                                (nreverse count-forms)))
            ; Append accumulates copies of lists
            (append-body (mapcar (lambda (expr)
                                   (if (and (consp expr) (member (car expr) '(when unless)))
                                       (list (car expr) (cadr expr)
                                             (list 'setq append-var
                                                   (list 'append append-var (caddr expr))))
                                       (list 'setq append-var
                                             (list 'append append-var expr))))
                                 (nreverse append-forms)))
            ; Nconc destructively concatenates
            (nconc-body (mapcar (lambda (expr)
                                  (if (and (consp expr) (member (car expr) '(when unless)))
                                      (list (car expr) (cadr expr)
                                            (list 'setq nconc-var
                                                  (list 'nconc nconc-var (caddr expr))))
                                      (list 'setq nconc-var
                                            (list 'nconc nconc-var expr))))
                                (nreverse nconc-forms)))
            ; Maximize tracks maximum value
            (max-body (mapcar (lambda (expr)
                                (let ((val-var (gensym "val")))
                                  (if (and (consp expr) (member (car expr) '(when unless)))
                                      ; Conditional: wrap the let in the conditional
                                      (list (car expr) (cadr expr)
                                            (list 'let (list (list val-var (caddr expr)))
                                                  (list 'when (list 'or (list 'null max-var)
                                                                   (list '> val-var max-var))
                                                        (list 'setq max-var val-var))))
                                      ; Normal form
                                      (list 'let (list (list val-var expr))
                                            (list 'when (list 'or (list 'null max-var)
                                                               (list '> val-var max-var))
                                                  (list 'setq max-var val-var))))))
                              (nreverse max-forms)))
            ; Minimize tracks minimum value
            (min-body (mapcar (lambda (expr)
                                (let ((val-var (gensym "val")))
                                  (if (and (consp expr) (member (car expr) '(when unless)))
                                      ; Conditional: wrap the let in the conditional
                                      (list (car expr) (cadr expr)
                                            (list 'let (list (list val-var (caddr expr)))
                                                  (list 'when (list 'or (list 'null min-var)
                                                                   (list '< val-var min-var))
                                                        (list 'setq min-var val-var))))
                                      ; Normal form
                                      (list 'let (list (list val-var expr))
                                            (list 'when (list 'or (list 'null min-var)
                                                               (list '< val-var min-var))
                                                  (list 'setq min-var val-var))))))
                              (nreverse min-forms)))
            ; Always returns NIL immediately if test fails
            (always-body (mapcar (lambda (expr)
                                   (list 'unless expr
                                         (list 'return-from block-name nil)))
                                 (nreverse always-forms)))
            ; Never returns NIL immediately if test succeeds
            (never-body (mapcar (lambda (expr)
                                  (list 'when expr
                                        (list 'return-from block-name nil)))
                                (nreverse never-forms)))
            ; Thereis returns value immediately if non-NIL
            (thereis-body (mapcar (lambda (expr)
                                    (let ((val-var (gensym "val")))
                                      (list 'let (list (list val-var expr))
                                            (list 'when val-var
                                                  (list 'return-from block-name val-var)))))
                                  (nreverse thereis-forms)))
            (step-body (loop-group-parallel-steps (nreverse step-forms))))
        (setq loop-body
              (append end-test-forms
                      (append main-body
                              (append collect-body
                                      (append append-body
                                              (append nconc-body
                                                      (append sum-body
                                                              (append count-body
                                                                      (append max-body
                                                                              (append min-body
                                                                                      (append always-body
                                                                                              (append never-body
                                                                                                      (append thereis-body step-body))))))))))))))

      ; Build final code using (while t ...) instead of (loop ...) to avoid a bug
      (let ((loop-code (list* 'while t loop-body)))
        ; Wrap with initially if present
        (when initially-forms
          (setq loop-code (cons 'progn (append initially-forms (list loop-code)))))

        ; Build the block with let* bindings (sequential for dependent vars)
        (list 'block block-name
              (list 'let* all-vars
                    (if finally-forms
                        (list 'unwind-protect
                              loop-code
                              (cons 'progn (append finally-forms
                                                   (list (list 'return-from block-name result-expr)))))
                      (list 'progn loop-code (list 'return-from block-name result-expr)))))))))


; loop-finish - exit loop normally, running finally clause
; LOOP parser rewrites this call in extended LOOP forms.
(defun loop-finish ()
  "Exit the innermost enclosing LOOP, executing its finally clause."
  (error "LOOP-FINISH used outside LOOP"))

; Expand loop clauses into code
;; Convert step-forms with :and markers into parallel psetq groups.
;; Input: ((setq a ea) :and (setq b eb) (setq c ec))
;; Output: ((psetq a ea b eb) (setq c ec))
;; The :and marker between two setqs means they should be parallel.
(defun loop-group-parallel-steps (forms)
  (let ((result nil)
        (current-group nil))
    (dolist (f forms)
      (cond
        ((eq f :and)
         ;; Next step form should be in same parallel group
         ;; If current-group is empty, take the last result item
         (when (and (null current-group) result)
           (setq current-group (list (pop result)))))
        (t
         (if current-group
             ;; Add to parallel group
             (push f current-group)
             ;; Start fresh
             (push f result)))))
    ;; Flush remaining parallel group
    (when current-group
      (let ((group (nreverse current-group)))
        (if (= (length group) 1)
            (push (car group) result)
            ;; Convert ((setq a ea) (setq b eb)) → (psetq a ea b eb)
            (let ((psetq-args nil))
              (dolist (sf group)
                (when (and (consp sf) (eq (car sf) 'setq))
                  (push (cadr sf) psetq-args)
                  (push (caddr sf) psetq-args)))
              (push (cons 'psetq (nreverse psetq-args)) result)))))
    (nreverse result)))

(defun loop-expand (clauses)
  (let ((vars nil)           ; ((var init) ...)
        (step-forms nil)     ; (setq var step-expr) ...
        (end-tests nil)      ; test expressions for termination
        (body-forms nil)     ; do/doing body
        (collect-var nil)    ; variable for default collect
        (collect-forms nil)  ; collected expressions for default
        (named-collects nil) ; alist of (var . (cond-forms)) for collect INTO
        (sum-var nil)        ; variable for sum
        (sum-forms nil)      ; summed expressions
        (count-var nil)      ; variable for count
        (count-forms nil)    ; counted expressions
        (append-var nil)     ; variable for append
        (append-forms nil)   ; appended expressions
        (nconc-var nil)      ; variable for nconc
        (nconc-forms nil)    ; nconced expressions
        (max-var nil)        ; variable for maximize
        (max-forms nil)      ; maximized expressions
        (min-var nil)        ; variable for minimize
        (min-forms nil)      ; minimized expressions
        (always-forms nil)   ; always test expressions
        (never-forms nil)    ; never test expressions
        (thereis-forms nil)  ; thereis test expressions
        (block-name nil)     ; named loop block name
        (finally-forms nil)  ; finally body
        (initially-forms nil) ; initially body
        (and-context nil)     ; tracks FOR/WITH chains split by AND
        (current-step-group nil)  ; step-forms for current AND chain
        (rest clauses))

    ; Parse all clauses using while loop
    (while rest
      (let* ((kw (car rest))
             (kw-key (loop-kw-canon kw)))
        (when (and (not (eq kw-key :and))
                   (not (member kw-key '(:for :as :with))))
          (setq and-context nil))
        (case kw-key
          ; FOR/AS with various iteration types
          ((:for :as)
           (setq and-context :for)
           (let* ((var (cadr rest))
                  (next-kw (loop-kw-canon (caddr rest))))
             (case next-kw
               ; FOR var FROM/DOWNFROM ... TO/BELOW/ABOVE ...
               ((:from :downfrom :to :upto :below :downto :above)
                (let ((parsed (parse-loop-for-arithmetic var (cddr rest))))
                  (push (list (car parsed) (cadr parsed)) vars)
                  (push (list 'setq (car parsed) (caddr parsed)) step-forms)
                  (when (cadddr parsed)
                    (push (cadddr parsed) end-tests))
                  (setq rest (car (cddddr parsed)))))

               ; FOR var IN list [BY step-fn]
               ((:in)
                (let ((list-var (gensym "list"))
                      (list-expr (cadddr rest))
                      (in-rest (cddddr rest))
                      (step-fn 'cdr))
                  (when (and (consp in-rest) (eq (loop-kw-canon (car in-rest)) :by))
                    (setq step-fn (cadr in-rest))
                    (setq in-rest (cddr in-rest)))
                  (push (list list-var list-expr) vars)
                  ; Check if var is a list (destructuring) or a symbol
                  (if (consp var)
                      ; Destructuring case: (for (a b) in list ...)
                      (progn
                        (let* ((tmp-var (gensym "tmp"))
                               (bindings (destructuring-bind-impl var tmp-var))
                               (assign-forms (loop-binding-setq-forms bindings)))
                          (push (list tmp-var nil) vars)
                          (setq vars (loop-ensure-vars-from-bindings bindings vars))
                          (setq body-forms
                                (append (list (list 'setq tmp-var (list 'car list-var)))
                                        assign-forms
                                        body-forms)))
                        (push (list 'setq list-var (list step-fn list-var)) step-forms)
                        (push (list 'null list-var) end-tests)
                        (setq rest in-rest))
                    ; Simple case: for x in list
                    (progn
                      ; Keep VAR in sync via init + step so dependent FOR clauses
                      ; see the current element in the same iteration.
                      (push (list var (list 'car list-var)) vars)
                      (push (list 'setq list-var (list step-fn list-var)) step-forms)
                      (push (list 'setq var (list 'car list-var)) step-forms)
                      (push (list 'null list-var) end-tests)
                      (setq rest in-rest)))))

               ; FOR var ON list [BY step-fn]
               ((:on)
                (let ((list-expr (cadddr rest))
                      (by-rest (cddddr rest))
                      (step-fn 'cdr))
                  (when (and (consp by-rest) (eq (loop-kw-canon (car by-rest)) :by))
                    (setq step-fn (cadr by-rest))
                    (setq by-rest (cddr by-rest)))
                  (if (consp var)
                      (let* ((list-var (gensym "list"))
                             (tmp-var (gensym "tmp"))
                             (bindings (destructuring-bind-impl var tmp-var))
                             (assign-forms (loop-binding-setq-forms bindings)))
                        (push (list list-var list-expr) vars)
                        (push (list tmp-var nil) vars)
                        (setq vars (loop-ensure-vars-from-bindings bindings vars))
                        (setq body-forms
                              (append (list (list 'setq tmp-var list-var))
                                      assign-forms
                                      body-forms))
                        (push (list 'setq list-var (list step-fn list-var)) step-forms)
                        (push (list 'null list-var) end-tests)
                        (setq rest by-rest))
                    (progn
                      (push (list var list-expr) vars)
                      (push (list 'setq var (list step-fn var)) step-forms)
                      (push (list 'null var) end-tests)
                      (setq rest by-rest)))))

               ; FOR var = expr [THEN step-expr]
               ((:=)
                (let ((init-expr (cadddr rest))
                      (then-rest (cddddr rest)))
                  (if (consp var)
                      (let* ((tmp-var (gensym "tmp"))
                             (bindings (destructuring-bind-impl var tmp-var))
                             (assign-forms (loop-binding-setq-forms bindings))
                             (step-expr (if (and (consp then-rest)
                                                 (eq (loop-kw-canon (car then-rest)) :then))
                                            (cadr then-rest)
                                            init-expr)))
                        (push (list tmp-var init-expr) vars)
                        (setq vars (loop-ensure-vars-from-bindings bindings vars))
                        (setq body-forms (append assign-forms body-forms))
                        (push (list 'setq tmp-var step-expr) step-forms)
                        (setq rest (if (and (consp then-rest)
                                            (eq (loop-kw-canon (car then-rest)) :then))
                                       (cddr then-rest)
                                       then-rest)))
                    (if (and (consp then-rest) (eq (loop-kw-canon (car then-rest)) :then))
                        (progn
                          (push (list var init-expr) vars)
                          (push (list 'setq var (cadr then-rest)) step-forms)
                          (setq rest (cddr then-rest)))
                      (progn
                        (push (list var init-expr) vars)
                        (push (list 'setq var init-expr) step-forms)
                        (setq rest then-rest))))))

               ; FOR var ACROSS vector
               ((:across)
                (let ((vec-var (gensym "vec"))
                      (idx-var (gensym "idx"))
                      (len-var (gensym "len")))
                  (push (list vec-var (cadddr rest)) vars)
                  (push (list len-var (list 'length vec-var)) vars)
                  (push (list idx-var 0) vars)
                  ; Check if var is a list (destructuring) or a symbol
                  (if (consp var)
                      ; Destructuring case: (for (a b) across vec ...)
                      (let* ((tmp-var (gensym "tmp"))
                             (bindings (destructuring-bind-impl var tmp-var))
                             (assign-forms (loop-binding-setq-forms bindings)))
                        (push (list tmp-var nil) vars)
                        (setq vars (loop-ensure-vars-from-bindings bindings vars))
                        (setq body-forms
                              (append (list (list 'setq tmp-var (list 'aref vec-var idx-var)))
                                      assign-forms
                                      body-forms)))
                    ; Simple case: for x across vec
                    (progn
                      (push (list var nil) vars)
                      (push (list 'setq var (list 'aref vec-var idx-var)) body-forms)))
                  (push (list 'setq idx-var (list '+ idx-var 1)) step-forms)
                  (push (list '>= idx-var len-var) end-tests)
                  (setq rest (cddddr rest))))

               ; FOR var BEING THE/EACH HASH-KEYS/HASH-VALUES/SYMBOLS OF hash/package [USING (...)]
               ((:being)
                (let ((the-rest (cdddr rest)))
                  ; Skip 'the' or 'each' if present
                  (when (member (loop-kw-canon (car the-rest)) '(:the :each))
                    (setq the-rest (cdr the-rest)))
                  (let ((iter-type (car the-rest))
                        (of-rest (cdr the-rest)))
                    ; Skip 'of' or 'in'
                    (when (member (loop-kw-canon (car of-rest)) '(:of :in))
                      (setq of-rest (cdr of-rest)))
                    (let ((target-expr (car of-rest))
                          (using-rest (cdr of-rest))
                          (other-var nil))
                      ; Check for USING clause
                      (when (and (consp using-rest) (eq (loop-kw-canon (car using-rest)) :using))
                        (let ((using-spec (cadr using-rest)))
                          (when (consp using-spec)
                            (setq other-var (cadr using-spec)))
                          (setq using-rest (cddr using-rest))))
                      ; Generate iteration code
                      (case (loop-kw-canon iter-type)
                        ((:hash-keys :hash-key)
                         (let ((keys-var (gensym "keys"))
                               (hash-var (gensym "hash")))
                           (push (list hash-var target-expr) vars)
                           (push (list keys-var (list 'hash-table-keys hash-var)) vars)
                           ; Check if var is a list (destructuring) or symbol
                           (if (consp var)
                               ; Destructuring: (for (key . val) being hash-keys ...)
                               (let* ((tmp-var (gensym "tmp"))
                                      (val-var (gensym "val"))
                                      (bindings (destructuring-bind-impl var val-var))
                                      (assign-forms (loop-binding-setq-forms bindings))
                                      (init-forms (list (list 'setq tmp-var (list 'car keys-var)))))
                                 (push (list tmp-var nil) vars)
                                 (when other-var
                                   (push (list other-var nil) vars))
                                 (push (list val-var nil) vars)
                                 (setq vars (loop-ensure-vars-from-bindings bindings vars))
                                 (when other-var
                                   (setq init-forms (append init-forms
                                                            (list (list 'setq other-var (list 'gethash tmp-var hash-var))
                                                                  (list 'setq val-var (list 'cons tmp-var other-var))))))
                                 (unless other-var
                                   (setq init-forms (append init-forms
                                                            (list (list 'setq val-var tmp-var)))))
                                 (setq body-forms (append init-forms assign-forms body-forms)))
                             ; Simple: var is symbol
                             (progn
                               (push (list var nil) vars)
                               (when other-var
                                 (push (list other-var nil) vars))
                               (push (list 'setq var (list 'car keys-var)) body-forms)
                               (when other-var
                                 (push (list 'setq other-var (list 'gethash var hash-var)) body-forms))))
                           (push (list 'setq keys-var (list 'cdr keys-var)) step-forms)
                           (push (list 'null keys-var) end-tests)))
                        ((:hash-values :hash-value)
                         (let ((keys-var (gensym "keys"))
                               (hash-var (gensym "hash"))
                               (key-var (or other-var (gensym "key"))))
                           (push (list hash-var target-expr) vars)
                           (push (list keys-var (list 'hash-table-keys hash-var)) vars)
                           (push (list key-var nil) vars)
                           ; Check if var is a list (destructuring) or symbol
                           (if (consp var)
                               ; Destructuring: (for (a . b) being hash-values ...)
                               (let* ((tmp-var (gensym "tmp"))
                                      (bindings (destructuring-bind-impl var tmp-var))
                                      (assign-forms (loop-binding-setq-forms bindings))
                                      (init-forms (list (list 'setq key-var (list 'car keys-var))
                                                        (list 'setq tmp-var (list 'gethash key-var hash-var)))))
                                 (push (list tmp-var nil) vars)
                                 (setq vars (loop-ensure-vars-from-bindings bindings vars))
                                 (setq body-forms (append init-forms assign-forms body-forms)))
                             ; Simple: var is symbol
                             (progn
                               (push (list var nil) vars)
                               (push (list 'setq key-var (list 'car keys-var)) body-forms)
                               (push (list 'setq var (list 'gethash key-var hash-var)) body-forms)))
                           (push (list 'setq keys-var (list 'cdr keys-var)) step-forms)
                           (push (list 'null keys-var) end-tests)))
                        ((:symbols :symbol)
                         (let ((syms-var (gensym "syms"))
                               (pkg-var (gensym "pkg")))
                           (push (list pkg-var target-expr) vars)
                           (push (list syms-var (list '%package-symbols-list pkg-var)) vars)
                           (push (list var nil) vars)
                           (push (list 'setq var (list 'car syms-var)) body-forms)
                           (push (list 'setq syms-var (list 'cdr syms-var)) step-forms)
                           (push (list 'null syms-var) end-tests)))
                        ((:present-symbols :present-symbol)
                         (let ((syms-var (gensym "syms"))
                               (pkg-var (gensym "pkg")))
                           (push (list pkg-var target-expr) vars)
                           (push (list syms-var (list '%package-symbols-list pkg-var)) vars)
                           (push (list var nil) vars)
                           (push (list 'setq var (list 'car syms-var)) body-forms)
                           (push (list 'setq syms-var (list 'cdr syms-var)) step-forms)
                           (push (list 'null syms-var) end-tests)))
                        ((:external-symbols :external-symbol)
                         (let ((syms-var (gensym "syms"))
                               (pkg-var (gensym "pkg")))
                           (push (list pkg-var target-expr) vars)
                           (push (list syms-var (list '%package-exports-list pkg-var)) vars)
                           (push (list var nil) vars)
                           (push (list 'setq var (list 'car syms-var)) body-forms)
                           (push (list 'setq syms-var (list 'cdr syms-var)) step-forms)
                           (push (list 'null syms-var) end-tests)))
                        (t (error (format nil "Unknown iteration type: ~a" iter-type))))
                      (setq rest using-rest)))))

               (t (error "Unknown FOR clause")))))

          ; WITH var = expr
          ((:with)
           (setq and-context :with)
           (let ((var (cadr rest)))
             (if (and (cdddr rest) (eq (loop-kw-canon (caddr rest)) :=))
                 (progn
                   (push (list var (cadddr rest)) vars)
                   (setq rest (cddddr rest)))
               (progn
                 (push (list var nil) vars)
                 (setq rest (cddr rest))))))

          ; AND separator for parallel FOR/WITH clauses
          ((:and)
           (push :and step-forms)  ; marker for parallel grouping
           (let ((next-kw (loop-kw-canon (cadr rest))))
             (cond
               ((member next-kw '(:for :as :with))
                ; Explicit keyword after AND: drop separator only.
                (setq rest (cdr rest)))
               ((eq and-context :for)
                ; Implicit FOR continuation: (for a in x and b from 0)
                (setq rest (cons 'for (cdr rest))))
               ((eq and-context :with)
                ; Implicit WITH continuation: (with a = 1 and b = 2)
                (setq rest (cons 'with (cdr rest))))
               (t
                (error "AND must continue FOR/AS/WITH clause")))))

          ; REPEAT n
          ((:repeat)
           (let ((cnt-var (gensym "count")))
             (push (list cnt-var (cadr rest)) vars)
             (push (list 'setq cnt-var (list '- cnt-var 1)) step-forms)
             (push (list '<= cnt-var 0) end-tests)
             (setq rest (cddr rest))))

          ; WHILE test
          ((:while)
           (push (list 'not (cadr rest)) end-tests)
           (setq rest (cddr rest)))

          ; UNTIL test
          ((:until)
           (push (cadr rest) end-tests)
           (setq rest (cddr rest)))

          ; DO/DOING body...
          ((:do :doing)
           (let ((forms nil))
             (setq rest (cdr rest))
             (while (and rest (not (loop-keyword-p (car rest))))
               (push (car rest) forms)
               (setq rest (cdr rest)))
             (setq body-forms (append body-forms (nreverse forms)))))

          ; IF/WHEN test clause [ELSE clause] [END]
          ((:if :when)
           (let ((test (cadr rest))
                 (then-rest (cddr rest))
                 (then-action nil)
                 (else-action nil))
             ; Parse THEN clause (including optional INTO for collect/sum/etc)
             (case (loop-kw-canon (car then-rest))
               ((:do)
                (let ((parsed (loop-parse-do-action then-rest)))
                  (setq then-action (car parsed))
                  (setq then-rest (cadr parsed))))
               ((:collect :collecting :sum :summing :count :counting
                 :append :appending :nconc :nconcing :maximize :maximizing
                 :minimize :minimizing :return)
                (setq then-action (list (car then-rest) (cadr then-rest)))
                (setq then-rest (cddr then-rest))
                ;; Check for INTO after collect/sum/count/append/nconc
                (when (and (consp then-rest) (eq (loop-kw-canon (car then-rest)) :into))
                  (setq then-action (append then-action (list (car then-rest) (cadr then-rest))))
                  (setq then-rest (cddr then-rest))))
               (t (error "IF requires DO/COLLECT/SUM/COUNT/etc")))
             ; Check for ELSE
             (when (and (consp then-rest) (eq (loop-kw-canon (car then-rest)) :else))
               (setq then-rest (cdr then-rest))
               ; Parse ELSE clause - may be WHEN or direct action
               (case (loop-kw-canon (car then-rest))
                 ((:do)
                  (let ((parsed (loop-parse-do-action then-rest)))
                    (setq else-action (car parsed))
                    (setq then-rest (cadr parsed))))
                 ((:collect :collecting :sum :summing :count :counting
                   :append :appending :nconc :nconcing :maximize :maximizing
                   :minimize :minimizing :return)
                  (setq else-action (list (car then-rest) (cadr then-rest)))
                  (setq then-rest (cddr then-rest))
                  (when (and (consp then-rest) (eq (loop-kw-canon (car then-rest)) :into))
                    (setq else-action (append else-action (list (car then-rest) (cadr then-rest))))
                    (setq then-rest (cddr then-rest))))
                 ((:when)
                  ;; ELSE WHEN sub-test clause [ELSE ...]
                  (let ((sub-test (cadr then-rest))
                        (sub-rest (cddr then-rest)))
                    (case (loop-kw-canon (car sub-rest))
                      ((:do)
                       (let ((parsed (loop-parse-do-action sub-rest)))
                         (setq else-action (car parsed))
                         (setq sub-rest (cadr parsed)))
                       (setq else-action (list :when-else sub-test else-action))
                       (setq then-rest sub-rest)
                       (when (and (consp then-rest) (eq (loop-kw-canon (car then-rest)) :else))
                         (setq then-rest (cdr then-rest))
                         (case (loop-kw-canon (car then-rest))
                           ((:do)
                            (let ((parsed2 (loop-parse-do-action then-rest)))
                              (setq else-action (list :when-else-else sub-test (caddr else-action) (car parsed2)))
                              (setq then-rest (cadr parsed2))))
                           ((:collect :collecting :sum :summing :count :counting
                             :append :appending :nconc :nconcing :maximize :maximizing
                             :minimize :minimizing :return)
                            (let ((else2 (list (car then-rest) (cadr then-rest)))
                                  (after-else2 (cddr then-rest)))
                              (when (and (consp after-else2) (eq (loop-kw-canon (car after-else2)) :into))
                                (setq else2 (append else2 (list (car after-else2) (cadr after-else2))))
                                (setq after-else2 (cddr after-else2)))
                              (setq else-action (list :when-else-else sub-test (caddr else-action) else2))
                              (setq then-rest after-else2))))))
                      ((:collect :collecting :sum :summing :count :counting
                        :append :appending :nconc :nconcing :maximize :maximizing
                        :minimize :minimizing :return)
                       (setq else-action (list (car sub-rest) (cadr sub-rest)))
                       (setq sub-rest (cddr sub-rest))
                       (when (and (consp sub-rest) (eq (loop-kw-canon (car sub-rest)) :into))
                         (setq else-action (append else-action (list (car sub-rest) (cadr sub-rest))))
                         (setq sub-rest (cddr sub-rest)))
                       (setq else-action (list :when-else sub-test else-action))
                       (setq then-rest sub-rest)
                       (when (and (consp then-rest) (eq (loop-kw-canon (car then-rest)) :else))
                         (setq then-rest (cdr then-rest))
                         (case (loop-kw-canon (car then-rest))
                           ((:do)
                            (let ((parsed2 (loop-parse-do-action then-rest)))
                              (setq else-action (list :when-else-else sub-test (caddr else-action) (car parsed2)))
                              (setq then-rest (cadr parsed2))))
                           ((:collect :collecting :sum :summing :count :counting
                             :append :appending :nconc :nconcing :maximize :maximizing
                             :minimize :minimizing :return)
                            (let ((else2 (list (car then-rest) (cadr then-rest)))
                                  (after-else2 (cddr then-rest)))
                              (when (and (consp after-else2) (eq (loop-kw-canon (car after-else2)) :into))
                                (setq else2 (append else2 (list (car after-else2) (cadr after-else2))))
                                (setq after-else2 (cddr after-else2)))
                              (setq else-action (list :when-else-else sub-test (caddr else-action) else2))
                              (setq then-rest after-else2))))))
                      (t (error "ELSE WHEN requires DO/COLLECT/etc")))))
                 (t (error "ELSE requires DO/COLLECT/SUM/COUNT/WHEN/etc"))))
             ; Skip END if present
             (when (and (consp then-rest) (eq (loop-kw-canon (car then-rest)) :end))
               (setq then-rest (cdr then-rest)))
             ; Generate conditional forms
             (let ((else-routes nil))
               (when else-action
                 (cond
                   ((and (consp else-action) (eq (car else-action) :when-else))
                    (push (list (list 'and (list 'not test) (cadr else-action)) (caddr else-action)) else-routes))
                   ((and (consp else-action) (eq (car else-action) :when-else-else))
                    (push (list (list 'and (list 'not test) (list 'not (cadr else-action))) (cadddr else-action)) else-routes)
                    (push (list (list 'and (list 'not test) (cadr else-action)) (caddr else-action)) else-routes))
                   (t
                    (push (list (list 'not test) else-action) else-routes))))

               ; THEN action on true predicate
               (case (loop-kw-canon (car then-action))
                 ((:do)
                  (push (list 'when test (loop-do-action-form then-action block-name result-expr)) body-forms))
                 ((:collect :collecting)
                  (let ((into-var (when (and (>= (length then-action) 4)
                                             (eq (loop-kw-canon (caddr then-action)) :into))
                                    (cadddr then-action))))
                    (if into-var
                        (let ((entry (assoc into-var named-collects)))
                          (if entry
                              (push (list 'when test (cadr then-action)) (cdr entry))
                              (push (cons into-var (list (list 'when test (cadr then-action)))) named-collects)))
                        (progn
                          (unless collect-var
                            (setq collect-var (gensym "collect")))
                          (push (list 'when test (cadr then-action)) collect-forms)))))
                 ((:sum :summing)
                  (unless sum-var
                    (setq sum-var (gensym "sum")))
                  (push (list 'when test (cadr then-action)) sum-forms))
                 ((:count :counting)
                  (unless count-var
                    (setq count-var (gensym "count")))
                  (push (list 'when test (cadr then-action)) count-forms))
                 ((:append :appending)
                  (unless append-var
                    (setq append-var (gensym "append")))
                  (push (list 'when test (cadr then-action)) append-forms))
                 ((:nconc :nconcing)
                  (unless nconc-var
                    (setq nconc-var (gensym "nconc")))
                  (push (list 'when test (cadr then-action)) nconc-forms))
                 ((:maximize :maximizing)
                  (unless max-var
                    (setq max-var (gensym "max")))
                  (push (list 'when test (cadr then-action)) max-forms))
                 ((:minimize :minimizing)
                  (unless min-var
                    (setq min-var (gensym "min")))
                  (push (list 'when test (cadr then-action)) min-forms))
                 ((:return)
                  (push (list 'when test (list 'return-from block-name (cadr then-action))) body-forms)))

               ; ELSE routes
               (dolist (route else-routes)
                 (let ((guard (car route))
                       (action (cadr route)))
                   (case (loop-kw-canon (car action))
                     ((:do)
                      (push (list 'when guard (loop-do-action-form action block-name result-expr)) body-forms))
                     ((:collect :collecting)
                      (let ((into-var (when (and (>= (length action) 4)
                                                 (eq (loop-kw-canon (caddr action)) :into))
                                        (cadddr action))))
                        (if into-var
                            (let ((entry (assoc into-var named-collects)))
                              (if entry
                                  (push (list 'when guard (cadr action)) (cdr entry))
                                  (push (cons into-var (list (list 'when guard (cadr action)))) named-collects)))
                            (progn
                              (unless collect-var (setq collect-var (gensym "collect")))
                              (push (list 'when guard (cadr action)) collect-forms)))))
                     ((:sum :summing)
                      (unless sum-var (setq sum-var (gensym "sum")))
                      (push (list 'when guard (cadr action)) sum-forms))
                     ((:count :counting)
                      (unless count-var (setq count-var (gensym "count")))
                      (push (list 'when guard (cadr action)) count-forms))
                     ((:append :appending)
                      (unless append-var (setq append-var (gensym "append")))
                      (push (list 'when guard (cadr action)) append-forms))
                     ((:nconc :nconcing)
                      (unless nconc-var (setq nconc-var (gensym "nconc")))
                      (push (list 'when guard (cadr action)) nconc-forms))
                     ((:maximize :maximizing)
                      (unless max-var (setq max-var (gensym "max")))
                      (push (list 'when guard (cadr action)) max-forms))
                     ((:minimize :minimizing)
                      (unless min-var (setq min-var (gensym "min")))
                      (push (list 'when guard (cadr action)) min-forms))
                     ((:return)
                      (push (list 'when guard (list 'return-from block-name (cadr action))) body-forms))
                     (t
                      (error (format nil "Unsupported ELSE action in IF/WHEN: ~a" (car action))))))))
             (setq rest then-rest)))

          ; UNLESS test clause [ELSE clause] [END]
          ((:unless)
           (let ((test (cadr rest))
                 (then-rest (cddr rest))
                 (then-action nil)
                 (else-action nil))
             ; Parse THEN clause
             (case (loop-kw-canon (car then-rest))
               ((:do)
                (let ((parsed (loop-parse-do-action then-rest)))
                  (setq then-action (car parsed))
                  (setq then-rest (cadr parsed))))
               ((:collect :collecting :sum :summing :count :counting
                 :append :appending :nconc :nconcing :maximize :maximizing
                 :minimize :minimizing :return)
                (setq then-action (list (car then-rest) (cadr then-rest)))
                (setq then-rest (cddr then-rest))
                (when (and (consp then-rest) (eq (loop-kw-canon (car then-rest)) :into))
                  (setq then-action (append then-action (list (car then-rest) (cadr then-rest))))
                  (setq then-rest (cddr then-rest))))
               (t (error "UNLESS requires DO/COLLECT/SUM/COUNT/etc")))
             ; Check for ELSE
             (when (and (consp then-rest) (eq (loop-kw-canon (car then-rest)) :else))
               (setq then-rest (cdr then-rest))
               ; Parse ELSE clause - may be WHEN/UNLESS or direct action
               (case (loop-kw-canon (car then-rest))
                 ((:do)
                  (let ((parsed (loop-parse-do-action then-rest)))
                    (setq else-action (car parsed))
                    (setq then-rest (cadr parsed))))
                 ((:collect :collecting :sum :summing :count :counting
                   :append :appending :nconc :nconcing :maximize :maximizing
                   :minimize :minimizing :return)
                  (setq else-action (list (car then-rest) (cadr then-rest)))
                  (setq then-rest (cddr then-rest))
                  (when (and (consp then-rest) (eq (loop-kw-canon (car then-rest)) :into))
                    (setq else-action (append else-action (list (car then-rest) (cadr then-rest))))
                    (setq then-rest (cddr then-rest))))
                 ((:when)
                  ;; ELSE WHEN sub-test clause [ELSE ...]
                  (let ((sub-test (cadr then-rest))
                        (sub-rest (cddr then-rest)))
                    (case (loop-kw-canon (car sub-rest))
                      ((:do)
                       (let ((parsed (loop-parse-do-action sub-rest)))
                         (setq else-action (car parsed))
                         (setq sub-rest (cadr parsed)))
                       (setq else-action (list :when-else sub-test else-action))
                       (setq then-rest sub-rest)
                       ;; Check for another ELSE after this WHEN
                       (when (and (consp then-rest) (eq (loop-kw-canon (car then-rest)) :else))
                         (setq then-rest (cdr then-rest))
                         (case (loop-kw-canon (car then-rest))
                           ((:do)
                            (let ((parsed2 (loop-parse-do-action then-rest)))
                              (setq else-action (list :when-else-else sub-test (caddr else-action) (car parsed2)))
                              (setq then-rest (cadr parsed2))))
                           ((:collect :collecting :sum :summing :count :counting
                             :append :appending :nconc :nconcing :maximize :maximizing
                             :minimize :minimizing :return)
                            ;; else-else: another fallback
                            (let ((else2 (list (car then-rest) (cadr then-rest)))
                                  (after-else2 (cddr then-rest)))
                              (when (and (consp after-else2) (eq (loop-kw-canon (car after-else2)) :into))
                                (setq else2 (append else2 (list (car after-else2) (cadr after-else2))))
                                (setq after-else2 (cddr after-else2)))
                              (setq else-action (list :when-else-else sub-test (caddr else-action) else2))
                              (setq then-rest after-else2))))))
                      ((:collect :collecting :sum :summing :count :counting
                        :append :appending :nconc :nconcing :maximize :maximizing
                        :minimize :minimizing :return)
                       (setq else-action (list (car sub-rest) (cadr sub-rest)))
                       (setq sub-rest (cddr sub-rest))
                       (when (and (consp sub-rest) (eq (loop-kw-canon (car sub-rest)) :into))
                         (setq else-action (append else-action (list (car sub-rest) (cadr sub-rest))))
                         (setq sub-rest (cddr sub-rest)))
                       ;; Wrap in (when sub-test ...) - handled below
                       (setq else-action (list :when-else sub-test else-action))
                       (setq then-rest sub-rest)
                       ;; Check for another ELSE after this WHEN
                       (when (and (consp then-rest) (eq (loop-kw-canon (car then-rest)) :else))
                         (setq then-rest (cdr then-rest))
                         (case (loop-kw-canon (car then-rest))
                           ((:do)
                            (let ((parsed2 (loop-parse-do-action then-rest)))
                              (setq else-action (list :when-else-else sub-test (caddr else-action) (car parsed2)))
                              (setq then-rest (cadr parsed2))))
                           ((:collect :collecting :sum :summing :count :counting
                             :append :appending :nconc :nconcing :maximize :maximizing
                             :minimize :minimizing :return)
                            ;; else-else: another fallback
                            (let ((else2 (list (car then-rest) (cadr then-rest)))
                                  (after-else2 (cddr then-rest)))
                              (when (and (consp after-else2) (eq (loop-kw-canon (car after-else2)) :into))
                                (setq else2 (append else2 (list (car after-else2) (cadr after-else2))))
                                (setq after-else2 (cddr after-else2)))
                              (setq else-action (list :when-else-else sub-test (caddr else-action) else2))
                              (setq then-rest after-else2))))))
                      (t (error "ELSE WHEN requires DO/COLLECT/etc")))))
                 (t (error "ELSE requires DO/COLLECT/SUM/COUNT/WHEN/etc"))))
             ; Skip END if present
             (when (and (consp then-rest) (eq (loop-kw-canon (car then-rest)) :end))
               (setq then-rest (cdr then-rest)))
             ; Generate conditional forms.
             ; THEN branch uses UNLESS test; ELSE branches are routed by their own action kind.
             (let ((else-routes nil))
               (when else-action
                 (cond
                   ((and (consp else-action) (eq (car else-action) :when-else))
                    (push (list (list 'and test (cadr else-action)) (caddr else-action)) else-routes))
                   ((and (consp else-action) (eq (car else-action) :when-else-else))
                    (push (list (list 'and test (list 'not (cadr else-action))) (cadddr else-action)) else-routes)
                    (push (list (list 'and test (cadr else-action)) (caddr else-action)) else-routes))
                   (t
                    (push (list test else-action) else-routes))))

               (case (loop-kw-canon (car then-action))
                 ((:do)
                  (push (list 'unless test (loop-do-action-form then-action block-name result-expr)) body-forms))
                 ((:collect :collecting)
                  (let ((into-var (when (and (>= (length then-action) 4)
                                             (eq (loop-kw-canon (caddr then-action)) :into))
                                    (cadddr then-action))))
                    (if into-var
                        (let ((entry (assoc into-var named-collects)))
                          (if entry
                              (push (list 'unless test (cadr then-action)) (cdr entry))
                              (push (cons into-var (list (list 'unless test (cadr then-action)))) named-collects)))
                        (progn
                          (unless collect-var (setq collect-var (gensym "collect")))
                          (push (list 'unless test (cadr then-action)) collect-forms)))))
                 ((:sum :summing)
                  (unless sum-var (setq sum-var (gensym "sum")))
                  (push (list 'unless test (cadr then-action)) sum-forms))
                 ((:count :counting)
                  (unless count-var (setq count-var (gensym "count")))
                  (push (list 'unless test (cadr then-action)) count-forms))
                 ((:append :appending)
                  (unless append-var (setq append-var (gensym "append")))
                  (push (list 'unless test (cadr then-action)) append-forms))
                 ((:nconc :nconcing)
                  (unless nconc-var (setq nconc-var (gensym "nconc")))
                  (push (list 'unless test (cadr then-action)) nconc-forms))
                 ((:maximize :maximizing)
                  (unless max-var (setq max-var (gensym "max")))
                  (push (list 'unless test (cadr then-action)) max-forms))
                 ((:minimize :minimizing)
                  (unless min-var (setq min-var (gensym "min")))
                  (push (list 'unless test (cadr then-action)) min-forms))
                 ((:return)
                  (push (list 'unless test (list 'return-from block-name (cadr then-action))) body-forms)))

               (dolist (route else-routes)
                 (let ((guard (car route))
                       (action (cadr route)))
                   (case (loop-kw-canon (car action))
                     ((:do)
                      (push (list 'when guard (loop-do-action-form action block-name result-expr)) body-forms))
                     ((:collect :collecting)
                      (let ((into-var (when (and (>= (length action) 4)
                                                 (eq (loop-kw-canon (caddr action)) :into))
                                        (cadddr action))))
                        (if into-var
                            (let ((entry (assoc into-var named-collects)))
                              (if entry
                                  (push (list 'when guard (cadr action)) (cdr entry))
                                  (push (cons into-var (list (list 'when guard (cadr action)))) named-collects)))
                            (progn
                              (unless collect-var (setq collect-var (gensym "collect")))
                              (push (list 'when guard (cadr action)) collect-forms)))))
                     ((:sum :summing)
                      (unless sum-var (setq sum-var (gensym "sum")))
                      (push (list 'when guard (cadr action)) sum-forms))
                     ((:count :counting)
                      (unless count-var (setq count-var (gensym "count")))
                      (push (list 'when guard (cadr action)) count-forms))
                     ((:append :appending)
                      (unless append-var (setq append-var (gensym "append")))
                      (push (list 'when guard (cadr action)) append-forms))
                     ((:nconc :nconcing)
                      (unless nconc-var (setq nconc-var (gensym "nconc")))
                      (push (list 'when guard (cadr action)) nconc-forms))
                     ((:maximize :maximizing)
                      (unless max-var (setq max-var (gensym "max")))
                      (push (list 'when guard (cadr action)) max-forms))
                     ((:minimize :minimizing)
                      (unless min-var (setq min-var (gensym "min")))
                      (push (list 'when guard (cadr action)) min-forms))
                     ((:return)
                      (push (list 'when guard (list 'return-from block-name (cadr action))) body-forms))
                     (t
                      (error (format nil "Unsupported ELSE action in UNLESS: ~a" (car action))))))))
             (setq rest then-rest)))

          ; COLLECT/COLLECTING expr [INTO var]
          ((:collect :collecting)
           (let ((expr (cadr rest))
                 (into-rest (cddr rest))
                 (into-var nil))
             (when (and (consp into-rest) (eq (loop-kw-canon (car into-rest)) :into))
               (setq into-var (cadr into-rest))
               (setq into-rest (cddr into-rest)))
             (if into-var
                 ;; Named collect: add to named-collects alist
                 (let ((entry (assoc into-var named-collects)))
                   (if entry
                       (push expr (cdr entry))
                       (push (cons into-var (list expr)) named-collects)))
                 ;; Default collect
                 (progn
                   (unless collect-var
                     (setq collect-var (gensym "collect")))
                   (push expr collect-forms)))
             (setq rest into-rest)))

          ; SUM/SUMMING expr [INTO var]
          ((:sum :summing)
           (let ((expr (cadr rest))
                 (into-rest (cddr rest)))
             (when (and (consp into-rest) (eq (loop-kw-canon (car into-rest)) :into))
               (setq sum-var (cadr into-rest))
               (setq into-rest (cddr into-rest)))
             (unless sum-var
               (setq sum-var (gensym "sum")))
             (push expr sum-forms)
             (setq rest into-rest)))

          ; COUNT/COUNTING expr [INTO var]
          ((:count :counting)
           (let ((expr (cadr rest))
                 (into-rest (cddr rest)))
             (when (and (consp into-rest) (eq (loop-kw-canon (car into-rest)) :into))
               (setq count-var (cadr into-rest))
               (setq into-rest (cddr into-rest)))
             (unless count-var
               (setq count-var (gensym "count")))
             (push expr count-forms)
             (setq rest into-rest)))

          ; FINALLY body...
          ((:finally)
           (setq rest (cdr rest))
           (while (and rest (not (loop-keyword-p (car rest))))
             (push (car rest) finally-forms)
             (setq rest (cdr rest)))
           (setq finally-forms (nreverse finally-forms)))

          ; INITIALLY body...
          ((:initially)
           (setq rest (cdr rest))
           (while (and rest (not (loop-keyword-p (car rest))))
             (push (car rest) initially-forms)
             (setq rest (cdr rest)))
           (setq initially-forms (nreverse initially-forms)))

          ; RETURN expr
          ((:return)
           (push (list 'return-from block-name (cadr rest)) body-forms)
           (setq rest (cddr rest)))

          ; NAMED name - set block name for return-from
          ((:named)
           (setq block-name (cadr rest))
           (setq rest (cddr rest)))

          ; APPEND/APPENDING expr [INTO var]
          ((:append :appending)
           (let ((expr (cadr rest))
                 (into-rest (cddr rest)))
             (when (and (consp into-rest) (eq (loop-kw-canon (car into-rest)) :into))
               (setq append-var (cadr into-rest))
               (setq into-rest (cddr into-rest)))
             (unless append-var
               (setq append-var (gensym "append")))
             (push expr append-forms)
             (setq rest into-rest)))

          ; NCONC/NCONCING expr [INTO var]
          ((:nconc :nconcing)
           (let ((expr (cadr rest))
                 (into-rest (cddr rest)))
             (when (and (consp into-rest) (eq (loop-kw-canon (car into-rest)) :into))
               (setq nconc-var (cadr into-rest))
               (setq into-rest (cddr into-rest)))
             (unless nconc-var
               (setq nconc-var (gensym "nconc")))
             (push expr nconc-forms)
             (setq rest into-rest)))

          ; MAXIMIZE/MAXIMIZING expr [INTO var]
          ((:maximize :maximizing)
           (let ((expr (cadr rest))
                 (into-rest (cddr rest)))
             (when (and (consp into-rest) (eq (loop-kw-canon (car into-rest)) :into))
               (setq max-var (cadr into-rest))
               (setq into-rest (cddr into-rest)))
             (unless max-var
               (setq max-var (gensym "max")))
             (push expr max-forms)
             (setq rest into-rest)))

          ; MINIMIZE/MINIMIZING expr [INTO var]
          ((:minimize :minimizing)
           (let ((expr (cadr rest))
                 (into-rest (cddr rest)))
             (when (and (consp into-rest) (eq (loop-kw-canon (car into-rest)) :into))
               (setq min-var (cadr into-rest))
               (setq into-rest (cddr into-rest)))
             (unless min-var
               (setq min-var (gensym "min")))
             (push expr min-forms)
             (setq rest into-rest)))

          ; ALWAYS test - loop terminates with NIL if test fails
          ((:always)
           (push (cadr rest) always-forms)
           (setq rest (cddr rest)))

          ; NEVER test - loop terminates with NIL if test succeeds
          ((:never)
           (push (cadr rest) never-forms)
           (setq rest (cddr rest)))

          ; THEREIS test - loop terminates with value if non-NIL
          ((:thereis)
           (push (cadr rest) thereis-forms)
           (setq rest (cddr rest)))

          (t (if (and (consp kw)
                      (eq (loop-kw-canon (car kw)) :loop-finish)
                      (null (cdr kw)))
                 (progn
                   (push kw body-forms)
                   (setq rest (cdr rest)))
               (error (format nil "Unknown loop keyword: ~a" kw)))))))

    ; Generate the loop code
    (loop-generate-code vars step-forms end-tests body-forms
                        collect-var collect-forms named-collects
                        sum-var sum-forms
                        count-var count-forms
                        append-var append-forms
                        nconc-var nconc-forms
                        max-var max-forms
                        min-var min-forms
                        always-forms never-forms thereis-forms
                        block-name
                        finally-forms initially-forms)))

; Main LOOP macro
(defmacro loop (&rest clauses)
  (if (null clauses)
      ; Simple infinite loop - use block with while t
      '(block nil (while t))
    (if (not (loop-keyword-p (car clauses)))
        ; Simple loop - body forms, wrap in block with while t
        (let ((simple-body (mapcar (lambda (form)
                                     (if (and (consp form)
                                              (eq (loop-kw-canon (car form)) :loop-finish)
                                              (null (cdr form)))
                                         '(return-from nil nil)
                                       form))
                                   clauses)))
          (list 'block nil (cons 'while (cons t simple-body))))
      ; Extended loop with clauses
      (loop-expand clauses))))

;; ============================================================
;; Structure Definition (DEFSTRUCT)
;; ============================================================

; defstruct - define structure type
; Usage: (defstruct name slot1 slot2 ...)
;        (defstruct (name (:constructor make-name)) slot1 slot2)
; Creates: make-NAME constructor, NAME-p predicate, NAME-SLOT accessors
(defmacro defstruct (name-and-options &rest slots)
  (let* ((name (if (consp name-and-options)
                   (car name-and-options)
                   name-and-options))
         (options (if (consp name-and-options)
                      (cdr name-and-options)
                      nil))
         (doc-string (if (and (consp slots) (stringp (car slots)))
                         (car slots)
                         nil))
         (slot-specs (if doc-string (cdr slots) slots))
         (conc-pair (assoc :conc-name options))
         (name-str (string-upcase (symbol-name name)))
         (conc-prefix (if conc-pair
                          (let ((cv (cadr conc-pair)))
                            (if (null cv)
                                ""
                              (string cv)))
                        (concatenate 'string name-str "-")))
         (constructor-name (intern (concatenate 'string "MAKE-" name-str)))
         (predicate-name (intern (concatenate 'string name-str "-P")))
         (copier-pair (assoc :copier options))
         (copier-name (if copier-pair
                          (if (cdr copier-pair) (cadr copier-pair) nil)
                        (intern (concatenate 'string "COPY-" name-str))))
         (slot-names (mapcar (lambda (s) (if (consp s) (car s) s)) slot-specs))
         (slot-count (length slot-names)))

    ; Parse slot defaults
      (let ((slot-defaults (mapcar (lambda (s)
                                   (if (consp s)
                                       (if (cdr s) (cadr s) nil)
                                       nil))
                                 slot-specs)))

      ; Generate forms
      (list 'progn
            ; Constructor: (defun make-NAME (&key slot1 slot2 ...) (vector 'NAME slot1 slot2 ...))
            (list 'defun constructor-name (cons '&key slot-names)
                  (cons 'vector (cons (list 'quote name) slot-names)))

            ; Predicate: (defun NAME-p (obj) (and (vectorp obj) (> (length obj) 0) (eq (svref obj 0) 'NAME)))
            (list 'defun predicate-name '(obj)
                  (list 'and '(vectorp obj)
                        (list '> '(length obj) 0)
                        (list 'eq '(svref obj 0) (list 'quote name))))

            ; Accessors: (defun NAME-SLOT (obj) (svref obj N))
            (cons 'progn
                  (let ((i 1))
                    (mapcar (lambda (slot)
                              (let ((accessor-name (intern (concatenate 'string
                                                                        conc-prefix
                                                                        (string-upcase (symbol-name slot)))))
                                    (index i))
                                (setq i (+ i 1))
                                (list 'defun accessor-name (list 'obj)
                                      (list 'svref 'obj index))))
                            slot-names)))

            ; Copier: (defun COPY-NAME (obj) (copy-structure obj))
            (if copier-name
                (list 'defun copier-name '(obj)
                      (list 'copy-structure 'obj))
              nil)

            ; Setf writers: (setf (fdefinition '(setf ACCESSOR)) (lambda (val obj) ...))
            (cons 'progn
                  (let ((i 1))
                    (mapcar (lambda (slot)
                              (let ((accessor-name (intern (concatenate 'string
                                                                        conc-prefix
                                                                        (string-upcase (symbol-name slot)))))
                                    (index i))
                                (setq i (+ i 1))
                                (list 'setf
                                      (list 'fdefinition (list 'quote (list 'setf accessor-name)))
                                      (list 'function
                                            (list 'lambda (list 'val 'obj)
                                                  (list 'setf (list 'svref 'obj index) 'val))))))
                            slot-names)))))))

;;; ============================================================================
;;; CLOS accessor macros
;;; ============================================================================

; with-slots - access slots as variables (with setf support via symbol-macrolet)
(defmacro with-slots (slots instance &body body)
  (let ((obj (gensym "OBJ")))
    `(let ((,obj ,instance))
       (symbol-macrolet ,(mapcar (lambda (slot)
                                   (let ((name (if (consp slot) (car slot) slot))
                                         (slot-name (if (consp slot) (cadr slot) slot)))
                                     (list name (list 'slot-value obj (list 'quote slot-name)))))
                                 slots)
         ,@body))))

; with-accessors - bind accessors to variables (with setf support via symbol-macrolet)
(defmacro with-accessors (accessors instance &body body)
  (let ((obj (gensym "OBJ")))
    `(let ((,obj ,instance))
       (symbol-macrolet ,(mapcar (lambda (spec)
                                   (let ((var (car spec))
                                         (accessor (cadr spec)))
                                     (list var (list accessor obj))))
                                 accessors)
         ,@body))))

;;; ============================================================================
;;; Stream functions
;;; ============================================================================

; open - open a file stream
; (open filename &key direction if-exists if-does-not-exist)
(defun open (filename &key (direction :input) if-exists if-does-not-exist)
  (declare (ignore if-exists if-does-not-exist))
  (%open-file filename direction))

; close - close a stream
(defun close (stream &optional abort)
  (declare (ignore abort))
  (%close-stream stream))

; write-char - write a character to stream (or *standard-output*)
(defun write-char (character &optional stream)
  (write-to-stream (string character) (or stream *standard-output*))
  character)

; read-char - read a character from stream (or *standard-input*)
(defun read-char (&optional stream eof-error-p eof-value recursive-p)
  (declare (ignore eof-error-p recursive-p))
  (if stream
      (let ((code (%read-char-from-stream stream)))
        (if code (code-char code) eof-value))
      (%read-char)))

; peek-char - peek at next character from stream
(defun peek-char (&optional peek-type stream eof-error-p eof-value recursive-p)
  (declare (ignore eof-error-p recursive-p peek-type))
  (if stream
      (let ((code (%peek-char-from-stream stream)))
        (if code (code-char code) eof-value))
      (%peek-char)))

; read-char-no-hang - non-blocking read when a character is available
(defun read-char-no-hang (&optional stream eof-error-p eof-value recursive-p)
  (declare (ignore eof-error-p recursive-p))
  (if stream
      (let ((peek (%peek-char-from-stream stream)))
        (if peek
            (code-char (%read-char-from-stream stream))
            eof-value))
      (let ((peek (%peek-char)))
        (if peek
            (%read-char)
            eof-value))))

;;; ============================================================================
;;; Stream macros
;;; ============================================================================

(defmacro with-open-file (spec &body body)
  (let ((var (car spec))
        (filespec (cadr spec))
        (options (cddr spec))
        (stream (gensym "STREAM"))
        (abort (gensym "ABORT")))
    ;; Check for :if-does-not-exist nil
    (let ((if-dne (getf options :if-does-not-exist :signal))
          (clean-options options))
      ;; Remove :if-does-not-exist from options passed to open
      (when (not (eq if-dne :signal))
        (setq clean-options nil)
        (let ((rest options))
          (while rest
            (if (eq (car rest) :if-does-not-exist)
                (setq rest (cddr rest))
                (progn
                  (setq clean-options (append clean-options (list (car rest) (cadr rest))))
                  (setq rest (cddr rest)))))))
      (if (null if-dne)
          ;; :if-does-not-exist nil - catch file errors, bind nil
          `(let ((,stream (handler-case (open ,filespec ,@clean-options)
                            (file-error (c) nil)))
                 (,abort t))
             (unwind-protect
                 (let ((,var ,stream))
                   (setq ,abort nil)
                   ,@body)
               (when ,stream (close ,stream ,abort))))
          ;; Normal case
          `(let* ((,stream (open ,filespec ,@clean-options))
                  (,abort t))
             (unwind-protect
                 (progn
                   (let ((,var ,stream))
                     (setq ,abort nil)
                     ,@body))
               (close ,stream ,abort)))))))

(defmacro with-input-from-string (spec &body body)
  (let ((var (car spec))
        (string (cadr spec)))
    `(let ((,var (make-string-input-stream ,string)))
       ,@body)))

(defmacro with-output-to-string (spec &body body)
  (let ((var (car spec))
        (dest (cadr spec))
        (tmp (gensym "WOS-TMP"))
        (i (gensym "WOS-I")))
    (if dest
        `(let ((,var (make-string-output-stream)))
           ,@body
           (let ((,tmp (get-output-stream-string ,var)))
             (if (vectorp ,dest)
                 (dotimes (,i (length ,tmp))
                   (vector-push-extend (char ,tmp ,i) ,dest))
                 (setq ,dest ,tmp))
             ,dest))
        `(let ((,var (make-string-output-stream)))
           ,@body
           (get-output-stream-string ,var)))))

; with-open-stream - generic stream wrapper
(defmacro with-open-stream (spec &body body)
  (let ((var (car spec))
        (stream-form (cadr spec))
        (stream (gensym "STREAM"))
        (abort (gensym "ABORT")))
    `(let ((,stream ,stream-form)
           (,abort t))
       (unwind-protect
           (progn
             (let ((,var ,stream))
               (setq ,abort nil)
               ,@body))
         (when ,stream
           (close ,stream ,abort))))))

; with-standard-io-syntax - establish standard I/O environment
(defmacro with-standard-io-syntax (&body body)
  `(let ((*package* (find-package "COMMON-LISP-USER"))
         (*print-array* t)
         (*print-base* 10)
         (*print-case* :upcase)
         (*print-circle* nil)
         (*print-escape* t)
         (*print-gensym* t)
         (*print-length* nil)
         (*print-level* nil)
         (*print-lines* nil)
         (*print-miser-width* nil)
         (*print-pprint-dispatch* nil)
         (*print-pretty* nil)
         (*print-radix* nil)
         (*print-readably* t)
         (*print-right-margin* nil)
         (*read-base* 10)
         (*read-default-float-format* 'single-float)
         (*read-eval* t)
         (*read-suppress* nil))
     ,@body))

; print-unreadable-object - print #<...> notation
(defmacro print-unreadable-object (spec &body body)
  (let ((obj (car spec))
        (stream (cadr spec))
        (type-p (getf (cddr spec) :type))
        (identity-p (getf (cddr spec) :identity)))
    (let ((s (gensym "STREAM")))
      `(let ((,s ,stream))
         (princ "#<" ,s)
         ,(when type-p
            `(progn
               (princ (type-of ,obj) ,s)
               (princ " " ,s)))
         ,@body
         ,(when identity-p
            `(progn
               (princ " " ,s)
               (prin1 (sxhash ,obj) ,s)))
         (princ ">" ,s)
         nil))))

;;; ============================================================================
;;; Debugging/tracing macros (stubs)
;;; ============================================================================

; step - single-step evaluator (stub)
(defmacro step (form)
  `(progn
     (format t "~&STEP: ~S~%" ',form)
     ,form))

; time - time execution (stub)
(defmacro time (form)
  (let ((start (gensym "START"))
        (result (gensym "RESULT")))
    `(let ((,start (get-internal-real-time)))
       (let ((,result ,form))
         (format t "~&Evaluation took ~D microseconds~%"
                 (- (get-internal-real-time) ,start))
         ,result))))

; trace - trace function calls (stub)
(defmacro trace (&rest names)
  (declare (ignore names))
  '(progn))

; untrace - untrace function calls (stub)
(defmacro untrace (&rest names)
  (declare (ignore names))
  '(progn))

; with-simple-restart - establish simple restart
(defmacro with-simple-restart (restart-spec &body body)
  (let ((name (car restart-spec))
        (format-control (cadr restart-spec))
        (format-args (cddr restart-spec)))
    `(restart-case
         (progn ,@body)
       (,name ()
         :report (lambda (stream)
                   (format stream ,format-control ,@format-args))
         (values nil t)))))

; with-compilation-unit - group compilation (stub)
(defmacro with-compilation-unit (options &body body)
  (declare (ignore options))
  `(progn ,@body))

; with-condition-restarts - associate restarts with condition (stub)
(defmacro with-condition-restarts (condition restarts &body body)
  (declare (ignore condition restarts))
  `(progn ,@body))

; with-package-iterator - package symbol iteration
; (with-package-iterator (name package-list {symbol-type}*) body...)
; symbol-type: :internal | :external | :inherited
(defmacro with-package-iterator (spec &body body)
  (let ((name (car spec))
        (package-form (cadr spec))
        (types (cddr spec))
        (pkg-list (gensym "PKG-LIST"))
        (iter-list (gensym "ITER-LIST"))
        (cursor (gensym "CURSOR"))
        (pkg (gensym "PKG"))
        (seen (gensym "SEEN"))
        (local-syms (gensym "LOCAL-SYMS"))
        (ext-syms (gensym "EXT-SYMS"))
        (used-pkg (gensym "USED-PKG"))
        (sym (gensym "SYM"))
        (entry (gensym "ENTRY")))
    `(let* ((,pkg-list (let ((p ,package-form))
                         (if (listp p) p (list p))))
            (,iter-list nil))
       (dolist (,pkg ,pkg-list)
         (when ,pkg
           (setq ,pkg (%ensure-package ,pkg))
           (let ((,seen (make-hash-table :test 'eq))
                 (,local-syms (%package-symbols-list ,pkg))
                 (,ext-syms (%package-exports-list ,pkg)))
             (when (or (null ',types) (member :external ',types))
               (dolist (,sym ,ext-syms)
                 (unless (gethash ,sym ,seen)
                   (setf (gethash ,sym ,seen) t)
                   (push (list ,sym :external ,pkg) ,iter-list))))
             (when (or (null ',types) (member :internal ',types))
               (dolist (,sym ,local-syms)
                 (unless (or (gethash ,sym ,seen)
                             (member ,sym ,ext-syms))
                   (setf (gethash ,sym ,seen) t)
                   (push (list ,sym :internal ,pkg) ,iter-list))))
             (when (or (null ',types) (member :inherited ',types))
               (dolist (,used-pkg (package-use-list ,pkg))
                 (dolist (,sym (%package-exports-list ,used-pkg))
                   (unless (or (gethash ,sym ,seen)
                               (member ,sym ,local-syms))
                     (setf (gethash ,sym ,seen) t)
                     (push (list ,sym :inherited ,pkg) ,iter-list))))))))
       (setq ,iter-list (nreverse ,iter-list))
       (let ((,cursor ,iter-list))
         (flet ((,name ()
                  (if ,cursor
                      (let ((,entry (car ,cursor)))
                        (setq ,cursor (cdr ,cursor))
                        (values t (car ,entry) (cadr ,entry) (caddr ,entry)))
                    (values nil nil nil nil))))
           ,@body)))))

; defsetf - define setf expansion (simple form)
(defmacro defsetf (access-fn &rest rest)
  (if (symbolp (car rest))
      (let ((update-fn (car rest)))
        `(progn
           (put ',access-fn 'setf-function ',update-fn)
           ',access-fn))
    (let* ((lambda-list (car rest))
           (store-vars (car (cdr rest)))
           (body-forms (%strip-leading-defsetf-body (cdr (cdr rest)))))
      `(define-setf-expander ,access-fn ,lambda-list
         (let* ((temps (%setf-gensym-list ',lambda-list))
                (stores ',store-vars)
                (vals (list ,@lambda-list))
                (writer
                 (eval
                  (list 'let*
                        (append (%pair-quoted-bindings ',lambda-list temps)
                                (%self-bindings stores))
                        (cons 'block
                              (cons ',access-fn ',body-forms)))))
                (reader (cons ',access-fn temps)))
           (values temps vals stores writer reader))))))

; define-modify-macro - define read-modify-write macro
(defmacro define-modify-macro (name lambda-list function &optional doc)
  (declare (ignore doc))
  (let ((ref (gensym "REF")))
    `(defmacro ,name (,ref ,@lambda-list)
       (list 'setf ,ref (list ',function ,ref ,@lambda-list)))))

; define-symbol-macro - define symbol macro (needs compiler support)
(defmacro define-symbol-macro (symbol expansion)
  (declare (ignore symbol expansion))
  nil)

; define-setf-expander - define complex setf expansion
(defun %apply-setf-expansion (expansion new-value)
  (let* ((temps (nth 0 expansion))
         (vals (nth 1 expansion))
         (stores (nth 2 expansion))
         (writer (nth 3 expansion))
         (tmp-binds (%pair-bindings temps vals))
         (store-binds
          (if (null stores)
              nil
            (cons (list (car stores) (list 'quote new-value))
                  (let ((rest (cdr stores))
                        (acc nil))
                    (while rest
                      (push (list (car rest) (list 'quote new-value)) acc)
                      (setq rest (cdr rest)))
                    (nreverse acc))))))
    (eval (list 'let* tmp-binds (list 'let* store-binds writer)))
    new-value))

(defmacro define-setf-expander (access-fn lambda-list &body body)
  (let ((new (gensym "NEW"))
        (place-args (gensym "PLACE-ARGS"))
        (arg-forms (gensym "ARG-FORMS")))
    `(progn
       (%set-setf-expander ',access-fn (lambda ,lambda-list ,@body))
       (setf (fdefinition '(setf ,access-fn))
             (lambda (,new &rest ,place-args)
               (let ((,arg-forms (mapcar (lambda (v) (list 'quote v)) ,place-args)))
                 (%apply-setf-expansion
                   (multiple-value-list
                     (apply (%get-setf-expander ',access-fn) ,arg-forms))
                   ,new))))
       ',access-fn)))

; define-compiler-macro - compiler optimization hint (stub)
(defmacro define-compiler-macro (name lambda-list &body body)
  (declare (ignore name lambda-list body))
  nil)

; define-method-combination - CLOS method combination (stub)
(defmacro define-method-combination (name &rest args)
  (declare (ignore name args))
  nil)

; Method-combination helper symbols
(defvar standard 'standard)
(defvar *method-combination-args* nil)

; call-method - invoke a method object, optionally installing next-method.
(defmacro call-method (method &optional next-methods)
  (declare (ignore next-methods))
  `(let ((m ,method))
     (if (functionp m)
         (funcall m)
       (funcall (method-function m)))))

; make-method - build a method object from an effective method form.
(defmacro make-method (form)
  `(lambda (&rest *method-combination-args*)
     ,form))

; invalid-method-error - signal invalid method use in method combinations.
(defun invalid-method-error (method format-control &rest format-arguments)
  (declare (ignore method))
  (apply #'error format-control format-arguments))

; method-combination-error - signal method combination expansion errors.
(defun method-combination-error (format-control &rest format-arguments)
  (apply #'error format-control format-arguments))

; formatter - compile format string (stub - just returns lambda)
(defmacro formatter (control-string)
  `(lambda (stream &rest args)
     (apply #'format stream ,control-string args)))

; pprint-logical-block - pretty-printing block (stub)
(defmacro pprint-logical-block (spec &body body)
  (let ((stream (car spec)))
    `(progn
       (princ "(" ,stream)
       ,@body
       (princ ")" ,stream))))

; pprint-pop - pop from pprint list (stub)
(defmacro pprint-pop ()
  `(pop *pprint-list*))

; pprint-exit-if-list-exhausted - exit if empty (stub)
(defmacro pprint-exit-if-list-exhausted ()
  `(when (null *pprint-list*)
     (return-from nil nil)))

;;; ============================================================================
;;; Pathname Functions
;;; ============================================================================

(defun make-pathname (&key host device directory name type version defaults case)
  "Create a pathname from components, optionally merging with defaults."
  (declare (ignore case))
  (let ((h (if (null host) (if defaults (pathname-host defaults) nil) host))
        (dev (if (null device) (if defaults (pathname-device defaults) nil) device))
        (dir (if (null directory) (if defaults (pathname-directory defaults) nil) directory))
        (n (if (null name) (if defaults (pathname-name defaults) nil) name))
        (ty (if (null type) (if defaults (pathname-type defaults) nil) type))
        (v (if (null version) (if defaults (pathname-version defaults) nil) version)))
    (%make-pathname h dev dir n ty v)))

; CL requires *default-pathname-defaults* to be a pathname designator.
(setq *default-pathname-defaults* (make-pathname))

(defun pathname-host (pathname)
  "Return the host component of pathname."
  (%pathname-host (pathname pathname)))

(defun pathname-device (pathname)
  "Return the device component of pathname."
  (%pathname-device (pathname pathname)))

(defun pathname-directory (pathname)
  "Return the directory component of pathname."
  (%pathname-directory (pathname pathname)))

(defun pathname-name (pathname)
  "Return the name component of pathname."
  (%pathname-name (pathname pathname)))

(defun pathname-type (pathname)
  "Return the type component of pathname."
  (%pathname-type (pathname pathname)))

(defun pathname-version (pathname)
  "Return the version component of pathname."
  (%pathname-version (pathname pathname)))

;;; Package Iteration Macros
;;; ============================================================================

; Helper to get package symbols as a list
(defun %package-symbols-list (pkg)
  "Internal: extract all symbols from package's internal hash table"
  (let ((result nil))
    (when pkg
      ; Package.symbols is a hash table - extract symbols
      (let ((syms (package-symbols-table pkg)))
        (when syms
          (dolist (pair (hash-table-alist syms))
            (when (symbolp (car pair))
              (setq result (cons (car pair) result)))))))
    result))

; Helper to get package exports as a list
(defun %package-exports-list (pkg)
  "Internal: extract all exported symbols from package"
  (let ((result nil))
    (when pkg
      (let ((exps (package-exports-table pkg)))
        (when exps
          (dolist (pair (hash-table-alist exps))
            (when (symbolp (car pair))
              (setq result (cons (car pair) result)))))))
    result))

; do-symbols - iterate over accessible symbols in package
; (do-symbols (var [package [result]]) body...)
; Iterates over all accessible symbols (internal, external, inherited) in package
(defmacro do-symbols (spec &rest body)
  (let ((var (car spec))
        (pkg (or (cadr spec) '*package*))
        (result (caddr spec))
        (temp-pkg (gensym "PKG"))
        (sym-list (gensym "SYMS"))
        (seen (gensym "SEEN")))
    `(let* ((,temp-pkg (%ensure-package ,pkg))
            (,seen (make-hash-table :test 'eq))
            (,sym-list nil))
       (block nil
         ; Collect internal symbols
         (dolist (s (%package-symbols-list ,temp-pkg))
           (unless (gethash s ,seen)
             (setf (gethash s ,seen) t)
             (push s ,sym-list)))
         ; Collect inherited symbols from used packages
         (dolist (used-pkg (package-use-list ,temp-pkg))
           (dolist (s (%package-exports-list used-pkg))
             (unless (gethash s ,seen)
               (setf (gethash s ,seen) t)
               (push s ,sym-list))))
         ; Iterate over collected symbols
         (dolist (,var ,sym-list)
           ,@body)
         ; Return result with var bound to nil
         (let ((,var nil)) ,result)))))

; do-external-symbols - iterate over exported symbols in package
; (do-external-symbols (var [package [result]]) body...)
(defmacro do-external-symbols (spec &rest body)
  (let ((var (car spec))
        (pkg (or (cadr spec) '*package*))
        (result (caddr spec))
        (temp-pkg (gensym "PKG")))
    `(let ((,temp-pkg (%ensure-package ,pkg)))
       (block nil
         (dolist (,var (%package-exports-list ,temp-pkg))
           ,@body)
         (let ((,var nil)) ,result)))))

; do-all-symbols - iterate over all symbols in all packages
; (do-all-symbols (var [result]) body...)
(defmacro do-all-symbols (spec &rest body)
  (let ((var (car spec))
        (result (cadr spec))
        (pkg-list (gensym "PKGS"))
        (pkg-var (gensym "PKG"))
        (seen (gensym "SEEN")))
    `(let* ((,pkg-list (list-all-packages))
            (,seen (make-hash-table :test 'eq)))
       (block nil
         (dolist (,pkg-var ,pkg-list)
           (when (packagep ,pkg-var)
             (dolist (,var (%package-symbols-list ,pkg-var))
               (unless (gethash ,var ,seen)
                 (setf (gethash ,var ,seen) t)
                 ,@body))))
         (let ((,var nil)) ,result)))))

(defun logtest (a b)
  (not (zerop (logand a b))))

;; write - output object readably (with *print-escape* = t)
(defun write (object &optional stream)
  (let ((old-escape *print-escape*))
    (setf *print-escape* t)
    (princ object stream)
    (setf *print-escape* old-escape)
    object))

;; prin1 - same as write (readable output)
(defun prin1 (object &optional stream)
  (write object stream))

;; CLOS initialization protocol
;; NOTE: Using defun for now - proper generic functions TODO

; Simple stubs for CLOS initialization
(defun make-instance (class &rest initargs)
  "Create an instance of CLASS (stub)"
  (declare (ignore initargs class))
  nil)

;; Ensure CL package entry point is present even when stdlib loads in CL-USER.
(unless (eq 'make-instance 'common-lisp:make-instance)
  (setf (fdefinition 'common-lisp:make-instance) #'make-instance))

(defun allocate-instance (class &rest initargs)
  "Allocate storage for an instance (stub)"
  (declare (ignore initargs class))
  nil)

(defgeneric initialize-instance (instance &rest initargs))
(defmethod initialize-instance ((instance t) &rest initargs)
  "Default method: return instance unchanged"
  (declare (ignore initargs))
  instance)

(defun reinitialize-instance (instance &rest initargs)
  "Reinitialize an instance (stub)"
  (declare (ignore initargs))
  instance)

(defun no-applicable-method (generic-function &rest args)

  "Default method: signal error"
  (error "No applicable method for generic function ~A with arguments ~A"
         generic-function args))

(defun no-next-method (generic-function method &rest args)

  "Default method: signal error"
  (error "No next method for generic function ~A, method ~A with arguments ~A"
         generic-function method args))

(defun update-instance-for-different-class (previous current &rest initargs)

  "Default method: initialize new slots"
  (apply #'initialize-instance current initargs))

;; change-class: dynamically change an object's class
(defun change-class (instance new-class &rest initargs)
  "Change the class of INSTANCE to NEW-CLASS, copying compatible slots"
  ;; For now, simplified implementation: create new instance and copy slots
  ;; Full CLOS would: allocate new, copy matching slots, call update-instance-for-different-class
  (let ((old-class (class-of instance))
        (new-instance (apply #'make-instance new-class initargs)))
    ;; In full implementation: copy compatible slot values, call protocol hook
    ;; For now, return new instance (mutation would require internal VM support)
    new-instance))

;; slot-exists-p: check if a slot exists in an object's class
(defun slot-exists-p (object slot-name)
  "Return T if OBJECT has a slot named SLOT-NAME, NIL otherwise"
  (let ((class (class-of object)))
    (if (null class)
        nil
        (let ((slots (class-slots class)))
          (dolist (slot slots nil)
            (when (eq (slot-definition-name slot) slot-name)
              (return t)))))))

;; %make-condition - primitive for simple conditions
;; For CLOS-based conditions, use make-instance
(defun make-condition (type &rest initargs)
  (apply #'make-instance type initargs))

;; Restart convenience functions

(defun abort (&optional condition)
  "Invoke the abort restart"
  (declare (ignore condition))
  (invoke-restart 'abort))

(defun continue (&optional condition)
  "Invoke the continue restart"
  (declare (ignore condition))
  (invoke-restart 'continue))

(defun muffle-warning (&optional condition)
  "Invoke the muffle-warning restart"
  (declare (ignore condition))
  (invoke-restart 'muffle-warning))

(defun store-value (value &optional condition)
  "Invoke the store-value restart with value"
  (declare (ignore condition))
  (invoke-restart 'store-value value))

(defun use-value (value &optional condition)
  "Invoke the use-value restart with value"
  (declare (ignore condition))
  (invoke-restart 'use-value value))

; apropos - print symbols matching string
(defun apropos (string &optional package)
  "Print all symbols matching STRING"
  (let ((syms (apropos-list string package)))
    (dolist (sym syms)
      (print sym))
    (values)))

; describe - print description of an object
(defun describe (object &optional stream)
  "Print a description of OBJECT to STREAM"
  (let ((out (or stream *standard-output*)))
    (format out "~A~%" object)
    (format out "  Type: ~A~%" (type-of object))
    (cond
      ((consp object)
       (format out "  CAR: ~A~%" (car object))
       (format out "  CDR: ~A~%" (cdr object)))
      ((vectorp object)
       (format out "  Length: ~A~%" (length object)))
      ((stringp object)
       (format out "  Length: ~A~%" (length object)))
      ((symbolp object)
       (format out "  Package: ~A~%" (symbol-package object))
       (when (boundp object)
         (format out "  Value: ~A~%" (symbol-value object)))
       (when (fboundp object)
         (format out "  Function: ~A~%" (symbol-function object)))))
    (values)))

; inspect - inspect an object (non-interactive version)
(defun inspect (object)
  "Interactively inspect OBJECT (calls describe)"
  (describe object))

; pprint - pretty print an object
(defun pprint (object &optional stream)
  "Pretty print OBJECT to STREAM"
  (terpri stream)
  (write object stream)
  (values))

; pprint-fill - print as filling output
(defun pprint-fill (stream list &optional colon-p at-sign-p)
  "Print LIST elements filling lines"
  (declare (ignore colon-p at-sign-p))
  (format stream "~{~A~^ ~}" list))

; pprint-linear - print linearly
(defun pprint-linear (stream list &optional colon-p at-sign-p)
  "Print LIST elements one per line"
  (declare (ignore colon-p at-sign-p))
  (format stream "~{~A~%~}" list))

; pprint-tabular - print in tabular format
(defun pprint-tabular (stream list &optional colon-p at-sign-p tabsize)
  "Print LIST in tabular format"
  (declare (ignore colon-p at-sign-p tabsize))
  (format stream "~{~A~%~}" list))

; provide - mark a module as loaded
(defun provide (module-name)
  "Mark MODULE-NAME as provided"
  (let ((name (string module-name)))
    (unless (member name *modules* :test #'string=)
      (push name *modules*))
    name))

; require - load a module if not already loaded
(defun require (module-name &optional pathname-list)
  "Load MODULE-NAME if not already provided"
  (let ((name (string module-name)))
    (unless (member name *modules* :test #'string=)
      (if pathname-list
          (dolist (path pathname-list)
            (load path))
          (load (concatenate 'string name ".lisp")))
      (provide name))
    name))

; macro-function - get macro expansion function
(defun macro-function (symbol &optional env)
  "Return the macro function for SYMBOL, or NIL"
  (declare (ignore env))
  ;; In our implementation, check if symbol has macro property
  (get symbol 'macro-function))

; documentation - get documentation string
(defun documentation (x doc-type)
  "Return documentation string for X of type DOC-TYPE"
  (declare (ignore doc-type))
  (if (symbolp x)
      (get x 'documentation)
      nil))

; (setf documentation) - set documentation string
(defun set-documentation (x doc-type value)
  "Set documentation string for X of type DOC-TYPE"
  (declare (ignore doc-type))
  (when (symbolp x)
    (setf (get x 'documentation) value))
  value)

; dribble - toggle output recording (stub)
(defun dribble (&optional pathname)
  "Start or stop recording of terminal I/O to a file"
  (declare (ignore pathname))
  nil)

; ed - invoke editor (stub)
(defun ed (&optional x)
  "Invoke text editor on X"
  (declare (ignore x))
  (format t "Editor not available~%")
  nil)

; invoke-debugger - enter debugger
(defun invoke-debugger (condition)
  "Invoke the debugger on CONDITION"
  (format *error-output* "~%Debugger invoked: ~A~%" condition)
  (when *debugger-hook*
    (let ((hook *debugger-hook*))
      (setf *debugger-hook* nil)
      (funcall hook condition hook)))
  (error "Unhandled condition in debugger"))

; print-object - CLOS print method (simplified)
(defgeneric print-object (object stream))
(defmethod print-object ((object t) stream)
  "Default: print OBJECT to STREAM via write"
  (write object :stream stream)
  object)

; %set-elt - runtime setter for (setf (elt ...))
(defun %set-elt (seq idx val)
  "Set element at IDX in SEQ to VAL. Works on both lists and vectors."
  (if (listp seq)
      (progn (rplaca (nthcdr idx seq) val) val)
    (progn (setf (aref seq idx) val) val)))

