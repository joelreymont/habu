;; Habu Standard Library - Obsolete Stub
;;
;; DEPRECATED: This file is an old stub kept for reference only.
;; The actual standard library is at ../stdlib.habu (2700+ lines).
;; This file is NOT loaded by the REPL.
;;
;; Do not edit this file. Edit ../stdlib.habu instead.

;; Package utilities
(defmacro defpackage (name &key nicknames use export shadow shadowing-import-from import-from)
  "Define a package with nicknames, use, export, shadow, etc."
  `(progn
     ;; Create the package (handled by defpackage special form in compiler)
     ;; But we need to expand to in-package and export calls
     (in-package ,name)
     ;; Use packages
     ,@(if use
           (list `(progn ,@(map (lambda (pkg) `(use-package ,pkg)) use)))
           nil)
     ;; Export symbols
     ,@(if export
           (list `(export ,@export))
           nil)
     ;; Return package name
     ,name))

;; List utilities
(defun list3 (a b c)
  "Create a 3-element list"
  (cons a (cons b (cons c nil))))

(defun reverse (lst)
  "Reverse a list"
  (let ((acc nil))
    (while (not (null lst))
      (set! acc (cons (car lst) acc))
      (set! lst (cdr lst)))
    acc))

(defun map (fn lst)
  "Apply function to each element of list"
  (if (null lst)
      nil
      (cons (funcall fn (car lst))
            (map fn (cdr lst)))))

;; Logic operations
(defun logorc1 (a b)
  "Bitwise OR with NOT of first argument"
  (logior (lognot a) b))

(defun logorc2 (a b)
  "Bitwise OR with NOT of second argument"
  (logior a (lognot b)))

(defun logtest (a b)
  "Test if any bits set in both arguments"
  (not (zerop (logand a b))))

;; Additional math functions
(defun 1+ (x) "Add 1 to x" (+ x 1))
(defun 1- (x) "Subtract 1 from x" (- x 1))

(defun signum (x)
  "Return -1, 0, or 1 depending on sign of x"
  (cond
    ((zerop x) 0)
    ((plusp x) 1)
    (t -1)))

(defun ffloor (x &optional (divisor 1))
  "Float floor - return float quotient"
  (float (floor x divisor)))

(defun fceiling (x &optional (divisor 1))
  "Float ceiling - return float quotient"
  (float (ceiling x divisor)))

(defun fround (x &optional (divisor 1))
  "Float round - return float quotient"
  (float (round x divisor)))

(defun ftruncate (x &optional (divisor 1))
  "Float truncate - return float quotient"
  (float (truncate x divisor)))

(defun isqrt (n)
  "Integer square root"
  (if (< n 0)
      (error "isqrt of negative number")
      (floor (sqrt n))))

;; Trigonometric functions are now primitives: asin, acos, atan, sinh, cosh, tanh, asinh, acosh, atanh

;; Sequence functions

(defun fill (seq item &key start end)
  "Fill sequence with item"
  (let ((s (or start 0))
        (e (or end (length seq))))
    (if (vectorp seq)
        (let ((i s))
          (while (< i e)
            (setf (aref seq i) item)
            (set! i (1+ i)))
          seq)
        (error "fill: unsupported sequence type"))))

(defun replace (seq1 seq2 &key start1 end1 start2 end2)
  "Replace elements of seq1 with elements of seq2"
  (let ((s1 (or start1 0))
        (e1 (or end1 (length seq1)))
        (s2 (or start2 0))
        (e2 (or end2 (length seq2))))
    (if (and (vectorp seq1) (vectorp seq2))
        (let ((i s1)
              (j s2))
          (while (and (< i e1) (< j e2))
            (setf (aref seq1 i) (aref seq2 j))
            (set! i (1+ i))
            (set! j (1+ j)))
          seq1)
        (error "replace: unsupported sequence types"))))

(defun map-into (result-seq fn &rest seqs)
  "Destructively modify result-seq by applying fn to corresponding elements"
  (if (vectorp result-seq)
      (let ((i 0)
            (len (length result-seq)))
        (if (null seqs)
            result-seq
            (let ((seq1 (car seqs)))
              (while (and (< i len) (< i (length seq1)))
                (setf (aref result-seq i) (funcall fn (elt seq1 i)))
                (set! i (1+ i)))
              result-seq)))
      (error "map-into: unsupported result sequence type")))
