; make-echo-stream - create echo stream
(defun make-echo-stream (input-stream output-stream)
  "Create an echo stream"
  (%make-echo-stream input-stream output-stream))

; echo-stream-input-stream - primitive (defined in compiler/vm)
; echo-stream-output-stream - primitive (defined in compiler/vm)

; make-synonym-stream - create synonym stream
(defun make-synonym-stream (symbol)
  "Create a synonym stream for SYMBOL"
  (%make-synonym-stream symbol))

; synonym-stream-symbol is a primitive (defined in compiler/vm)

; make-two-way-stream - create two-way stream
(defun make-two-way-stream (input-stream output-stream)
  "Create a two-way stream"
  (%make-two-way-stream input-stream output-stream))

; two-way-stream-input-stream - primitive (defined in compiler/vm)
; two-way-stream-output-stream - primitive (defined in compiler/vm)

; file-error-pathname - get pathname from file-error
(defun file-error-pathname (condition)
  "Return the pathname associated with the condition"
  (slot-value condition 'pathname))

; stream-error-stream - get stream from stream-error
(defun stream-error-stream (condition)
  "Return the stream associated with the condition"
  (slot-value condition 'stream))

; package-error-package - get package from package-error
(defun package-error-package (condition)
  "Return the package associated with the condition"
  (slot-value condition 'package))

; compile - compile function (stub)
(defun compile (name &optional definition)
  "Compile NAME as a function"
  (declare (ignore definition))
  name) ; Stub: habu is already compiled

; compile-file - compile file (stub)
(defun compile-file (input-file &key output-file verbose print external-format)
  "Compile INPUT-FILE"
  (declare (ignore output-file verbose print external-format))
  (load input-file)
  (values (pathname input-file) nil nil))

; compile-file-pathname - get output pathname (stub)
(defun compile-file-pathname (input-file &key output-file &allow-other-keys)
  "Return the pathname that compile-file would write"
  (or output-file (make-pathname :type "fasl" :defaults input-file)))

; disassemble - show bytecode disassembly
(defun disassemble (fn)
  "Display the disassembly of FN"
  (format t "~&Disassembly of ~A:~%" fn)
  (%disassemble fn))

; read-delimited-list - read until delimiter (stub)
(defun read-delimited-list (char &optional stream recursive-p)
  "Read objects until CHAR is encountered"
  (declare (ignore char recursive-p))
  (let ((result nil))
    (loop
      (let ((obj (read stream nil 'eof)))
        (when (eq obj 'eof)
          (return (nreverse result)))
        (push obj result)))))

; read-preserving-whitespace - read without consuming trailing whitespace
(defun read-preserving-whitespace (&optional stream eof-error-p eof-value recursive-p)
  "Read an object, preserving trailing whitespace"
  ;; In our simple implementation, same as read
  (read stream eof-error-p eof-value recursive-p))

; invoke-restart-interactively - invoke restart with user input (stub)
(defun invoke-restart-interactively (restart)
  "Invoke RESTART, prompting for any required arguments"
  (invoke-restart restart))

; cell-error-name - get name from cell-error
(defun cell-error-name (condition)
  "Return the name associated with the cell-error"
  (slot-value condition 'name))

; type-error-datum - get datum from type-error
(defun type-error-datum (condition)
  "Return the datum from the type-error"
  (slot-value condition 'datum))

; type-error-expected-type - get expected type
(defun type-error-expected-type (condition)
  "Return the expected type from the type-error"
  (slot-value condition 'expected-type))

; unbound-slot-instance - get instance from unbound-slot error
(defun unbound-slot-instance (condition)
  "Return the instance with the unbound slot"
  (slot-value condition 'instance))

; print-not-readable-object - get object from print-not-readable error
(defun print-not-readable-object (condition)
  "Return the object that is not readable"
  (slot-value condition 'object))

; ensure-generic-function - get or create GF (stub)
(defun ensure-generic-function (function-name &key lambda-list &allow-other-keys)
  "Ensure that a generic function exists for FUNCTION-NAME"
  (declare (ignore lambda-list))
  (if (fboundp function-name)
      (symbol-function function-name)
      nil)) ; Stub: cannot dynamically create functions yet

; find-method - find method in GF (stub)
(defun find-method (gf qualifiers specializers &optional errorp)
  "Find a method in GF with given QUALIFIERS and SPECIALIZERS"
  (declare (ignore gf qualifiers specializers errorp))
  nil)

; remove-method - remove method from GF (stub)
(defun remove-method (gf method)
  "Remove METHOD from GF"
  (declare (ignore method))
  gf)

; compute-applicable-methods - find applicable methods (stub)
(defun compute-applicable-methods (gf args)
  "Compute the applicable methods for ARGS"
  (declare (ignore gf args))
  nil)

; function-keywords - get keyword params (stub)
(defun function-keywords (method)
  "Return the keyword parameters accepted by METHOD"
  (declare (ignore method))
  (values nil nil))

; make-instances-obsolete - mark class instances obsolete (stub)
(defun make-instances-obsolete (class)
  "Make instances of CLASS obsolete"
  class)

; make-load-form - make form to reconstruct object (stub)
(defun make-load-form (object &optional environment)
  "Return forms to reconstruct OBJECT"
  (declare (ignore environment))
  `(error "Cannot reconstruct ~A" ,object))

; make-load-form-saving-slots - make form saving slots (stub)
(defun make-load-form-saving-slots (object &key slot-names environment)
  "Return forms to reconstruct OBJECT saving slots"
  (declare (ignore slot-names environment))
  `(error "Cannot reconstruct ~A" ,object))

; no-applicable-method - called when no methods apply (stub)
(defun no-applicable-method (gf &rest args)
  "Called when no methods are applicable"
  (declare (ignore args))
  (error "No applicable method for ~A" gf))

; no-next-method - called when no next method (stub)
(defun no-next-method (gf method &rest args)
  "Called when there is no next method"
  (declare (ignore method args))
  (error "No next method for ~A" gf))

; shared-initialize - initialize shared slots (stub)
(defun shared-initialize (instance slot-names &rest initargs)
  "Initialize the shared slots of INSTANCE"
  (declare (ignore slot-names initargs))
  instance)

; slot-missing - called when slot is missing (stub)
(defun slot-missing (class object slot-name operation &optional new-value)
  "Called when a slot is missing"
  (declare (ignore class object operation new-value))
  (error "Missing slot ~A" slot-name))

; slot-unbound - called when slot is unbound (stub)
(defun slot-unbound (class instance slot-name)
  "Called when a slot is unbound"
  (declare (ignore class instance))
  (error "Unbound slot ~A" slot-name))

; update-instance-for-redefined-class - update after redef (stub)
(defun update-instance-for-redefined-class (instance added-slots discarded-slots property-list &rest initargs)
  "Update INSTANCE after its class is redefined"
  (declare (ignore added-slots discarded-slots property-list initargs))
  instance)

; subtypep is now a primitive

; define-compiler-macro - define compiler macro (stub)
(defmacro define-compiler-macro (name lambda-list &body body)
  "Define a compiler macro (not implemented)"
  (declare (ignore lambda-list body))
  `',name)

; define-method-combination - define method combination (stub)
(defmacro define-method-combination (name &rest options)
  "Define a method combination (not implemented)"
  (declare (ignore options))
  `',name)

; define-setf-expander - define setf expansion (stub)
(defmacro define-setf-expander (access-fn lambda-list &body body)
  "Define a setf expander (not implemented)"
  (declare (ignore lambda-list body))
  `',access-fn)

; define-symbol-macro - define symbol macro (stub)
(defmacro define-symbol-macro (symbol expansion)
  "Define a symbol macro (not implemented)"
  (declare (ignore expansion))
  `',symbol)

; pprint-exit-if-list-exhausted - exit pprint block (stub)
(defmacro pprint-exit-if-list-exhausted ()
  "Exit if list is exhausted in pprint-logical-block"
  nil)

; pprint-logical-block - logical block for pprint (stub)
; pprint-logical-block and pprint-pop defined earlier

; restart-bind - bind restart handlers (stub)
(defmacro restart-bind (bindings &body body)
  "Establish restart bindings"
  (declare (ignore bindings))
  `(progn ,@body))

(in-package "CL-USER")
