;;; Habu Compiler - S-expression to IR
;;;
;;; Compiles Habu source code (S-expressions) to IR nodes.
;;; Uses the IR ADT defined in ir.habu.

(load "lib/ir.habu")

;; =============================================================================
;; Environment
;; =============================================================================

;; An environment is (bindings . next-index)
;; bindings is a list of (name depth index)
;; next-index is the next available local index
;; depth=0 means current function, depth>0 means enclosing function

(defun empty-env ()
  "Create empty environment"
  (cons nil 0))

(defun env-bindings (env)
  "Get bindings list from environment"
  (car env))

(defun env-next-index (env)
  "Get next available index"
  (cdr env))

(defun env-extend (env names)
  "Extend environment with new bindings at current depth.
   Returns updated environment."
  (let ((start-idx (env-next-index env)))
    (let ((new-bindings (make-bindings names 0 start-idx (env-bindings env))))
      (cons new-bindings (+ start-idx (length names))))))

(defun make-bindings (names depth start-idx existing)
  "Create bindings and prepend to existing list"
  (make-bindings-helper names depth start-idx existing))

(defun make-bindings-helper (names depth idx existing)
  "Helper: create binding for each name at consecutive indices"
  (if (null names)
      existing
      (cons (list (car names) depth idx)
            (make-bindings-helper (cdr names) depth (+ idx 1) existing))))

(defun env-push-scope (env)
  "Push a new function scope - resets indices, increments depth of existing"
  (let ((shifted (shift-depth (env-bindings env))))
    (cons shifted 0)))

(defun shift-depth (bindings)
  "Increment depth of all bindings"
  (if (null bindings)
      nil
      (let ((b (car bindings)))
        (cons (list (car b) (+ (car (cdr b)) 1) (car (cdr (cdr b))))
              (shift-depth (cdr bindings))))))

(defun env-lookup (env name)
  "Look up name in environment, return (depth . index) or nil"
  (lookup-in-bindings (env-bindings env) name))

(defun lookup-in-bindings (bindings name)
  "Search bindings for name"
  (if (null bindings)
      nil
      (let ((b (car bindings)))
        (if (eq (car b) name)
            (cons (car (cdr b)) (car (cdr (cdr b))))
            (lookup-in-bindings (cdr bindings) name)))))

;; =============================================================================
;; Capture Analysis
;; =============================================================================

;; Captures are collected as (name depth index) triples
;; where depth/index refer to the variable in the ENCLOSING scope

(defun collect-free-vars (expr env captures)
  "Collect free variables in expr. Returns updated captures list."
  (cond
    ;; Literals have no free variables
    ((null expr) captures)
    ((eq expr t) captures)
    ((numberp expr) captures)
    ((stringp expr) captures)
    ((keywordp expr) captures)

    ;; Symbol - check if free variable
    ((symbolp expr)
     (collect-free-var-symbol expr env captures))

    ;; List - special form or function call
    ((consp expr)
     (collect-free-vars-form expr env captures))

    ;; Unknown
    (t captures)))

(defun collect-free-var-symbol (name env captures)
  "Check if symbol is a free variable needing capture"
  (let ((binding (env-lookup env name)))
    (if binding
        (let ((depth (car binding))
              (index (cdr binding)))
          (if (> depth 0)
              ;; Found in outer scope - needs capture
              (add-capture captures name depth index)
              ;; Local variable - no capture needed
              captures))
        ;; Not found - global, no capture
        captures)))

(defun add-capture (captures name depth index)
  "Add capture if not already present"
  (if (capture-exists captures name)
      captures
      (cons (make-capture name depth index) captures)))

(defun capture-exists (captures name)
  "Check if name is already in captures"
  (if (null captures)
      nil
      (if (eq (capture-name (car captures)) name)
          t
          (capture-exists (cdr captures) name))))

(defun collect-free-vars-form (expr env captures)
  "Collect free vars in a list form (special form or call)"
  (let ((head (car expr))
        (tail (cdr expr)))
    (cond
      ;; Quote - no free variables in quoted data
      ((eq head 'quote) captures)

      ;; Lambda/fn - creates new scope, skip (handled by compile-lambda)
      ((eq head 'lambda) captures)
      ((eq head 'fn) captures)

      ;; Let - bindings shadow, then check body
      ((eq head 'let)
       (collect-free-vars-let tail env captures))

      ;; Let* - sequential bindings
      ((eq head 'let*)
       (collect-free-vars-let* tail env captures))

      ;; Defun - like lambda, creates new scope
      ((eq head 'defun) captures)

      ;; Other special forms and calls - check all subexpressions
      (t (collect-free-vars-list (cons head tail) env captures)))))

(defun collect-free-vars-let (args env captures)
  "Handle let: check values in current env, body with extended env"
  (let ((bindings (car args))
        (body (cdr args)))
    (let ((names (extract-binding-names bindings))
          (values (extract-binding-values bindings)))
      ;; Check values in current env
      (let ((caps1 (collect-free-vars-list values env captures)))
        ;; Check body with extended env (bindings shadow)
        (let ((new-env (env-extend env names)))
          (collect-free-vars-list body new-env caps1))))))

(defun collect-free-vars-let* (args env captures)
  "Handle let*: sequential extension"
  (let ((bindings (car args))
        (body (cdr args)))
    (if (null bindings)
        (collect-free-vars-list body env captures)
        (let ((first-binding (car bindings))
              (rest-bindings (cdr bindings)))
          (let ((name (car first-binding))
                (value (car (cdr first-binding))))
            ;; Check value in current env
            (let ((caps1 (collect-free-vars value env captures)))
              ;; Extend env and continue
              (let ((new-env (env-extend env (list name))))
                (collect-free-vars-let* (cons rest-bindings body) new-env caps1))))))))

(defun extract-binding-values (bindings)
  "Extract value expressions from let bindings"
  (if (null bindings)
      nil
      (cons (car (cdr (car bindings)))
            (extract-binding-values (cdr bindings)))))

(defun collect-free-vars-list (exprs env captures)
  "Collect free vars in a list of expressions"
  (if (null exprs)
      captures
      (let ((caps1 (collect-free-vars (car exprs) env captures)))
        (collect-free-vars-list (cdr exprs) env caps1))))

;; =============================================================================
;; Global definitions table
;; =============================================================================

(defun make-globals ()
  "Create empty globals table"
  (make-hash-table))

(defun globals-define (globals name)
  "Define or get global index for name"
  (let ((existing (gethash name globals)))
    (if existing
        existing
        (let ((idx (hash-table-count globals)))
          (puthash name idx globals)
          idx))))

(defun globals-lookup (globals name)
  "Look up global, return index or nil"
  (gethash name globals))

;; =============================================================================
;; Compiler state
;; =============================================================================

;; Compiler state is a list: (globals . captures)
;; globals: hash table of name -> index
;; captures: list of captured variables (for current lambda)

(defun make-compiler-state ()
  (cons (make-globals) nil))

(defun state-globals (state)
  (car state))

(defun state-captures (state)
  (cdr state))

;; =============================================================================
;; Main compile function
;; =============================================================================

(defun compile-expr (expr env state)
  "Compile expression to IR"
  (cond
    ;; Self-evaluating
    ((null expr) (ir-lit nil))
    ((eq expr t) (ir-lit t))
    ((numberp expr) (ir-lit expr))
    ((stringp expr) (ir-lit expr))
    ((keywordp expr) (ir-lit expr))

    ;; Symbol - variable reference
    ((symbolp expr)
     (compile-variable expr env state))

    ;; List - special form or function call
    ((consp expr)
     (compile-list expr env state))

    ;; Unknown
    (t (error "Unknown expression type"))))

(defun compile-variable (name env state)
  "Compile variable reference"
  (let ((local (env-lookup env name)))
    (if local
        (ir-var name (car local) (cdr local))
        ;; Global - use late binding (define if not already defined)
        (let ((global-idx (globals-lookup (state-globals state) name)))
          (ir-global-ref name
            (if global-idx
                global-idx
                (globals-define (state-globals state) name)))))))

(defun compile-list (expr env state)
  "Compile list expression (special form or call)"
  (let ((head (car expr))
        (tail (cdr expr)))
    (cond
      ;; Quote
      ((eq head 'quote)
       (compile-quote (car tail)))

      ;; If
      ((eq head 'if)
       (compile-if tail env state))

      ;; Let
      ((eq head 'let)
       (compile-let tail env state))

      ;; Let*
      ((eq head 'let*)
       (compile-let* tail env state))

      ;; Lambda
      ((eq head 'lambda)
       (compile-lambda tail env state))

      ;; Progn
      ((eq head 'progn)
       (compile-progn tail env state))

      ;; Setq
      ((eq head 'setq)
       (compile-setq tail env state))

      ;; Defun
      ((eq head 'defun)
       (compile-defun tail env state))

      ;; Cond
      ((eq head 'cond)
       (compile-cond tail env state))

      ;; And
      ((eq head 'and)
       (compile-and tail env state))

      ;; Or
      ((eq head 'or)
       (compile-or tail env state))

      ;; Function call
      (t (compile-call expr env state)))))

;; =============================================================================
;; Special form compilers
;; =============================================================================

(defun compile-quote (datum)
  "Compile quoted expression"
  (if (symbolp datum)
      (ir-quote-sym datum)
      (ir-lit datum)))

(defun compile-if (args env state)
  "Compile (if cond then else)"
  (let ((cond-ir (compile-expr (car args) env state))
        (then-ir (compile-expr (car (cdr args)) env state))
        (else-ir (if (cdr (cdr args))
                     (compile-expr (car (cdr (cdr args))) env state)
                     (ir-lit nil))))
    (ir-if cond-ir then-ir else-ir)))

(defun compile-let (args env state)
  "Compile (let ((x e1) (y e2)) body)"
  (let ((bindings (car args))
        (body (cdr args)))
    (let ((names (extract-binding-names bindings))
          (values (compile-binding-values bindings env state)))
      (let ((new-env (env-extend env names))
            (binding-pairs (make-let-bindings names values 0)))
        (ir-let binding-pairs
                (compile-progn body new-env state))))))

(defun extract-binding-names (bindings)
  "Extract list of names from let bindings"
  (if (null bindings)
      nil
      (cons (car (car bindings))
            (extract-binding-names (cdr bindings)))))

(defun compile-binding-values (bindings env state)
  "Compile list of binding values to IR nodes"
  (if (null bindings)
      nil
      (cons (compile-expr (car (cdr (car bindings))) env state)
            (compile-binding-values (cdr bindings) env state))))

(defun make-let-bindings (names values index)
  "Create list of (name . ir) pairs"
  (if (null names)
      nil
      (cons (make-binding (car names) (car values))
            (make-let-bindings (cdr names) (cdr values) (+ index 1)))))

(defun compile-let* (args env state)
  "Compile (let* ((x e1) (y e2)) body) as nested lets"
  (let ((bindings (car args))
        (body (cdr args)))
    (if (null bindings)
        (compile-progn body env state)
        (let ((first-binding (car bindings))
              (rest-bindings (cdr bindings)))
          (compile-let (list (list first-binding)
                            (cons 'let* (cons rest-bindings body)))
                      env state)))))

(defun compile-lambda (args env state)
  "Compile (lambda (params) body)"
  (let ((params (car args))
        (body (cdr args)))
    (let ((param-names (extract-params params))
          (rest-param (extract-rest-param params)))
      ;; Push new function scope (resets indices, shifts existing bindings up)
      (let ((lambda-env (env-push-scope env)))
        ;; Add params as locals at indices 0, 1, ...
        (let ((new-env (env-extend lambda-env param-names)))
          ;; Capture analysis: find free variables in body
          (let ((captures (collect-free-vars-list body new-env nil)))
            (ir-lambda param-names rest-param captures
                       (compile-progn body new-env state))))))))

(defun extract-params (params)
  "Extract parameter names from lambda list"
  (if (null params)
      nil
      (if (symbolp params)  ; rest param only: (lambda x ...)
          nil
          (if (consp params)
              (cons (car params) (extract-params (cdr params)))
              nil))))  ; dotted rest param

(defun extract-rest-param (params)
  "Extract rest parameter if present"
  (if (null params)
      nil
      (if (symbolp params)  ; (lambda x ...) - x is rest
          params
          (if (consp params)
              (extract-rest-param (cdr params))
              params))))  ; dotted pair - cdr is rest

(defun compile-progn (forms env state)
  "Compile (progn e1 e2 ... en)"
  (if (null forms)
      (ir-lit nil)
      (if (null (cdr forms))
          (compile-expr (car forms) env state)
          (ir-progn (compile-forms forms env state)))))

(defun compile-forms (forms env state)
  "Compile list of forms to list of IR nodes"
  (if (null forms)
      nil
      (cons (compile-expr (car forms) env state)
            (compile-forms (cdr forms) env state))))

(defun compile-setq (args env state)
  "Compile (setq name value)"
  (let ((name (car args))
        (value-expr (car (cdr args))))
    (let ((local (env-lookup env name))
          (value-ir (compile-expr value-expr env state)))
      (if local
          (ir-set name (car local) (cdr local) value-ir)
          (let ((idx (globals-define (state-globals state) name)))
            (ir-define name idx value-ir))))))

(defun compile-defun (args env state)
  "Compile (defun name (params) body)"
  (let ((name (car args))
        (params (car (cdr args)))
        (body (cdr (cdr args))))
    (let ((lambda-ir (compile-lambda (cons params body) env state))
          (idx (globals-define (state-globals state) name)))
      (ir-define name idx lambda-ir))))

(defun compile-cond (clauses env state)
  "Compile (cond (test1 e1) (test2 e2) ...)"
  (if (null clauses)
      (ir-lit nil)
      (let ((clause (car clauses))
            (rest (cdr clauses)))
        (let ((test (car clause))
              (body (cdr clause)))
          (if (eq test t)
              (compile-progn body env state)
              (ir-if (compile-expr test env state)
                     (compile-progn body env state)
                     (compile-cond rest env state)))))))

(defun compile-and (forms env state)
  "Compile (and e1 e2 ...)"
  (if (null forms)
      (ir-lit t)
      (if (null (cdr forms))
          (compile-expr (car forms) env state)
          (ir-if (compile-expr (car forms) env state)
                 (compile-and (cdr forms) env state)
                 (ir-lit nil)))))

(defun compile-or (forms env state)
  "Compile (or e1 e2 ...)"
  (if (null forms)
      (ir-lit nil)
      (if (null (cdr forms))
          (compile-expr (car forms) env state)
          ;; Need let to avoid evaluating first expr twice
          ;; For now, just inline (loses short-circuit for complex exprs)
          (ir-if (compile-expr (car forms) env state)
                 (compile-expr (car forms) env state)  ; TODO: use temp var
                 (compile-or (cdr forms) env state)))))

(defun compile-call (expr env state)
  "Compile function call (f arg1 arg2 ...)"
  (let ((func (car expr))
        (args (cdr expr)))
    ;; Check for builtins first
    (if (symbolp func)
        (compile-builtin-or-call func args env state)
        ;; Non-symbol function (lambda, funcall, etc)
        (let ((func-ir (compile-expr func env state))
              (args-ir (compile-args args env state)))
          (ir-call func-ir args-ir)))))

(defun compile-builtin-or-call (func args env state)
  "Try to compile as builtin, otherwise as regular call"
  (let ((nargs (length args)))
    (cond
      ;; Binary arithmetic
      ((and (eq func '+) (= nargs 2))
       (ir-add (compile-expr (car args) env state)
               (compile-expr (car (cdr args)) env state)))
      ((and (eq func '-) (= nargs 2))
       (ir-sub (compile-expr (car args) env state)
               (compile-expr (car (cdr args)) env state)))
      ((and (eq func '*) (= nargs 2))
       (ir-mul (compile-expr (car args) env state)
               (compile-expr (car (cdr args)) env state)))
      ((and (eq func '/) (= nargs 2))
       (ir-div (compile-expr (car args) env state)
               (compile-expr (car (cdr args)) env state)))
      ((and (eq func 'mod) (= nargs 2))
       (ir-mod (compile-expr (car args) env state)
               (compile-expr (car (cdr args)) env state)))

      ;; Comparison
      ((and (eq func 'eq) (= nargs 2))
       (ir-eq (compile-expr (car args) env state)
              (compile-expr (car (cdr args)) env state)))
      ((and (eq func '<) (= nargs 2))
       (ir-lt (compile-expr (car args) env state)
              (compile-expr (car (cdr args)) env state)))
      ((and (eq func '>) (= nargs 2))
       (ir-gt (compile-expr (car args) env state)
              (compile-expr (car (cdr args)) env state)))
      ((and (eq func '<=) (= nargs 2))
       (ir-le (compile-expr (car args) env state)
              (compile-expr (car (cdr args)) env state)))
      ((and (eq func '>=) (= nargs 2))
       (ir-ge (compile-expr (car args) env state)
              (compile-expr (car (cdr args)) env state)))
      ((and (eq func '=) (= nargs 2))
       (ir-num-eq (compile-expr (car args) env state)
                  (compile-expr (car (cdr args)) env state)))
      ((and (eq func 'equal) (= nargs 2))
       (ir-equal (compile-expr (car args) env state)
                 (compile-expr (car (cdr args)) env state)))

      ;; Unary ops
      ((and (eq func 'not) (= nargs 1))
       (ir-not (compile-expr (car args) env state)))
      ((and (eq func 'null) (= nargs 1))
       (ir-nilp (compile-expr (car args) env state)))

      ;; List operations
      ((and (eq func 'cons) (= nargs 2))
       (ir-cons (compile-expr (car args) env state)
                (compile-expr (car (cdr args)) env state)))
      ((and (eq func 'car) (= nargs 1))
       (ir-car (compile-expr (car args) env state)))
      ((and (eq func 'cdr) (= nargs 1))
       (ir-cdr (compile-expr (car args) env state)))
      ((eq func 'list)
       (ir-list (compile-args args env state)))
      ((and (eq func 'append) (= nargs 2))
       (ir-append (compile-expr (car args) env state)
                  (compile-expr (car (cdr args)) env state)))
      ((and (eq func 'length) (= nargs 1))
       (ir-length (compile-expr (car args) env state)))
      ((and (eq func 'reverse) (= nargs 1))
       (ir-reverse (compile-expr (car args) env state)))
      ((and (eq func 'rplaca) (= nargs 2))
       (ir-rplaca (compile-expr (car args) env state)
                  (compile-expr (car (cdr args)) env state)))
      ((and (eq func 'rplacd) (= nargs 2))
       (ir-rplacd (compile-expr (car args) env state)
                  (compile-expr (car (cdr args)) env state)))

      ;; Type predicates
      ((and (eq func 'consp) (= nargs 1))
       (ir-consp (compile-expr (car args) env state)))
      ((and (eq func 'symbolp) (= nargs 1))
       (ir-symbolp (compile-expr (car args) env state)))
      ((and (eq func 'numberp) (= nargs 1))
       (ir-numberp (compile-expr (car args) env state)))
      ((and (eq func 'stringp) (= nargs 1))
       (ir-stringp (compile-expr (car args) env state)))
      ((and (eq func 'vectorp) (= nargs 1))
       (ir-vectorp (compile-expr (car args) env state)))
      ((and (eq func 'atom) (= nargs 1))
       (ir-atom (compile-expr (car args) env state)))
      ((and (eq func 'listp) (= nargs 1))
       (ir-listp (compile-expr (car args) env state)))

      ;; More list operations
      ((and (eq func 'nth) (= nargs 2))
       (ir-nth (compile-expr (car args) env state)
               (compile-expr (car (cdr args)) env state)))
      ((and (eq func 'member) (= nargs 2))
       (ir-member (compile-expr (car args) env state)
                  (compile-expr (car (cdr args)) env state)))
      ((and (eq func 'assoc) (= nargs 2))
       (ir-assoc (compile-expr (car args) env state)
                 (compile-expr (car (cdr args)) env state)))

      ;; Symbol operations
      ((and (eq func 'gensym) (= nargs 0))
       (ir-gensym))
      ((and (eq func 'intern) (= nargs 1))
       (ir-intern (compile-expr (car args) env state)))
      ((and (eq func 'symbol-name) (= nargs 1))
       (ir-sym-name (compile-expr (car args) env state)))

      ;; Vector operations
      ((and (eq func 'make-vector) (= nargs 2))
       (ir-make-vec (compile-expr (car args) env state)
                    (compile-expr (car (cdr args)) env state)))
      ((and (eq func 'vector-ref) (= nargs 2))
       (ir-vec-ref (compile-expr (car args) env state)
                   (compile-expr (car (cdr args)) env state)))
      ((and (eq func 'vector-set!) (= nargs 3))
       (ir-vec-set (compile-expr (car args) env state)
                   (compile-expr (car (cdr args)) env state)
                   (compile-expr (car (cdr (cdr args))) env state)))
      ((and (eq func 'vector-length) (= nargs 1))
       (ir-vec-len (compile-expr (car args) env state)))

      ;; String operations
      ((and (eq func 'string-ref) (= nargs 2))
       (ir-str-ref (compile-expr (car args) env state)
                   (compile-expr (car (cdr args)) env state)))
      ((and (eq func 'string-length) (= nargs 1))
       (ir-str-len (compile-expr (car args) env state)))
      ((and (eq func 'string=) (= nargs 2))
       (ir-str-eq (compile-expr (car args) env state)
                  (compile-expr (car (cdr args)) env state)))

      ;; I/O
      ((and (eq func 'print) (= nargs 1))
       (ir-print (compile-expr (car args) env state)))
      ((and (eq func 'princ) (= nargs 1))
       (ir-princ (compile-expr (car args) env state)))
      ((and (eq func 'terpri) (= nargs 0))
       (ir-terpri))
      ((and (eq func 'read) (= nargs 0))
       (ir-read))
      ((and (eq func 'read-char) (= nargs 0))
       (ir-read-char))
      ((and (eq func 'error) (= nargs 1))
       (ir-error (compile-expr (car args) env state)))

      ;; Default: regular function call
      (t
       (let ((func-ir (compile-expr func env state))
             (args-ir (compile-args args env state)))
         (ir-call func-ir args-ir))))))

(defun compile-args (args env state)
  "Compile list of arguments to list of IR nodes"
  (if (null args)
      nil
      (cons (compile-expr (car args) env state)
            (compile-args (cdr args) env state))))

;; =============================================================================
;; Top-level interface
;; =============================================================================

(defun compile-top (expr)
  "Compile a top-level expression"
  (let ((state (make-compiler-state)))
    (compile-expr expr (empty-env) state)))
