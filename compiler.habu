;; compiler.habu - S-expression to IR compiler for Habu
;; Compiles Habu source to IR nodes defined in ir.habu

(load "stdlib.habu")
(load "ir.habu")

;; ============================================================================
;; Environment - tracks lexical bindings
;; ============================================================================

;; Environment entry: (name . (depth . index))
(defun env-empty () nil)

(defun env-lookup (env name)
  "Look up a variable in the environment, returns (depth . index) or nil"
  (if (null env)
      nil
      (let ((entry (car env)))
        (if (eq (car entry) name)
            (cdr entry)
            (env-lookup (cdr env) name)))))

(defun env-bind (env name depth index)
  "Add a binding to the environment"
  (cons (cons name (cons depth index)) env))

(defun env-extend (env names depth)
  "Extend environment with a list of names at given depth"
  (env-extend-aux env names depth 0))

(defun env-extend-aux (env names depth index)
  (if (null names)
      env
      (env-extend-aux
        (env-bind env (car names) depth index)
        (cdr names)
        depth
        (+ index 1))))

;; ============================================================================
;; Global definitions tracking
;; ============================================================================

(defvar *globals* nil)
(defvar *global-count* 0)

(defun globals-reset ()
  (setq *globals* nil)
  (setq *global-count* 0))

(defun globals-lookup (name)
  "Returns index or nil"
  (globals-lookup-aux *globals* name))

(defun globals-lookup-aux (lst name)
  (if (null lst)
      nil
      (if (eq (car (car lst)) name)
          (cdr (car lst))
          (globals-lookup-aux (cdr lst) name))))

(defun globals-define (name)
  "Define a global, returns its index"
  (let ((existing (globals-lookup name)))
    (if existing
        existing
        (let ((idx *global-count*))
          (setq *globals* (cons (cons name idx) *globals*))
          (setq *global-count* (+ *global-count* 1))
          idx))))

;; ============================================================================
;; Compiler - main entry point
;; ============================================================================

(defun compile-expr (expr env depth)
  "Compile an expression to IR"
  (cond
    ;; nil
    ((null expr) (ir-nil))

    ;; t (the symbol, not just any truthy value)
    ((eq expr t) (ir-t))

    ;; Numbers
    ((numberp expr) (ir-fixnum expr))

    ;; Symbols - variable references
    ((symbolp expr)
     (compile-variable expr env depth))

    ;; Lists - special forms or function calls
    ((consp expr)
     (compile-list expr env depth))

    ;; Anything else is an error
    (t (error "Unknown expression type"))))

(defun compile-variable (name env depth)
  "Compile a variable reference"
  (let ((binding (env-lookup env name)))
    (if binding
        ;; Local variable
        (ir-var name (- depth (car binding)) (cdr binding))
        ;; Global variable
        (let ((idx (globals-define name)))
          (ir-global-ref name idx)))))

(defun compile-list (expr env depth)
  "Compile a list expression (special form or call)"
  (let ((head (car expr))
        (args (cdr expr)))
    (case head
      ;; Special forms
      (quote  (compile-quote (car args)))
      (if     (compile-if args env depth))
      (let    (compile-let args env depth))
      (lambda (compile-lambda args env depth))
      (progn  (compile-progn args env depth))
      (setq   (compile-setq args env depth))
      (defun  (compile-defun args env depth))
      (defvar (compile-defvar args env depth))

      ;; Binary primitives
      (+    (compile-binop ir-add args env depth))
      (-    (compile-binop ir-sub args env depth))
      (*    (compile-binop ir-mul args env depth))
      (/    (compile-binop ir-div args env depth))
      (mod  (compile-binop ir-mod args env depth))
      (eq   (compile-binop ir-eq args env depth))
      (<    (compile-binop ir-lt args env depth))
      (>    (compile-binop ir-gt args env depth))
      (<=   (compile-binop ir-le args env depth))
      (>=   (compile-binop ir-ge args env depth))
      (=    (compile-binop ir-num-eq args env depth))
      (cons (compile-binop ir-cons args env depth))

      ;; Unary primitives
      (car     (compile-unop ir-car args env depth))
      (cdr     (compile-unop ir-cdr args env depth))
      (consp   (compile-unop ir-consp args env depth))
      (symbolp (compile-unop ir-symbolp args env depth))
      (numberp (compile-unop ir-numberp args env depth))
      (null    (compile-unop ir-nilp args env depth))
      (not     (compile-unop ir-not args env depth))
      (print   (compile-unop ir-print args env depth))

      ;; Function call
      (t (compile-call expr env depth)))))

;; ============================================================================
;; Special forms
;; ============================================================================

(defun compile-quote (expr)
  "Compile quoted expression"
  (if (symbolp expr)
      (ir-quote-sym (symbol-name expr))
      (ir-lit expr)))  ; For now, just return literal

(defun compile-if (args env depth)
  "Compile if expression"
  (let ((cond-expr (car args))
        (then-expr (cadr args))
        (else-expr (if (cddr args) (caddr args) nil)))
    (ir-if (compile-expr cond-expr env depth)
           (compile-expr then-expr env depth)
           (compile-expr else-expr env depth))))

(defun compile-let (args env depth)
  "Compile let expression"
  (let ((bindings (car args))
        (body (cdr args)))
    (let ((names (mapcar car bindings))
          (values (mapcar cadr bindings)))
      (let ((new-env (env-extend env names depth))
            (ir-bindings (compile-let-bindings names values env depth)))
        (ir-let ir-bindings
                (compile-progn body new-env depth))))))

(defun compile-let-bindings (names values env depth)
  "Compile let bindings to list of binding nodes"
  (if (null names)
      nil
      (cons (make-binding (car names)
                          (compile-expr (car values) env depth))
            (compile-let-bindings (cdr names) (cdr values) env depth))))

(defun compile-lambda (args env depth)
  "Compile lambda expression"
  (let ((params (car args))
        (body (cdr args)))
    (let ((param-names (lambda-param-names params))
          (new-depth (+ depth 1)))
      (let ((new-env (env-extend env param-names new-depth)))
        (ir-lambda param-names
                   nil  ; opt-params (TODO)
                   nil  ; key-params (TODO)
                   nil  ; rest-param (TODO)
                   nil  ; captures (TODO: analyze free variables)
                   (compile-progn body new-env new-depth))))))

(defun lambda-param-names (params)
  "Extract parameter names from lambda list"
  (if (null params)
      nil
      (if (symbolp params)
          (list params)  ; rest param as single symbol
          (cons (car params)
                (lambda-param-names (cdr params))))))

(defun compile-progn (exprs env depth)
  "Compile progn/sequence"
  (if (null exprs)
      (ir-nil)
      (if (null (cdr exprs))
          (compile-expr (car exprs) env depth)
          (ir-progn (compile-expr-list exprs env depth)))))

(defun compile-expr-list (exprs env depth)
  "Compile a list of expressions"
  (if (null exprs)
      nil
      (cons (compile-expr (car exprs) env depth)
            (compile-expr-list (cdr exprs) env depth))))

(defun compile-setq (args env depth)
  "Compile setq"
  (let ((name (car args))
        (value (cadr args)))
    (let ((binding (env-lookup env name)))
      (if binding
          (ir-set name (- depth (car binding)) (cdr binding)
                  (compile-expr value env depth))
          (let ((idx (globals-define name)))
            (ir-define name idx (compile-expr value env depth)))))))

(defun compile-defun (args env depth)
  "Compile defun"
  (let ((name (car args))
        (params (cadr args))
        (body (cddr args)))
    (let ((idx (globals-define name))
          (lambda-ir (compile-lambda (cons params body) env depth)))
      (ir-define name idx lambda-ir))))

(defun compile-defvar (args env depth)
  "Compile defvar"
  (let ((name (car args))
        (value (if (cdr args) (cadr args) nil)))
    (let ((idx (globals-define name)))
      (ir-define name idx (compile-expr value env depth)))))

;; ============================================================================
;; Primitives
;; ============================================================================

(defun compile-binop (constructor args env depth)
  "Compile binary operation"
  (let ((left (compile-expr (car args) env depth))
        (right (compile-expr (cadr args) env depth)))
    (funcall constructor left right)))

(defun compile-unop (constructor args env depth)
  "Compile unary operation"
  (let ((operand (compile-expr (car args) env depth)))
    (funcall constructor operand)))

;; ============================================================================
;; Function calls
;; ============================================================================

(defun compile-call (expr env depth)
  "Compile function call"
  (let ((func (car expr))
        (args (cdr expr)))
    (ir-call (compile-expr func env depth)
             (compile-expr-list args env depth))))

;; ============================================================================
;; Top-level compilation
;; ============================================================================

(defun compile-top (expr)
  "Compile a top-level expression"
  (globals-reset)
  (compile-expr expr (env-empty) 0))

;; ============================================================================
;; Tests
;; ============================================================================

(defun test-compile ()
  (progn
    (print "Testing compiler...")

    ;; Test literal
    (print "Literal:")
    (print (ir-lit-value (compile-top 42)))

    ;; Test arithmetic
    (print "Arithmetic (+ 1 2):")
    (let ((ir (compile-top '(+ 1 2))))
      (print (ir-add? ir))
      (print (ir-lit-value (ir-add-left ir)))
      (print (ir-lit-value (ir-add-right ir))))

    ;; Test if
    (print "If:")
    (let ((ir (compile-top '(if t 1 2))))
      (print (ir-if? ir)))

    ;; Test let
    (print "Let:")
    (let ((ir (compile-top '(let ((x 1)) x))))
      (print (ir-let? ir)))

    ;; Test lambda
    (print "Lambda:")
    (let ((ir (compile-top '(lambda (x) x))))
      (print (ir-lambda? ir)))

    t))
