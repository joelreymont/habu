;; reader.habu - S-expression reader in Habu
;; Single function dispatcher approach to avoid forward reference issues
(defun char-whitespace? (c) (if (= c 32) t (if (= c 10) t (if (= c 13) t (= c 9)))))
(defun char-digit? (c) (if (>= c 48) (<= c 57) nil))
(defun char-upper? (c) (if (>= c 65) (<= c 90) nil))
(defun char-lower? (c) (if (>= c 97) (<= c 122) nil))
(defun char-alpha? (c) (if (char-upper? c) t (char-lower? c)))
(defun char-symbol-extra? (c) (if (= c 45) t (if (= c 95) t (if (= c 43) t (if (= c 42) t (if (= c 47) t (if (= c 60) t (if (= c 62) t (if (= c 61) t (if (= c 63) t (= c 33)))))))))))
(defun char-symbol? (c) (if (char-alpha? c) t (if (char-digit? c) t (char-symbol-extra? c))))
(defun skip-ws-loop (s pos len) (if (>= pos len) pos (let ((c (string-ref s pos))) (if (char-whitespace? c) (skip-ws-loop s (+ pos 1) len) pos))))
(defun read-int-loop (s pos len neg acc) (if (>= pos len) (cons (if neg (- 0 acc) acc) pos) (let ((c (string-ref s pos))) (if (char-digit? c) (read-int-loop s (+ pos 1) len neg (+ (* acc 10) (- c 48))) (cons (if neg (- 0 acc) acc) pos)))))
(defun read-sym-end (s pos len) (if (>= pos len) pos (let ((c (string-ref s pos))) (if (char-symbol? c) (read-sym-end s (+ pos 1) len) pos))))
(defun reader (s pos len mode acc) (if (= mode 0) (let ((pos2 (skip-ws-loop s pos len))) (if (>= pos2 len) (cons nil pos2) (let ((c (string-ref s pos2))) (if (= c 40) (reader s (+ pos2 1) len 1 nil) (if (= c 39) (let ((r (reader s (+ pos2 1) len 0 nil))) (cons (list2 (intern "quote") (car r)) (cdr r))) (if (= c 45) (let ((c2 (if (< (+ pos2 1) len) (string-ref s (+ pos2 1)) 0))) (if (char-digit? c2) (read-int-loop s (+ pos2 1) len t 0) (let ((end (read-sym-end s pos2 len))) (cons (intern (substring s pos2 end)) end)))) (if (char-digit? c) (read-int-loop s pos2 len nil 0) (let ((end (read-sym-end s pos2 len))) (cons (intern (substring s pos2 end)) end))))))))) (let ((pos2 (skip-ws-loop s pos len))) (if (>= pos2 len) (cons (reverse acc) pos2) (let ((c (string-ref s pos2))) (if (= c 41) (cons (reverse acc) (+ pos2 1)) (let ((r (reader s pos2 len 0 nil))) (reader s (cdr r) len 1 (cons (car r) acc)))))))))
(defun read-string (s) (car (reader s 0 (string-length s) 0 nil)))
(defun test-reader () (progn (print (read-string "42")) (print (read-string "-17")) (print (read-string "hello")) (print (read-string "(+ 1 2)")) (print (read-string "(defun f (x) (+ x 1))")) (print (read-string "'foo")) t))
