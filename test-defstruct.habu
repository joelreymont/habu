;; Test DEFSTRUCT functionality
(print "=== Testing DEFSTRUCT ===")

;; Test 1: Basic struct definition
(print "\n1. Basic Struct:")
(defstruct person name age)

(define alice (make-person "Alice" 30))
(if (person-p alice)
    (print "✓ person-p works")
    (print "✗ FAIL: person-p broken"))

(print "Name:")
(print (person-name alice))
(print "Age:")
(print (person-age alice))

;; Test 2: Struct with multiple fields
(print "\n2. Point Struct:")
(defstruct point x y z)

(define p (make-point 10 20 30))
(if (and (= (point-x p) 10) 
         (= (point-y p) 20) 
         (= (point-z p) 30))
    (print "✓ accessors work correctly")
    (print "✗ FAIL: accessor values incorrect"))

;; Test 3: Struct as function argument
(print "\n3. Struct as Argument:")
(defun distance-squared (pt)
  (let ((x (point-x pt))
        (y (point-y pt))
        (z (point-z pt)))
    (+ (* x x) (* y y) (* z z))))

(print "Distance squared:")
(print (distance-squared p))

;; Test 4: Struct in list
(print "\n4. Structs in Lists:")
(defstruct color r g b)

(define colors (list (make-color 255 0 0)
                     (make-color 0 255 0)
                     (make-color 0 0 255)))

(if (= (length colors) 3)
    (print "✓ can store structs in lists")
    (print "✗ FAIL: struct list broken"))

(print "Red component of first color:")
(print (color-r (car colors)))

(print "\n=== DEFSTRUCT tests completed! ===")
