#!/bin/bash
# habu-deliver - Create standalone executable from Lisp source
#
# Usage: habu-deliver <source.lisp> -o <output>
#
# Creates a standalone macOS executable.

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

# Parse arguments
SOURCE=""
OUTPUT=""
VERBOSE=0

while [ $# -gt 0 ]; do
    case "$1" in
        -o)
            OUTPUT="$2"
            shift 2
            ;;
        -v|--verbose)
            VERBOSE=1
            shift
            ;;
        -h|--help)
            echo "Usage: habu-deliver <source.lisp> -o <output>"
            echo ""
            echo "Creates a standalone macOS executable from Lisp source."
            echo ""
            echo "Options:"
            echo "  -o <output>       Output executable name (required)"
            echo "  -v, --verbose     Show compilation details"
            echo "  -h, --help        Show this help"
            exit 0
            ;;
        *)
            if [ -z "$SOURCE" ]; then
                SOURCE="$1"
            else
                echo "Error: Unknown argument: $1"
                exit 1
            fi
            shift
            ;;
    esac
done

if [ -z "$SOURCE" ]; then
    echo "Error: No source file specified"
    exit 1
fi

if [ -z "$OUTPUT" ]; then
    echo "Error: No output file specified (use -o)"
    exit 1
fi

if [ ! -f "$SOURCE" ]; then
    echo "Error: Source file not found: $SOURCE"
    exit 1
fi

# Temporary files
TMPDIR="${TMPDIR:-/tmp}"
CODE_BIN="$TMPDIR/habu-code-$$.bin"
GENERATED_C="$TMPDIR/habu-deliver-$$.c"

cleanup() {
    rm -f "$CODE_BIN" "$GENERATED_C"
}
trap cleanup EXIT

[ $VERBOSE -eq 1 ] && echo "[1/4] Compiling Lisp to ARM64..."

# Step 1: Compile to machine code
sbcl --noinform --non-interactive \
     --load sbcl-habu-shim.lisp \
     --load habu-arm64-codegen-sbcl.lisp \
     --load run-habu.lisp \
     --eval "(habu-sbcl:compile-forms-with-runtime (habu-sbcl:read-forms-from-file \"$SOURCE\") :output-path \"$CODE_BIN\")" \
     --eval '(sb-ext:quit)' 2>/dev/null

if [ ! -f "$CODE_BIN" ]; then
    echo "Error: Compilation failed"
    exit 1
fi

CODE_SIZE=$(stat -f%z "$CODE_BIN" 2>/dev/null || stat -c%s "$CODE_BIN" 2>/dev/null)
[ $VERBOSE -eq 1 ] && echo "    Generated $CODE_SIZE bytes"

[ $VERBOSE -eq 1 ] && echo "[2/4] Generating C source..."

# Step 2: Generate C source file
cat > "$GENERATED_C" << 'HEADER'
/* Habu standalone executable - generated */
#include <stdio.h>
#include <stdlib.h>
#include <stdint.h>
#include <string.h>
#include <sys/mman.h>
#include "runtime/habu.h"

static const unsigned char g_code[] = {
HEADER

# Add hex bytes (filter out empty lines that would create invalid "0x,")
od -An -tx1 -v "$CODE_BIN" | tr -s ' ' | sed 's/^ //' | sed 's/ $//' | grep -v '^$' | sed 's/ /, 0x/g' | sed 's/^/    0x/' | sed 's/$/,/' >> "$GENERATED_C"

cat >> "$GENERATED_C" << 'FOOTER'
};

static void* g_rt[64];

static void setup_rt(void *code) {
    g_rt[0] = (void*)habu_cons;
    g_rt[1] = (void*)habu_car;
    g_rt[2] = (void*)habu_cdr;
    g_rt[3] = (void*)habu_make_closure;
    g_rt[4] = (void*)habu_closure_code;
    g_rt[5] = (void*)habu_closure_env;
    g_rt[6] = code;
    g_rt[7] = (void*)habu_make_vector;
    g_rt[8] = (void*)habu_vector_set;
    g_rt[9] = (void*)habu_vector_ref;
    g_rt[10] = (void*)habu_make_string_from_vector;
    g_rt[11] = (void*)habu_make_symbol_from_string;
    g_rt[12] = (void*)habu_string_length_raw;
    g_rt[13] = (void*)habu_symbol_name;
    g_rt[14] = (void*)habu_set_car;
    g_rt[15] = (void*)habu_set_cdr;
    g_rt[16] = (void*)habu_string_ref;
    g_rt[17] = (void*)habu_values_set;
    g_rt[18] = (void*)habu_values_get;
    g_rt[19] = (void*)habu_make_hash_table;
    g_rt[20] = (void*)habu_gethash;
    g_rt[21] = (void*)habu_puthash;
    g_rt[22] = (void*)habu_remhash;
    g_rt[23] = (void*)habu_hash_table_count;
    g_rt[24] = (void*)habu_string_concat;
    g_rt[25] = (void*)habu_string_substring;
    g_rt[26] = (void*)habu_fixnum_to_string;
    g_rt[27] = (void*)habu_values_count_get;
    g_rt[28] = (void*)habu_gensym;
    g_rt[29] = (void*)habu_make_float;
    g_rt[30] = (void*)habu_float_add;
    g_rt[31] = (void*)habu_float_sub;
    g_rt[32] = (void*)habu_float_mul;
    g_rt[33] = (void*)habu_float_div;
    g_rt[34] = (void*)habu_float_lt;
    g_rt[35] = (void*)habu_float_gt;
    g_rt[36] = (void*)habu_float_le;
    g_rt[37] = (void*)habu_float_ge;
    g_rt[38] = (void*)habu_float_eq;
    g_rt[39] = (void*)habu_fixnum_to_float;
    g_rt[40] = (void*)habu_float_to_fixnum;
    g_rt[41] = (void*)habu_float_value;
    g_rt[42] = (void*)habu_open_file;
    g_rt[43] = (void*)habu_close_file;
    g_rt[44] = (void*)habu_read_line;
    g_rt[45] = (void*)habu_write_string;
    g_rt[46] = (void*)habu_read_file;
    g_rt[47] = (void*)habu_write_file;
    g_rt[48] = (void*)habu_print_value;
    g_rt[49] = (void*)habu_println_value;
    g_rt[50] = (void*)habu_get_time_ns;
}

int main(int argc, char **argv) {
    (void)argc; (void)argv;
    habu_init(4*1024*1024);
    habu_io_init();

    size_t sz = sizeof(g_code);
    size_t pg = 4096;
    size_t alloc = ((sz + pg - 1) / pg) * pg;

    void *mem = mmap(NULL, alloc, PROT_READ|PROT_WRITE, MAP_PRIVATE|MAP_ANONYMOUS, -1, 0);
    if (mem == MAP_FAILED) { perror("mmap"); return 1; }
    memcpy(mem, g_code, sz);
    if (mprotect(mem, alloc, PROT_READ|PROT_EXEC) != 0) { perror("mprotect"); return 1; }

    setup_rt(mem);

    typedef int64_t (*fn_t)(void**);
    int64_t r = ((fn_t)mem)(g_rt);

    munmap(mem, alloc);
    return ((r & 0xF) == 0) ? (int)(r >> 4) : 0;
}
FOOTER

[ $VERBOSE -eq 1 ] && echo "[3/4] Compiling executable..."

# Step 3: Compile
clang -O2 -o "$OUTPUT" \
    -I"$SCRIPT_DIR" \
    "$GENERATED_C" \
    runtime/gc.c runtime/io.c runtime/lineedit.c runtime/region.c runtime/runtime.c \
    -lm 2>&1

chmod +x "$OUTPUT"

[ $VERBOSE -eq 1 ] && echo "[4/4] Done!"

EXEC_SIZE=$(stat -f%z "$OUTPUT" 2>/dev/null || stat -c%s "$OUTPUT" 2>/dev/null)
echo "Delivered: $OUTPUT ($EXEC_SIZE bytes)"
