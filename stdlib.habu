; Habu Standard Library

; Identity function
(defun identity (x) x)

; Constant combinator
(defun constantly (x)
  (lambda (y) x))

; Function composition (f . g)(x) = f(g(x))
(defun compose (f g)
  (lambda (x) (f (g x))))

; Flip argument order
(defun flip (f)
  (lambda (a b) (f b a)))

; Boolean operations
(defun not (x) (if x nil t))

(defun and2 (a b) (if a b nil))
(defun or2 (a b) (if a a b))

; Arithmetic helpers
(defun inc (n) (+ n 1))
(defun dec (n) (- n 1))
(defun zerop (n) (= n 0))
(defun plusp (n) (> n 0))
(defun minusp (n) (< n 0))
(defun evenp (n) (= (mod n 2) 0))
(defun oddp (n) (= (mod n 2) 1))
(defun abs (n) (if (< n 0) (- 0 n) n))
(defun max2 (a b) (if (> a b) a b))
(defun min2 (a b) (if (< a b) a b))

; Equality - eql is same as eq for now (no floats with identity)
(defun eql (a b) (eq a b))

; Structural equality
(defun equal (a b)
  (cond
    ((eq a b) t)
    ((and (consp a) (consp b))
     (and (equal (car a) (car b))
          (equal (cdr a) (cdr b))))
    ((and (stringp a) (stringp b))
     (string= a b))
    (t nil)))

; Error signaling via condition system
(defun error (msg) (signal (quote error) msg))
(defun warn (msg) (signal (quote warning) msg))

; ignore-errors - catch any error and return nil
(defmacro ignore-errors (&rest forms)
  `(handler-case (progn ,@forms)
     (error (c) (values nil c))))

; List operations
(defun null (x) (eq x nil))
(defun atom (x) (not (consp x)))

(defun cadr (x) (car (cdr x)))
(defun caddr (x) (car (cdr (cdr x))))
(defun caar (x) (car (car x)))
(defun cddr (x) (cdr (cdr x)))
(defun cadar (x) (car (cdr (car x))))

(defun first (x) (car x))
(defun second (x) (cadr x))
(defun third (x) (caddr x))
(defun rest (x) (cdr x))

; List construction
(defun list1 (a) (cons a nil))
(defun list2 (a b) (cons a (cons b nil)))
(defun list3 (a b c) (cons a (cons b (cons c nil))))
(defun list4 (a b c d) (cons a (cons b (cons c (cons d nil)))))

; Length with TCO
(defun length-aux (lst acc)
  (if (null lst)
      acc
      (length-aux (cdr lst) (+ acc 1))))

(defun length (lst)
  (length-aux lst 0))

; Append
(defun append (xs ys)
  (if (null xs)
      ys
      (cons (car xs) (append (cdr xs) ys))))

; Reverse with TCO
(defun reverse-aux (lst acc)
  (if (null lst)
      acc
      (reverse-aux (cdr lst) (cons (car lst) acc))))

(defun reverse (lst)
  (reverse-aux lst nil))

; Map (applies f to each element)
(defun map (f lst)
  (if (null lst)
      nil
      (cons (f (car lst)) (map f (cdr lst)))))

; CL-compatible mapcar alias
(defun mapcar (f lst) (map f lst))

; Mapc - like map but for side effects, returns nil
(defun mapc (f lst)
  (if (null lst)
      nil
      (progn (f (car lst))
             (mapc f (cdr lst)))))

; Filter (keeps elements where pred is true)
(defun filter (pred lst)
  (if (null lst)
      nil
      (if (pred (car lst))
          (cons (car lst) (filter pred (cdr lst)))
          (filter pred (cdr lst)))))

; Fold left (reduce)
(defun foldl (f acc lst)
  (if (null lst)
      acc
      (foldl f (f acc (car lst)) (cdr lst))))

; Fold right
(defun foldr (f acc lst)
  (if (null lst)
      acc
      (f (car lst) (foldr f acc (cdr lst)))))

;; CL-compatible reduce
;; Type: (fn: A -> B -> A) -> (seq: List<B>) -> A  [with initial-value]
;;       (fn: A -> A -> A) -> (seq: List<A>) -> A  [without initial-value]
;; TYPING NOTE: CL reduce has complex polymorphism - the return type depends on
;; whether initial-value is provided. With initial-value, fn:(A,B)->A returns A.
;; Without initial-value, fn:(A,A)->A and seq must be non-empty, returns A.
;; A fully typed version would need dependent types or overloading.
(defun reduce (fn seq &key initial-value from-end)
  (let ((lst (if from-end (reverse seq) seq)))
    (if initial-value
        (foldl fn initial-value lst)
        (if (null lst)
            (fn)  ; CL spec: call fn with no args if seq empty and no init
            (foldl fn (car lst) (cdr lst))))))

; Take first n elements
(defun take (n lst)
  (if (or2 (zerop n) (null lst))
      nil
      (cons (car lst) (take (dec n) (cdr lst)))))

; Drop first n elements
(defun drop (n lst)
  (if (or2 (zerop n) (null lst))
      lst
      (drop (dec n) (cdr lst))))

; Nth element (0-indexed)
(defun nth (n lst)
  (if (zerop n)
      (car lst)
      (nth (dec n) (cdr lst))))

; Last element
(defun last (lst)
  (if (null (cdr lst))
      (car lst)
      (last (cdr lst))))

; Any/All predicates
(defun any (pred lst)
  (if (null lst)
      nil
      (if (pred (car lst))
          t
          (any pred (cdr lst)))))

(defun all (pred lst)
  (if (null lst)
      t
      (if (pred (car lst))
          (all pred (cdr lst))
          nil)))

; Member test
(defun member (x lst)
  (if (null lst)
      nil
      (if (eq x (car lst))
          lst
          (member x (cdr lst)))))

; Assoc - find pair in alist by key
(defun assoc (key alist)
  (if (null alist)
      nil
      (if (eq key (car (car alist)))
          (car alist)
          (assoc key (cdr alist)))))

; list* - like list but last arg is tail
(defun list* args
  (if (null (cdr args))
      (car args)
      (cons (car args) (apply list* (cdr args)))))

; Zip two lists
(defun zip (xs ys)
  (if (or2 (null xs) (null ys))
      nil
      (cons (list2 (car xs) (car ys))
            (zip (cdr xs) (cdr ys)))))

; Range [start, end)
(defun range-aux (n end acc)
  (if (= n end)
      acc
      (range-aux (inc n) end (cons n acc))))

(defun range (start end)
  (reverse (range-aux start end nil)))

; Sum/Product
(defun sum (lst)
  (foldl (lambda (a b) (+ a b)) 0 lst))

(defun product (lst)
  (foldl (lambda (a b) (* a b)) 1 lst))

; Factorial
(defun factorial-aux (n acc)
  (if (zerop n)
      acc
      (factorial-aux (dec n) (* n acc))))

(defun factorial (n)
  (factorial-aux n 1))

; Fibonacci with TCO
(defun fib-aux (n a b)
  (if (zerop n)
      a
      (fib-aux (dec n) b (+ a b))))

(defun fib (n)
  (fib-aux n 0 1))

; ============================================================================
; Macros
; ============================================================================

; when - execute body if test is true
(defmacro when (test &rest body)
  (list 'if test (cons 'progn body)))

; unless - execute body if test is false
(defmacro unless (test &rest body)
  (list 'if test nil (cons 'progn body)))

; dolist - iterate over list elements
; (dolist (var list) body...) => nil
(defmacro dolist (spec &rest body)
  (let ((var (car spec))
        (lst (cadr spec))
        (loop-fn (gensym)))
    (list 'let (list (list loop-fn
                           (list 'lambda (list var)
                                 (cons 'progn body))))
          (list 'mapc loop-fn lst)
          nil)))

; dotimes - iterate n times
; (dotimes (var n) body...) => nil
(defmacro dotimes (spec &rest body)
  (let ((var (car spec))
        (count (cadr spec))
        (loop-fn (gensym))
        (i (gensym)))
    (list 'let (list (list loop-fn
                           (list 'lambda (list var)
                                 (cons 'progn body))))
          (list 'let (list (list i 0))
                (list 'block nil
                      (list 'loop
                            (list 'when (list '>= i count)
                                  (list 'return-from nil nil))
                            (list loop-fn i)
                            (list 'setq i (list '+ i 1))))))))

; incf - increment place (simple version for variables only)
(defmacro incf (place &optional (delta 1))
  (list 'setq place (list '+ place delta)))

; decf - decrement place
(defmacro decf (place &optional (delta 1))
  (list 'setq place (list '- place delta)))

; push - push value onto list (destructive)
; (push val place) => new-list
(defmacro push (val place)
  (list 'setq place (list 'cons val place)))

; pop - pop value from list (destructive)
; (pop place) => first-element
(defmacro pop (place)
  (let ((temp (gensym)))
    (list 'let (list (list temp (list 'car place)))
          (list 'setq place (list 'cdr place))
          temp)))

; cond - multi-way conditional
; Already have this as a special form, but define macro version for completeness
; (Note: cond is a special form in Habu, so this is just documentation)

; case - dispatch on value (simple version)
; Note: In Habu, 't' at read time becomes the value t (= fixnum 1), not a symbol.
; So we check (eq keys t) not (eq keys 't)
(defmacro case (keyform &rest clauses)
  (let ((key (gensym)))
    (list 'let (list (list key keyform))
          (cons 'cond
                (mapcar (lambda (clause)
                          (let ((keys (car clause))
                                (body (cdr clause)))
                            (if (or (eq keys t) (eq keys 'otherwise))
                                (cons t body)
                                (list (list 'member key (list 'quote
                                              (if (consp keys) keys (list keys))))
                                      (cons 'progn body)))))
                        clauses)))))

; prog1 - evaluate forms, return first value
(defmacro prog1 (first &rest rest)
  (let ((result (gensym)))
    (list 'let (list (list result first))
          (cons 'progn rest)
          result)))

; prog2 - evaluate forms, return second value
(defmacro prog2 (first second &rest rest)
  (list 'progn first
        (cons 'prog1 (cons second rest))))

; and - short-circuit logical and (macro version)
(defmacro and (&rest forms)
  (if (null forms)
      t
      (if (null (cdr forms))
          (car forms)
          (list 'if (car forms)
                (cons 'and (cdr forms))
                nil))))

; or - short-circuit logical or (macro version)
(defmacro or (&rest forms)
  (if (null forms)
      nil
      (if (null (cdr forms))
          (car forms)
          (let ((temp (gensym)))
            (list 'let (list (list temp (car forms)))
                  (list 'if temp temp
                        (cons 'or (cdr forms))))))))

; aif - anaphoric if (binds 'it' to test value)
(defmacro aif (test then &optional else)
  (list 'let (list (list 'it test))
        (list 'if 'it then else)))

; awhen - anaphoric when
(defmacro awhen (test &rest body)
  (list 'aif test (cons 'progn body)))

; with-gensyms - bind multiple gensyms
(defmacro with-gensyms (names &rest body)
  (list 'let
        (mapcar (lambda (name) (list name (list 'gensym))) names)
        (cons 'progn body)))

;; ============================================================
;; Higher-order sequence functions
;; ============================================================

; remove-if - remove elements satisfying predicate
(defun remove-if (pred lst)
  (cond
    ((null lst) nil)
    ((pred (car lst)) (remove-if pred (cdr lst)))
    (t (cons (car lst) (remove-if pred (cdr lst))))))

; remove-if-not - remove elements NOT satisfying predicate
(defun remove-if-not (pred lst)
  (remove-if (lambda (x) (not (pred x))) lst))

; find-if - find first element satisfying predicate
(defun find-if (pred lst)
  (cond
    ((null lst) nil)
    ((pred (car lst)) (car lst))
    (t (find-if pred (cdr lst)))))

; find-if-not - find first element NOT satisfying predicate
(defun find-if-not (pred lst)
  (find-if (lambda (x) (not (pred x))) lst))

; position-if - find position of first element satisfying predicate
(defun position-if-aux (pred lst n)
  (cond
    ((null lst) nil)
    ((pred (car lst)) n)
    (t (position-if-aux pred (cdr lst) (+ n 1)))))

(defun position-if (pred lst)
  (position-if-aux pred lst 0))

; position-if-not - find position of first element NOT satisfying predicate
(defun position-if-not (pred lst)
  (position-if (lambda (x) (not (pred x))) lst))

; count-if - count elements satisfying predicate
(defun count-if-aux (pred lst n)
  (cond
    ((null lst) n)
    ((pred (car lst)) (count-if-aux pred (cdr lst) (+ n 1)))
    (t (count-if-aux pred (cdr lst) n))))

(defun count-if (pred lst)
  (count-if-aux pred lst 0))

; count-if-not - count elements NOT satisfying predicate
(defun count-if-not (pred lst)
  (count-if (lambda (x) (not (pred x))) lst))

; every - true if predicate holds for all elements
(defun every (pred lst)
  (cond
    ((null lst) t)
    ((not (pred (car lst))) nil)
    (t (every pred (cdr lst)))))

; some - true if predicate holds for some element, returns that element
(defun some (pred lst)
  (cond
    ((null lst) nil)
    ((pred (car lst)) (car lst))
    (t (some pred (cdr lst)))))

; notevery - true if predicate fails for some element
(defun notevery (pred lst)
  (not (every pred lst)))

; notany - true if predicate fails for all elements
(defun notany (pred lst)
  (not (some pred lst)))

; subseq - extract subsequence (start is inclusive, end is exclusive)
(defun subseq (seq start &optional end)
  (let ((lst (drop start seq)))
    (if end
        (take (- end start) lst)
        lst)))

; substitute - replace old with new in sequence
(defun substitute (new old seq &key (test 'eql))
  (mapcar (lambda (x) (if (test x old) new x)) seq))

; substitute-if - replace elements satisfying pred with new
(defun substitute-if (new pred seq)
  (mapcar (lambda (x) (if (pred x) new x)) seq))

; substitute-if-not - replace elements NOT satisfying pred with new
(defun substitute-if-not (new pred seq)
  (substitute-if new (lambda (x) (not (pred x))) seq))

; nsubstitute - destructive substitute (for now, same as substitute)
(defun nsubstitute (new old seq &key (test 'eql))
  (substitute new old seq :test test))

;; ============================================================
;; Destructuring
;; ============================================================

; destructuring-bind - bind pattern to value and evaluate body
; Supports: symbols, (a b c), (a . rest), (a b &rest rest), (a &optional b)
(defmacro destructuring-bind (pattern expr &rest body)
  (let ((temp (gensym "EXPR")))
    (list 'let (list (list temp expr))
          (cons 'let
                (cons (destructuring-bind-bindings pattern temp)
                      body)))))

; Helper: generate binding list for destructuring-bind
(defun destructuring-bind-bindings (pattern expr)
  (cond
    ; Simple variable
    ((symbolp pattern)
     (if (eq pattern '_)
         nil  ; Ignore underscore
         (list (list pattern expr))))

    ; Null pattern - no bindings
    ((null pattern) nil)

    ; Cons pattern (a . b) or list pattern (a b c)
    ((consp pattern)
     (let ((first (car pattern))
           (rest (cdr pattern)))
       (cond
         ; &rest binding
         ((eq first '&rest)
          (if (and (consp rest) (symbolp (car rest)))
              (list (list (car rest) expr))
              (error "Invalid &rest pattern")))

         ; &optional binding
         ((eq first '&optional)
          (destructuring-bind-optional rest expr))

         ; Dotted pair (a . b)
         ((and (symbolp first) (symbolp rest) rest)
          (append (destructuring-bind-bindings first (list 'car expr))
                  (destructuring-bind-bindings rest (list 'cdr expr))))

         ; List pattern
         (t
          (append (destructuring-bind-bindings first (list 'car expr))
                  (destructuring-bind-bindings rest (list 'cdr expr)))))))

    ; Unknown pattern
    (t (error "Invalid destructuring pattern"))))

; Helper for &optional parameters
(defun destructuring-bind-optional (params expr)
  (if (null params)
      nil
      (let ((param (car params))
            (rest (cdr params)))
        (cond
          ((eq param '&rest)
           (destructuring-bind-bindings (cons '&rest rest) expr))
          ((symbolp param)
           (cons (list param (list 'car expr))
                 (destructuring-bind-optional rest (list 'cdr expr))))
          ((consp param)
           ; (var default) form
           (let ((var (car param))
                 (default (cadr param)))
             (cons (list var (list 'if expr (list 'car expr) default))
                   (destructuring-bind-optional rest (list 'cdr expr)))))
          (t (error "Invalid &optional parameter"))))))

;; ============================================================
;; String Functions
;; ============================================================

; string= - case-sensitive string equality
(defun string= (s1 s2)
  (string-equal s1 s2))

; string/= - case-sensitive string inequality  
(defun string/= (s1 s2)
  (not (string= s1 s2)))

; string< - lexicographic less-than
(defun string< (s1 s2)
  (string-lt s1 s2))

; string> - lexicographic greater-than
(defun string> (s1 s2)
  (string< s2 s1))

; string<= - lexicographic less-than-or-equal
(defun string<= (s1 s2)
  (not (string> s1 s2)))

; string>= - lexicographic greater-than-or-equal
(defun string>= (s1 s2)
  (not (string< s1 s2)))

; char-whitespace-p - check if character is whitespace
(defun char-whitespace-p (c)
  (or (char= c #\Space)
      (char= c #\Tab)
      (char= c #\Newline)
      (char= c #\Return)))

; string-trim-left-aux - helper for left trim
(defun string-trim-left-aux (chars s i)
  (if (>= i (length s))
      ""
      (if (member (char s i) chars :test #'char=)
          (string-trim-left-aux chars s (+ i 1))
          (subseq s i))))

; string-left-trim - remove leading characters
(defun string-left-trim (chars s)
  (let ((char-list (if (stringp chars)
                       (string-to-list chars)
                       chars)))
    (string-trim-left-aux char-list s 0)))

; string-trim-right-aux - helper for right trim  
(defun string-trim-right-aux (chars s i)
  (if (< i 0)
      ""
      (if (member (char s i) chars :test #'char=)
          (string-trim-right-aux chars s (- i 1))
          (subseq s 0 (+ i 1)))))

; string-right-trim - remove trailing characters
(defun string-right-trim (chars s)
  (let ((char-list (if (stringp chars)
                       (string-to-list chars)
                       chars))
        (len (length s)))
    (if (= len 0)
        ""
        (string-trim-right-aux char-list s (- len 1)))))

; string-trim - remove leading and trailing characters
(defun string-trim (chars s)
  (string-right-trim chars (string-left-trim chars s)))

;; ============================================================
;; Copy Functions
;; ============================================================

; copy-list - shallow copy of list structure
(defun copy-list (lst)
  (if (null lst)
      nil
      (cons (car lst) (copy-list (cdr lst)))))

; copy-tree - deep copy of tree structure
(defun copy-tree (tree)
  (if (consp tree)
      (cons (copy-tree (car tree))
            (copy-tree (cdr tree)))
      tree))

; copy-seq - copy sequence (for lists, same as copy-list)
(defun copy-seq (seq)
  (if (vectorp seq)
      (let* ((len (length seq))
             (new (make-vector len nil)))
        (dotimes (i len new)
          (setf (svref new i) (svref seq i))))
      (copy-list seq)))

;; ============================================================
;; Type Dispatch Macros
;; ============================================================

; typecase - dispatch on type of expression
(defmacro typecase (keyform &rest clauses)
  (let ((key (gensym "KEY")))
    (list 'let (list (list key keyform))
          (cons 'cond
                (mapcar (lambda (clause)
                          (let ((type-spec (car clause))
                                (body (cdr clause)))
                            (if (or (eq type-spec 't)
                                    (eq type-spec 'otherwise))
                                (cons t body)
                                (cons (list 'typep key (list 'quote type-spec))
                                      body))))
                        clauses)))))

; etypecase - error-signaling typecase
(defmacro etypecase (keyform &rest clauses)
  (let ((key (gensym "KEY")))
    (list 'let (list (list key keyform))
          (cons 'cond
                (append
                 (mapcar (lambda (clause)
                           (let ((type-spec (car clause))
                                 (body (cdr clause)))
                             (cons (list 'typep key (list 'quote type-spec))
                                   body)))
                         clauses)
                 (list (list t (list 'error "No matching type in etypecase"))))))))

; ecase - error-signaling case
(defmacro ecase (keyform &rest clauses)
  (let ((key (gensym "KEY")))
    (list 'let (list (list key keyform))
          (cons 'cond
                (append
                 (mapcar (lambda (clause)
                           (let ((keys (car clause))
                                 (body (cdr clause)))
                             (if (listp keys)
                                 (cons (cons 'member (list key (list 'quote keys)))
                                       body)
                                 (cons (list 'eql key (list 'quote keys))
                                       body))))
                         clauses)
                 (list (list t (list 'error "No matching key in ecase"))))))))

; ccase - correctable ecase (for now, same as ecase)
(defmacro ccase (keyform &rest clauses)
  (cons 'ecase (cons keyform clauses)))

; ctypecase - correctable etypecase (for now, same as etypecase)
(defmacro ctypecase (keyform &rest clauses)
  (cons 'etypecase (cons keyform clauses)))

;; ============================================================
;; Sorting Functions
;; ============================================================

; merge - merge two sorted lists
(defun merge-lists (l1 l2 pred)
  (cond
    ((null l1) l2)
    ((null l2) l1)
    ((funcall pred (car l1) (car l2))
     (cons (car l1) (merge-lists (cdr l1) l2 pred)))
    (t
     (cons (car l2) (merge-lists l1 (cdr l2) pred)))))

; split-list - split list into two halves
(defun split-list (lst)
  (let ((slow lst)
        (fast (cdr lst)))
    (loop while (and fast (cdr fast))
          do (setq slow (cdr slow))
             (setq fast (cddr fast)))
    (let ((second (cdr slow)))
      (rplacd slow nil)
      (values lst second))))

; sort - merge sort (stable)
(defun sort (seq pred)
  (if (or (null seq) (null (cdr seq)))
      seq
      (multiple-value-bind (left right) (split-list (copy-list seq))
        (merge-lists (sort left pred)
                     (sort right pred)
                     pred))))

; stable-sort - same as sort (merge sort is stable)
(defun stable-sort (seq pred)
  (sort seq pred))

;; ============================================================
;; Sequence Concatenation
;; ============================================================

; concatenate - concatenate sequences into result type
(defun concatenate (result-type &rest seqs)
  (let ((combined (apply #'append (mapcar (lambda (s)
                                            (if (vectorp s)
                                                (coerce s 'list)
                                                s))
                                          seqs))))
    (cond
      ((eq result-type 'list) combined)
      ((eq result-type 'string)
       (list-to-string combined))
      ((eq result-type 'vector)
       (coerce combined 'vector))
      (t combined))))

; coerce - convert between sequence types
(defun coerce (object result-type)
  (cond
    ; Same type - return as-is
    ((and (eq result-type 'list) (listp object)) object)
    ((and (eq result-type 'vector) (vectorp object)) object)
    ((and (eq result-type 'string) (stringp object)) object)
    ; List to vector
    ((and (eq result-type 'vector) (listp object))
     (let* ((len (length object))
            (vec (make-vector len nil)))
       (let ((i 0))
         (dolist (x object vec)
           (setf (svref vec i) x)
           (setq i (+ i 1))))))
    ; Vector to list
    ((and (eq result-type 'list) (vectorp object))
     (let ((lst nil)
           (len (length object)))
       (dotimes (i len (nreverse lst))
         (push (svref object (- len i 1)) lst))))
    ; String to list
    ((and (eq result-type 'list) (stringp object))
     (string-to-list object))
    ; List to string
    ((and (eq result-type 'string) (listp object))
     (list-to-string object))
    ; Character to string
    ((and (eq result-type 'string) (characterp object))
     (make-string 1 object))
    (t (error "Cannot coerce to type"))))

;; ============================================================
;; Multiple Value Utilities
;; ============================================================

; multiple-value-setq - set variables from multiple values
(defmacro multiple-value-setq (vars form)
  (let ((vals (gensym "VALS")))
    (list 'let (list (list vals (list 'multiple-value-list form)))
          (cons 'progn
                (let ((i 0))
                  (mapcar (lambda (var)
                            (prog1
                                (list 'setq var (list 'nth i vals))
                              (setq i (+ i 1))))
                          vars))))))

; nth-value - get nth value from multiple-value form
(defmacro nth-value (n form)
  (list 'nth n (list 'multiple-value-list form)))

;; ============================================================
;; Search and Fill Functions
;; ============================================================

; search - find subsequence in sequence
(defun search (seq1 seq2 &key (test 'eql) (start1 0) (start2 0))
  (let ((len1 (- (length seq1) start1))
        (len2 (- (length seq2) start2)))
    (if (> len1 len2)
        nil
        (search-aux seq1 seq2 start1 start2 len1 test))))

(defun search-aux (seq1 seq2 s1 s2 len1 test)
  (cond
    ((> (+ s2 len1) (length seq2)) nil)
    ((search-match seq1 seq2 s1 s2 len1 test) s2)
    (t (search-aux seq1 seq2 s1 (+ s2 1) len1 test))))

(defun search-match (seq1 seq2 s1 s2 len test)
  (if (= len 0)
      t
      (and (funcall test (elt seq1 s1) (elt seq2 s2))
           (search-match seq1 seq2 (+ s1 1) (+ s2 1) (- len 1) test))))

; mismatch - find first position where sequences differ
(defun mismatch (seq1 seq2 &key (test 'eql) (start1 0) (start2 0))
  (mismatch-aux seq1 seq2 start1 start2 test))

(defun mismatch-aux (seq1 seq2 i1 i2 test)
  (cond
    ((>= i1 (length seq1))
     (if (>= i2 (length seq2)) nil i1))
    ((>= i2 (length seq2)) i1)
    ((not (funcall test (elt seq1 i1) (elt seq2 i2))) i1)
    (t (mismatch-aux seq1 seq2 (+ i1 1) (+ i2 1) test))))

; fill - fill sequence with value
(defun fill (seq item &key (start 0) end)
  (let ((real-end (or end (length seq))))
    (if (vectorp seq)
        (dotimes (i (- real-end start) seq)
          (setf (svref seq (+ start i)) item))
        (fill-list seq item start real-end 0))))

(defun fill-list (lst item start end i)
  (cond
    ((null lst) nil)
    ((>= i end) lst)
    ((< i start) (cons (car lst) (fill-list (cdr lst) item start end (+ i 1))))
    (t (cons item (fill-list (cdr lst) item start end (+ i 1))))))

; replace - copy elements from one sequence to another
(defun replace (seq1 seq2 &key (start1 0) end1 (start2 0) end2)
  (let ((real-end1 (or end1 (length seq1)))
        (real-end2 (or end2 (length seq2))))
    (let ((count (min (- real-end1 start1) (- real-end2 start2))))
      (dotimes (i count seq1)
        (setf (elt seq1 (+ start1 i)) (elt seq2 (+ start2 i)))))))

;; ============================================================
;; Prog Special Forms
;; ============================================================

; prog - sequential execution with local bindings and tags
(defmacro prog (bindings &rest body)
  (list 'block nil
        (cons 'let bindings
              (list (cons 'tagbody body)))))

; prog* - like prog but bindings are sequential
(defmacro prog* (bindings &rest body)
  (list 'block nil
        (cons 'let* bindings
              (list (cons 'tagbody body)))))

; prog1 - evaluate forms, return first value
(defmacro prog1 (first &rest rest)
  (let ((result (gensym "RESULT")))
    (list 'let (list (list result first))
          (cons 'progn rest)
          result)))

; prog2 - evaluate forms, return second value  
(defmacro prog2 (first second &rest rest)
  (list 'progn
        first
        (cons 'prog1 (cons second rest))))

;; ============================================================
;; Hash Table Functions
;; ============================================================

; clrhash - clear all entries from hash table
(defun clrhash (table)
  (maphash (lambda (k v)
             (declare (ignore v))
             (remhash k table))
           table)
  table)

; hash-table-keys - get list of all keys
(defun hash-table-keys (table)
  (let ((keys nil))
    (maphash (lambda (k v)
               (declare (ignore v))
               (push k keys))
             table)
    keys))

; hash-table-values - get list of all values
(defun hash-table-values (table)
  (let ((vals nil))
    (maphash (lambda (k v)
               (declare (ignore k))
               (push v vals))
             table)
    vals))

; hash-table-alist - convert hash table to alist
(defun hash-table-alist (table)
  (let ((alist nil))
    (maphash (lambda (k v)
               (push (cons k v) alist))
             table)
    alist))

; alist-hash-table - convert alist to hash table
(defun alist-hash-table (alist &key (test 'eql))
  (let ((table (make-hash-table :test test)))
    (dolist (pair alist table)
      (setf (gethash (car pair) table) (cdr pair)))))

; copy-hash-table - shallow copy of hash table
(defun copy-hash-table (table)
  (let ((new (make-hash-table :test (hash-table-test table))))
    (maphash (lambda (k v)
               (setf (gethash k new) v))
             table)
    new))

; hash-table-test - get test function of hash table
; (placeholder - returns 'eql for now)
(defun hash-table-test (table)
  (declare (ignore table))
  'eql)

; hash-table-size - get allocated size
; (placeholder - returns count for now)
(defun hash-table-size (table)
  (hash-table-count table))

;; ============================================================
;; Condition System
;; ============================================================

; Simple condition representation as a cons: (type . data)

; define-condition - define a condition type
; For now, just creates a constructor function
(defmacro define-condition (name parent-types slots &rest options)
  (declare (ignore parent-types options))
  (let ((slot-names (mapcar (lambda (s) (if (consp s) (car s) s)) slots)))
    (list 'defun name slot-names
          (list 'list (list 'quote name)
                (cons 'list
                      (mapcar (lambda (s) (list 'cons (list 'quote s) s))
                              slot-names))))))

; make-condition - create a condition instance
(defun make-condition (type &rest args)
  (cons type (plist-alist args)))

; Convert plist to alist
(defun plist-alist (plist)
  (if (null plist)
      nil
      (cons (cons (car plist) (cadr plist))
            (plist-alist (cddr plist)))))

; condition-type - get type of condition
(defun condition-type (condition)
  (car condition))

; condition-slot - get slot value from condition
(defun condition-slot (condition slot-name)
  (cdr (assoc slot-name (cdr condition))))

; handler-bind - establish condition handlers
(defmacro handler-bind (bindings &rest body)
  (if (null bindings)
      (cons 'progn body)
      (let ((binding (car bindings)))
        (list 'catch '%condition%
              (list 'handler-bind (cdr bindings)
                    (cons 'progn body))))))

; signal - signal a condition (can be handled)
(defun signal (condition)
  (throw '%condition% condition))

; error-condition - signal an error condition
(defun error-condition (condition)
  (throw '%condition% condition))

; cerror - continuable error
(defun cerror (format-string condition)
  (declare (ignore format-string))
  (signal condition))

; warn - issue a warning
(defun warn (format-string &rest args)
  (apply #'format t format-string args)
  (terpri)
  nil)

; simple-condition - basic condition with format control
(defun simple-condition (format-control &rest format-arguments)
  (cons 'simple-condition
        (list (cons 'format-control format-control)
              (cons 'format-arguments format-arguments))))

; simple-error - basic error condition
(defun simple-error (format-control &rest format-arguments)
  (cons 'simple-error
        (list (cons 'format-control format-control)
              (cons 'format-arguments format-arguments))))

;; ============================================================
;; Generalized Reference (SETF)
;; ============================================================

; psetf - parallel setf (evaluate all values before assigning)
(defmacro psetf (&rest pairs)
  (if (null pairs)
      nil
      (let ((places nil)
            (values nil)
            (temps nil))
        ; Collect places, values, and generate temps
        (let ((rest pairs))
          (loop while rest do
                (let ((place (car rest))
                      (value (cadr rest))
                      (temp (gensym "TEMP")))
                  (push place places)
                  (push (list temp value) temps)
                  (push temp values)
                  (setq rest (cddr rest)))))
        ; Generate let with all temps, then setf all places
        (list 'let (nreverse temps)
              (cons 'progn
                    (mapcar (lambda (p v) (list 'setf p v))
                            (nreverse places)
                            (nreverse values)))))))

; rotatef - rotate values through places
(defmacro rotatef (&rest places)
  (if (null places)
      nil
      (if (null (cdr places))
          nil
          (let ((temps (mapcar (lambda (p) 
                                 (declare (ignore p))
                                 (gensym "TEMP"))
                               places)))
            (list 'let (mapcar #'list temps places)
                  (cons 'psetf
                        (apply #'append
                               (mapcar #'list 
                                       places
                                       (append (cdr temps) (list (car temps)))))))))))

; shiftf - shift values through places, return first
(defmacro shiftf (&rest places-and-value)
  (let ((places (butlast places-and-value))
        (value (car (last places-and-value))))
    (if (null places)
        value
        (let ((result (gensym "RESULT"))
              (temps (mapcar (lambda (p)
                               (declare (ignore p))
                               (gensym "TEMP"))
                             (cdr places))))
          (list 'let (cons (list result (car places))
                           (mapcar #'list temps (cdr places)))
                (cons 'psetf
                      (apply #'append
                             (mapcar #'list
                                     places
                                     (append temps (list value)))))
                result)))))

; incf - increment place
(defmacro incf (place &optional (delta 1))
  (list 'setf place (list '+ place delta)))

; decf - decrement place
(defmacro decf (place &optional (delta 1))
  (list 'setf place (list '- place delta)))
