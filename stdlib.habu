; Habu Standard Library

; defconstant - define constant (same as defvar for now)
(defmacro defconstant (name value &optional doc)
  (declare (ignore doc))
  `(defvar ,name ,value))

; defparameter - define parameter (same as defvar)
(defmacro defparameter (name value &optional doc)
  (declare (ignore doc))
  `(defvar ,name ,value))

; Mathematical constants
(defvar pi 3.141592653589793)
(defvar e 2.718281828459045)

; Printer control variables
(defvar *print-escape* t)
(defvar *print-case* :upcase)
(defvar *print-readably* nil)
(defvar *print-length* nil)
(defvar *print-level* nil)
(defvar *print-base* 10)
(defvar *print-radix* nil)
(defvar *print-gensym* t)
(defvar *print-array* t)

; Identity function
(defun identity (x) x)

; Constant combinator
(defun constantly (x)
  (lambda (y) x))

; Function composition (f . g)(x) = f(g(x))
(defun compose (f g)
  (lambda (x) (funcall f (funcall g x))))

; Flip argument order
(defun flip (f)
  (lambda (a b) (funcall f b a)))

; Boolean operations
(defun not (x) (if x nil t))

(defun and2 (a b) (if a b nil))
(defun or2 (a b) (if a a b))

; List construction - must come before macros that use list
(defun list (&rest args) args)

; Arithmetic helpers
(defun inc (n) (+ n 1))
(defun dec (n) (- n 1))
(defun zerop (n) (= n 0))
(defun plusp (n) (> n 0))
(defun minusp (n) (< n 0))
(defun evenp (n) (= (mod n 2) 0))
(defun oddp (n) (= (mod n 2) 1))
(defun abs (n) (if (< n 0) (- 0 n) n))
(defun max2 (a b) (if (> a b) a b))
(defun min2 (a b) (if (< a b) a b))

; Equality - eql is same as eq for now (no floats with identity)
(defun eql (a b) (eq a b))

; Structural equality
(defun equal (a b)
  (cond
    ((eq a b) t)
    ((and (consp a) (consp b))
     (and (equal (car a) (car b))
          (equal (cdr a) (cdr b))))
    ((and (stringp a) (stringp b))
     (string= a b))
    (t nil)))

; Error signaling - simplified stub
(defun error (msg)
  (print msg)
  nil)

(defun warn (msg)
  (print msg)
  nil)

; ignore-errors - catch any error and return nil
(defmacro ignore-errors (&rest forms)
  `(handler-case (progn ,@forms)
     (error (c) (values nil c))))

; List operations
(defun null (x) (eq x nil))
(defun atom (x) (not (consp x)))

(defun cadr (x) (car (cdr x)))
(defun caddr (x) (car (cdr (cdr x))))
(defun caar (x) (car (car x)))
(defun cddr (x) (cdr (cdr x)))
(defun cadar (x) (car (cdr (car x))))

(defun first (x) (car x))
(defun second (x) (cadr x))
(defun third (x) (caddr x))
(defun fourth (x) (nth 3 x))
(defun fifth (x) (nth 4 x))
(defun sixth (x) (nth 5 x))
(defun seventh (x) (nth 6 x))
(defun eighth (x) (nth 7 x))
(defun ninth (x) (nth 8 x))
(defun tenth (x) (nth 9 x))
(defun rest (x) (cdr x))

; List construction - moved earlier
(defun list1 (a) (cons a nil))
(defun list2 (a b) (cons a (cons b nil)))
(defun list3 (a b c) (cons a (cons b (cons c nil))))
(defun list4 (a b c d) (cons a (cons b (cons c (cons d nil)))))

; Length with TCO (for lists)
(defun length-aux (lst acc)
  (if (null lst)
      acc
      (length-aux (cdr lst) (+ acc 1))))

; length - works on lists, strings, and vectors
(defun length (seq)
  (cond
    ((null seq) 0)
    ((stringp seq) (string-length seq))
    ((vectorp seq) (vector-length seq))
    (t (length-aux seq 0))))

; list-length - CL-compatible list length (returns nil for circular lists)
; For now, just calls length (no circular detection)
(defun list-length (lst)
  (if (null lst) 0 (length-aux lst 0)))

; Append - the built-in append only takes 2 args
; For multi-arg append, use append*
(defun append* (&rest lists)
  (labels ((helper (lsts)
             (if (null lsts)
                 nil
               (if (null (cdr lsts))
                   (car lsts)
                 (append (car lsts) (helper (cdr lsts)))))))
    (helper lists)))

; flatten1 - flatten one level of nesting (concat list of lists)
(defun flatten1 (lists)
  (if (null lists)
      nil
    (append (car lists) (flatten1 (cdr lists)))))

; Reverse with TCO
(defun reverse-aux (lst acc)
  (if (null lst)
      acc
      (reverse-aux (cdr lst) (cons (car lst) acc))))

(defun reverse (lst)
  (reverse-aux lst nil))

; Map (applies f to each element)
(defun map (f lst)
  (if (null lst)
      nil
      (cons (funcall f (car lst)) (map f (cdr lst)))))

; CL-compatible mapcar alias
(defun mapcar (f lst) (map f lst))

; mapcar2 - mapcar over two lists in parallel
(defun mapcar2 (f lst1 lst2)
  (if (or (null lst1) (null lst2))
      nil
    (cons (funcall f (car lst1) (car lst2))
          (mapcar2 f (cdr lst1) (cdr lst2)))))

; Mapc - like map but for side effects, returns nil
(defun mapc (f lst)
  (if (null lst)
      nil
      (progn (funcall f (car lst))
             (mapc f (cdr lst)))))

; Filter (keeps elements where pred is true)
(defun filter (pred lst)
  (if (null lst)
      nil
      (if (funcall pred (car lst))
          (cons (car lst) (filter pred (cdr lst)))
          (filter pred (cdr lst)))))

; Fold left (reduce)
(defun foldl (f acc lst)
  (if (null lst)
      acc
      (foldl f (funcall f acc (car lst)) (cdr lst))))

; Fold right
(defun foldr (f acc lst)
  (if (null lst)
      acc
      (funcall f (car lst) (foldr f acc (cdr lst)))))

;; CL-compatible reduce
;; Type: (fn: A -> B -> A) -> (seq: List<B>) -> A  [with initial-value]
;;       (fn: A -> A -> A) -> (seq: List<A>) -> A  [without initial-value]
;; TYPING NOTE: CL reduce has complex polymorphism - the return type depends on
;; whether initial-value is provided. With initial-value, fn:(A,B)->A returns A.
;; Without initial-value, fn:(A,A)->A and seq must be non-empty, returns A.
;; A fully typed version would need dependent types or overloading.
;; Sentinel for "no initial value provided"
(defvar *reduce-no-init* (cons nil nil))

(defun reduce (fn seq &key (initial-value *reduce-no-init*) from-end)
  (let ((has-init (not (eq initial-value *reduce-no-init*))))
    (if from-end
        ;; Right fold: (fn elem (fn elem (fn elem init)))
        (if has-init
            (foldr fn initial-value seq)
            (if (null seq)
                (funcall fn)
                (foldr fn (car (last seq)) (butlast seq))))
        ;; Left fold: (fn (fn (fn init elem) elem) elem)
        (if has-init
            (foldl fn initial-value seq)
            (if (null seq)
                (funcall fn)
                (foldl fn (car seq) (cdr seq)))))))

; Take first n elements
(defun take (n lst)
  (if (or2 (zerop n) (null lst))
      nil
      (cons (car lst) (take (dec n) (cdr lst)))))

; Drop first n elements
(defun drop (n lst)
  (if (or2 (zerop n) (null lst))
      lst
      (drop (dec n) (cdr lst))))

; Nth element (0-indexed)
(defun nth (n lst)
  (if (zerop n)
      (car lst)
      (nth (dec n) (cdr lst))))

; last is a primitive that returns the last cons cell

; butlast - return copy of list without last n elements (default 1)
(defun butlast (lst &optional (n 1))
  (let ((len (length lst)))
    (if (<= len n)
        nil
        (butlast-aux lst (- len n)))))

(defun butlast-aux (lst n)
  (if (<= n 0)
      nil
      (cons (car lst) (butlast-aux (cdr lst) (- n 1)))))

(defun nbutlast (lst &optional (n 1))
  (let ((len (length lst)))
    (if (<= len n)
        nil
        (let ((tail (nthcdr (- len n 1) lst)))
          (rplacd tail nil)
          lst))))

; Any/All predicates
(defun any (pred lst)
  (if (null lst)
      nil
      (if (funcall pred (car lst))
          t
          (any pred (cdr lst)))))

(defun all (pred lst)
  (if (null lst)
      t
      (if (funcall pred (car lst))
          (all pred (cdr lst))
          nil)))

; Member test - find item in list
(defun member (x lst &key test)
  (if (null lst)
      nil
      (if (if test
              (funcall test x (car lst))
              (eql x (car lst)))
          lst
          (if test
              (member x (cdr lst) :test test)
              (member x (cdr lst))))))

; Assoc - find pair in alist by key
(defun assoc (key alist)
  (if (null alist)
      nil
      (if (eq key (car (car alist)))
          (car alist)
          (assoc key (cdr alist)))))

; list* - like list but last arg is tail
(defun list* args
  (if (null (cdr args))
      (car args)
      (cons (car args) (apply list* (cdr args)))))

; Zip two lists
(defun zip (xs ys)
  (if (or2 (null xs) (null ys))
      nil
      (cons (list2 (car xs) (car ys))
            (zip (cdr xs) (cdr ys)))))

; Range [start, end)
(defun range-aux (n end acc)
  (if (= n end)
      acc
      (range-aux (inc n) end (cons n acc))))

(defun range (start end)
  (reverse (range-aux start end nil)))

; Sum/Product
(defun sum (lst)
  (foldl (lambda (a b) (+ a b)) 0 lst))

(defun product (lst)
  (foldl (lambda (a b) (* a b)) 1 lst))

; Factorial
(defun factorial-aux (n acc)
  (if (zerop n)
      acc
      (factorial-aux (dec n) (* n acc))))

(defun factorial (n)
  (factorial-aux n 1))

; Fibonacci with TCO
(defun fib-aux (n a b)
  (if (zerop n)
      a
      (fib-aux (dec n) b (+ a b))))

(defun fib (n)
  (fib-aux n 0 1))

; ============================================================================
; Macros
; ============================================================================

; when - execute body if test is true
(defmacro when (test &rest body)
  (list 'if test (cons 'progn body)))

; unless - execute body if test is false
(defmacro unless (test &rest body)
  (list 'if test nil (cons 'progn body)))

; return - shorthand for (return-from nil value)
; Used to exit from block with name nil (implicit in loop, dolist, dotimes)
(defmacro return (&optional value)
  (list 'return-from nil value))

; dolist - iterate over list elements
; (dolist (var list [result]) body...) => result (with var bound to nil)
(defmacro dolist (spec &rest body)
  (let ((var (car spec))
        (lst (cadr spec))
        (result (caddr spec))
        (list-var (gensym "list")))
    (list 'let (list (list list-var lst))
          (list 'block nil
                (list 'loop
                      (list 'when (list 'null list-var)
                            (list 'return-from nil (list 'let (list (list var nil)) result)))
                      (list 'let (list (list var (list 'car list-var)))
                            (cons 'progn body))
                      (list 'setq list-var (list 'cdr list-var)))))))

; dotimes - iterate n times
; (dotimes (var n [result]) body...) => result (with var bound to n)
(defmacro dotimes (spec &rest body)
  (let ((var (car spec))
        (count (cadr spec))
        (result (caddr spec))
        (n (gensym)))
    ; Bind count once to avoid multiple evaluation
    (list 'let (list (list n count))
          (list 'let (list (list var 0))
                (list 'block nil
                      (list 'loop
                            (list 'when (list '>= var n)
                                  (list 'return-from nil result))
                            (cons 'progn body)
                            (list 'setq var (list '+ var 1))))))))

; psetq-collect - helper to collect vars/vals/tmps from pairs
(defun psetq-collect (pairs vars vals tmps)
  (if (null pairs)
      (list (reverse vars) (reverse vals) (reverse tmps))
    (let ((v (car pairs))
          (e (cadr pairs))
          (tmp (gensym)))
      (psetq-collect (cddr pairs)
                     (cons v vars)
                     (cons e vals)
                     (cons tmp tmps)))))

; psetq - parallel setq (evaluates all values before assigning)
; (psetq var1 val1 var2 val2 ...) => nil
(defmacro psetq (&rest pairs)
  (if (null pairs)
      nil
    (let* ((collected (psetq-collect pairs nil nil nil))
           (vars (car collected))
           (vals (cadr collected))
           (tmps (caddr collected)))
      ; generate: (let ((tmp1 val1) ...) (setq var1 tmp1) ... nil)
      (list 'let (mapcar2 (lambda (tmp val) (list tmp val)) tmps vals)
            (cons 'progn
                  (append (mapcar2 (lambda (var tmp) (list 'setq var tmp)) vars tmps)
                          (list nil)))))))

; do - general iteration macro (parallel binding)
; (do ((var init step) ...) (end-test result...) body...)
; Uses while instead of loop to avoid forward reference
(defmacro do (bindings end-clause &rest body)
  (let ((vars (mapcar #'car bindings))
        (inits (mapcar #'cadr bindings))
        (steps (mapcar (lambda (b) (if (cddr b) (caddr b) (car b))) bindings))
        (end-test (car end-clause))
        (result (cdr end-clause)))
    (list 'block nil
          (list 'let (mapcar2 (lambda (v i) (list v i)) vars inits)
                (list 'while (list 'not end-test)
                      (cons 'progn body)
                      (list* 'psetq (flatten1 (mapcar2 (lambda (v s) (list v s)) vars steps))))
                (cons 'progn (if result result (list nil)))))))

; do* - general iteration macro (sequential binding)
; (do* ((var init step) ...) (end-test result...) body...)
(defmacro do* (bindings end-clause &rest body)
  (let ((vars (mapcar #'car bindings))
        (inits (mapcar #'cadr bindings))
        (steps (mapcar (lambda (b) (if (cddr b) (caddr b) (car b))) bindings))
        (end-test (car end-clause))
        (result (cdr end-clause)))
    (list 'block nil
          (list 'let* (mapcar2 (lambda (v i) (list v i)) vars inits)
                (list 'while (list 'not end-test)
                      (cons 'progn body)
                      (cons 'progn (mapcar2 (lambda (v s) (list 'setq v s)) vars steps)))
                (cons 'progn (if result result (list nil)))))))

; setf - generalized assignment
; Handles: symbols, (car x), (cdr x), (svref v i), (aref a i), (gethash k h)
(defmacro setf (place value)
  (if (symbolp place)
      (list 'setq place value)
    (if (consp place)
        (let ((op (car place))
              (rest (cdr place)))
          (cond
            ((eq op 'car) (list 'rplaca (car rest) value))
            ((eq op 'cdr) (list 'rplacd (car rest) value))
            ((eq op 'first) (list 'rplaca (car rest) value))
            ((eq op 'rest) (list 'rplacd (car rest) value))
            ((eq op 'svref) (list '%svset (car rest) (car (cdr rest)) value))
            ((eq op 'aref) (cons '%aset (append* rest (list value))))
            ((eq op 'char) (list '%sset (car rest) (car (cdr rest)) value))
            ((eq op 'gethash) (list 'puthash (car rest) value (car (cdr rest))))
            ((eq op 'nth) (list 'rplaca (list 'nthcdr (car rest) (car (cdr rest))) value))
            ((eq op 'elt)
             ; (setf (elt seq index) val) - works for lists and vectors
             (let ((seq (car rest))
                   (idx (car (cdr rest)))
                   (g (gensym "V"))
                   (s (gensym "S")))
               (list 'let (list (list g value) (list s seq))
                     (list 'if (list 'vectorp s)
                           (list 'progn (list '%svset s idx g) g)
                           (list 'progn (list 'rplaca (list 'nthcdr idx s) g) g)))))
            ((eq op 'getf)
             ; (setf (getf plist key) val) - plist-var must be a symbol
             (let ((plist-var (car rest))
                   (key (car (cdr rest)))
                   (g (gensym "V")))
               (if (symbolp plist-var)
                   ; Expand to: (let ((g value)) (if (plist-update! plist key g) g (progn (setq plist (cons key (cons g plist))) g)))
                   (list 'let (list (list g value))
                         (list 'if (list '%plist-update! plist-var key g)
                               g
                               (list 'progn
                                     (list 'setq plist-var (list 'cons key (list 'cons g plist-var)))
                                     g)))
                   (error "setf getf: plist must be a variable"))))
            ((eq op 'char) (list '%string-set (car rest) (car (cdr rest)) value))
            ((eq op 'slot-value) (list '%set-slot-value (car rest) (car (cdr rest)) value))
            (t (error "setf: unsupported place"))))
      (error "setf: invalid place"))))

; incf - increment place (works with setf places)
(defmacro incf (place &optional (delta 1))
  (if (symbolp place)
      (list 'setq place (list '+ place delta))
    (let ((tmp (gensym "TMP")))
      (list 'let (list (list tmp (list '+ place delta)))
            (list 'setf place tmp)))))

; decf - decrement place (works with setf places)
(defmacro decf (place &optional (delta 1))
  (if (symbolp place)
      (list 'setq place (list '- place delta))
    (let ((tmp (gensym "TMP")))
      (list 'let (list (list tmp (list '- place delta)))
            (list 'setf place tmp)))))

; 1+ - add one to number
(defun 1+ (n) (+ n 1))

; 1- - subtract one from number
(defun 1- (n) (- n 1))

; add1/sub1 - aliases for compatibility
(defun add1 (n) (+ n 1))
(defun sub1 (n) (- n 1))

; push - push value onto list (destructive)
; (push val place) => new-list
(defmacro push (val place)
  (list 'setq place (list 'cons val place)))

; pop - pop value from list (destructive)
; (pop place) => first-element
(defmacro pop (place)
  (let ((temp (gensym)))
    (list 'let (list (list temp (list 'car place)))
          (list 'setq place (list 'cdr place))
          temp)))

; pushnew - push value if not already present
(defmacro pushnew (val place &key (test '#'eql))
  (let ((v (gensym)))
    (list 'let (list (list v val))
          (list 'unless (list 'member v place)
                (list 'push v place)))))

; cond - multi-way conditional
; Already have this as a special form, but define macro version for completeness
; (Note: cond is a special form in Habu, so this is just documentation)

; case - dispatch on value (simple version)
; Note: In Habu, 't' at read time becomes the value t (= fixnum 1), not a symbol.
; So we check (eq keys t) not (eq keys 't)
(defmacro case (keyform &rest clauses)
  (let ((key (gensym)))
    (list 'let (list (list key keyform))
          (cons 'cond
                (mapcar (lambda (clause)
                          (let ((keys (car clause))
                                (body (cdr clause)))
                            (if (or (eq keys t) (eq keys 'otherwise))
                                (cons t body)
                                (list (list 'member key (list 'quote
                                              (if (consp keys) keys (list keys))))
                                      (cons 'progn body)))))
                        clauses)))))

; prog1 - evaluate forms, return first value
; prog2 - evaluate forms, return second value
(defmacro prog2 (first second &rest rest)
  (list 'progn first
        (cons 'prog1 (cons second rest))))

; and/or - use built-in special forms (macros are broken)
