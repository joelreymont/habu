        "gate_details": gate,
    }


def rank_gc_actions(gc_compare: dict, gc_norm: dict, gc_stats: dict):
    means = gc_stats.get("means", {})
    conf_by_metric = gc_stats.get("confidence_by_metric", {})
    run_confidence = float(gc_stats.get("confidence", 1.0))

    def metric_actual(field: str, fallback: float):
        value = means.get(field)
        if isinstance(value, (int, float)):
            return float(value)
        return fallback

    def gap_min(field: str):
        d = gc_norm.get("gate_details", {}).get(field, {})
        target = float(d.get("target_min", 0.0))
        actual_base = float(d.get("actual", 0.0))
        actual = metric_actual(field, actual_base)
        if target <= 0.0:
            return 0.0
        return max(0.0, (target - actual) / target)

    avg_gap = gap_min("avg_pause_ratio")
    p95_gap = gap_min("p95_pause_ratio")
    thr_gap = gap_min("throughput_ratio")
    conf_avg = float(conf_by_metric.get("avg_pause_ratio", run_confidence))
    conf_p95 = float(conf_by_metric.get("p95_pause_ratio", run_confidence))
    conf_thr = float(conf_by_metric.get("throughput_ratio", run_confidence))

    habu = gc_compare.get("habu", {})
    avg_pause = float(habu.get("avg_pause_ns", 0.0))
    avg_copy = float(habu.get("avg_copy_ns", 0.0))
    copy_share = (avg_copy / avg_pause) if avg_pause > 0.0 else 0.0
    promote_rate = float(gc_norm.get("gc_promote_rate", 0.0))
    hot_class = gc_norm.get("alloc_hot_class", "none")
    rss_ratio = gc_norm.get("rss_ratio")

    raw = []
    raw.append(
        {
            "dot": "habu-nursery-policy-derive-d65d5879",
            "action": "Derive adaptive nursery control law from live/survival feedback",
            "score_base": 0.55 * max(avg_gap, thr_gap) + 0.45 * p95_gap,
            "confidence": min(conf_avg, conf_thr, conf_p95),
            "reason": "avg/throughput gate gaps dominate with full-live copying pressure",
        }
    )
    raw.append(
        {
            "dot": "habu-debt-integrate-trigger-c402efa2",
            "action": "Integrate debt-trigger pacing for smoother pause/throughput tradeoff",
            "score_base": 0.60 * avg_gap + 0.40 * p95_gap,
            "confidence": min(conf_avg, conf_p95),
            "reason": "static trigger under-shoots gate targets across pause and throughput",
        }
    )
    raw.append(
        {
            "dot": "habu-major-gc-incremental-068b1148",
            "action": "Implement incremental major mark slices to cut tail pauses",
            "score_base": p95_gap,
            "confidence": conf_p95,
            "reason": "p95/p99 remain far below target; slicing needed for latency tail",
        }
    )
    raw.append(
        {
            "dot": "habu-rset-add-scan-13787e2c",
            "action": "Add remembered-set scan fast paths and reduce rescan overhead",
            "score_base": copy_share * max(thr_gap, avg_gap),
            "confidence": min(conf_thr, conf_avg),
            "reason": f"copy-share {copy_share:.4f} indicates copy/scavenge dominates pause budget",
        }
    )
    raw.append(
        {
            "dot": "habu-tenuring-adaptive-threshold-34c571a8",
            "action": "Tune adaptive tenuring threshold from promote/survival telemetry",
            "score_base": 0.50 * avg_gap + 0.50 * min(1.0, max(0.0, 0.02 - promote_rate) / 0.02),
            "confidence": conf_avg,
            "reason": f"promote-rate {promote_rate:.6f} with hot class {hot_class} suggests tenure policy mismatch",
        }
    )
    if isinstance(rss_ratio, (float, int)):
        raw.append(
            {
                "dot": "habu-los-threshold-auto-6d2a6cc1",
                "action": "Auto-tune LOS threshold and reuse policy",
                "score_base": max(0.0, min(1.0, float(rss_ratio) - 1.0)),
                "confidence": float(conf_by_metric.get("rss_ratio", run_confidence)),
                "reason": f"rss-ratio {float(rss_ratio):.4f} vs parity max 1.2",
            }
        )

    for action in raw:
        confidence = float(action.get("confidence", run_confidence))
        score_base = float(action.get("score_base", 0.0))
        action["score"] = score_base * confidence
        action["reason"] = (
            f"{action['reason']}; conf={confidence:.3f}; runs={gc_stats.get('runs', 1)}"
        )

    ranked = sorted(raw, key=lambda a: a["score"], reverse=True)
    for i, a in enumerate(ranked, start=1):
        a["rank"] = i
    return ranked


def validate_gc_report(gc_norm: dict, actions: list):
    errs = []
    req_norm = (
        "gate_level",
        "gate_pass",
        "avg_pause_ratio",
        "p95_pause_ratio",
        "p99_pause_ratio",
        "throughput_ratio",
        "alloc_sample_n",
        "alloc_hot_class",
        "gc_survive_n",
        "gc_promote_n",
        "gc_promote_rate",
        "gc_nursery_target",
        "gc_nursery_scale",
        "gc_nursery_survival",
        "gc_nursery_pause_error",
        "gate_details",
    )
    for k in req_norm:
        if k not in gc_norm:
            errs.append(f"missing gc_summary.{k}")

    if not isinstance(actions, list) or not actions:
        errs.append("gc_actions empty")
    else:
        prev_score = None
        for i, a in enumerate(actions, start=1):
            for k in ("rank", "dot", "action", "score", "reason"):
                if k not in a:
                    errs.append(f"gc_actions[{i-1}] missing {k}")
            if a.get("rank") != i:
                errs.append(f"gc_actions[{i-1}] rank {a.get('rank')} != {i}")
            score = a.get("score")
            if not isinstance(score, (int, float)):
                errs.append(f"gc_actions[{i-1}] score non-numeric")
            else:
                if score < 0.0:
                    errs.append(f"gc_actions[{i-1}] score negative")
                if prev_score is not None and score > prev_score + 1e-12:
                    errs.append("gc_actions not sorted by descending score")
                prev_score = float(score)

    gate_pass = bool(gc_norm.get("gate_pass", False))
    top_score = float(actions[0]["score"]) if actions else 0.0
    if not gate_pass and top_score <= 0.0:
        errs.append("gate failed but top gc action score is non-positive")

    return {"ok": len(errs) == 0, "errors": errs}


def append_history_record(path: str, record: dict):
    directory = os.path.dirname(path)
    if directory:
        os.makedirs(directory, exist_ok=True)
    with open(path, "a", encoding="utf-8") as fh:
        fh.write(json.dumps(record, separators=(",", ":")))
        fh.write("\n")


def load_history_tail(path: str, window: int):
    if window <= 0 or not os.path.exists(path):
        return [], 0
    tail = deque(maxlen=window)
    total = 0
    with open(path, "r", encoding="utf-8") as fh:
        for line in fh:
            raw = line.strip()
            if not raw:
                continue
            try:
                entry = json.loads(raw)
            except json.JSONDecodeError:
                continue
            tail.append(entry)
            total += 1
    return list(tail), total


def numeric_trend(samples: list[float]):
    if not samples:
        return None
    latest = float(samples[-1])
    previous = float(samples[-2]) if len(samples) >= 2 else latest
    delta_prev = latest - previous
    mean = sum(samples) / float(len(samples))
    return {
        "n": len(samples),
        "latest": latest,
        "previous": previous,
        "delta_prev": delta_prev,
        "mean": mean,
        "min": min(samples),
        "max": max(samples),
    }


def build_trend_lines(history_tail: list):
    def series(metric: str):
        values = []
        for row in history_tail:
            gc_summary = row.get("gc_summary", {})
            val = gc_summary.get(metric)
            if isinstance(val, (int, float)):
                values.append(float(val))
        return values

    gate_vals = []
    top_action_counts = {}
    for row in history_tail:
        gate_pass = row.get("gc_gate_pass")
        if isinstance(gate_pass, bool):
            gate_vals.append(gate_pass)
        actions = row.get("gc_actions", [])
        if actions:
            top_dot = actions[0].get("dot")
            if isinstance(top_dot, str) and top_dot:
                top_action_counts[top_dot] = top_action_counts.get(top_dot, 0) + 1

    top_action_rank = sorted(top_action_counts.items(), key=lambda item: item[1], reverse=True)

    return {
        "avg_pause_ratio": numeric_trend(series("avg_pause_ratio")),
        "p95_pause_ratio": numeric_trend(series("p95_pause_ratio")),
        "throughput_ratio": numeric_trend(series("throughput_ratio")),
        "rss_ratio": numeric_trend(series("rss_ratio")),
        "gate_pass_rate": (
            sum(1 for v in gate_vals if v) / float(len(gate_vals))
            if gate_vals
            else None
        ),
        "top_action_dots": [{"dot": dot, "count": count} for dot, count in top_action_rank[:5]],
    }


def summarize(entries, top):
    slow = sorted(entries, key=lambda e: e.ratio)
    return slow[:top]


def emit_table(entries):
    print(f"{'Suite':<8} {'Bench':<14} {'Habu':>12} {'SBCL':>12} {'Ratio':>10}")
    print("=" * 64)
    for e in entries:
        print(
            f"{e.suite:<8} {e.name:<14} {e.habu_ns/1e6:>10.3f} ms {e.sbcl_ns/1e6:>10.3f} ms {e.ratio:>8.4f}x"
        )


def emit_actions(entries):
    print("\nAction loop:")
    for i, e in enumerate(entries, start=1):
        print(f"{i}. [{e.suite}:{e.name}] {e.note}")


