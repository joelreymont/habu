@dataclass
class Entry:
    suite: str
    name: str
    habu_ns: int
    sbcl_ns: int
    ratio: float
    note: str


def parse_args():
    p = argparse.ArgumentParser()
    p.add_argument("--iters", type=int, default=1, help="comprehensive bench iterations")
    p.add_argument("--scale", type=int, default=1, help="maxima workload scale")
    p.add_argument("--heap-mb", type=int, default=1024, help="maxima workload heap")
    p.add_argument("--gc-iters", type=int, default=30, help="gc-compare iterations")
    p.add_argument(
        "--gc-runs",
        type=int,
        default=3,
        help="number of repeated gc-compare runs for confidence-weighted ranking",
    )
    p.add_argument("--gc-live-mb", type=int, default=8, help="gc-compare live set")
    p.add_argument("--gc-heap-mb", type=int, default=64, help="gc-compare habu heap")
    p.add_argument(
        "--profile-mutator",
        action="store_true",
        help="enable HABU_PROFILE_MUTATOR for maxima run and report barrier/safepoint overhead",
    )
    p.add_argument(
        "--gate-level",
        default="milestone_2x_from_baseline",
        choices=("milestone_2x_from_baseline", "competitive", "parity"),
        help="GC gate level to evaluate",
    )
    p.add_argument(
        "--with-ocaml",
        action="store_true",
        help="run OCaml adapters when available and include normalized status/errors",
    )
    p.add_argument(
        "--history-file",
        default="bench/results/perf_loop_history.jsonl",
        help="append-only JSONL file for persisted perf-loop history",
    )
    p.add_argument(
        "--history-window",
        type=int,
        default=20,
        help="number of most-recent history samples to use for trend summaries",
    )
    p.add_argument(
        "--no-history",
        action="store_true",
        help="disable history persistence and trend summarization",
    )
    p.add_argument("--fail-on-gates", action="store_true", help="exit non-zero if selected GC gate fails")
    p.add_argument("--top", type=int, default=12, help="top bottlenecks to print")
    p.add_argument("--json", action="store_true", help="emit JSON only")
    return p.parse_args()


def run_cmd(argv, timeout=3600, env=None):
    p = subprocess.run(argv, capture_output=True, text=True, timeout=timeout, env=env)
    if p.returncode != 0:
        raise RuntimeError(f"cmd failed: {' '.join(argv)}\nstdout:\n{p.stdout}\nstderr:\n{p.stderr}")
    return p.stdout


def parse_mixed_json(text: str):
    idx = text.rfind('{')
    if idx < 0:
        raise RuntimeError(f"missing JSON payload\n{text}")
    # Walk candidate starts from end to first; pick first valid object.
    starts = [i for i, ch in enumerate(text) if ch == '{']
    for i in reversed(starts):
        frag = text[i:].strip()
        try:
            return json.loads(frag)
        except json.JSONDecodeError:
            pass
    raise RuntimeError(f"unable to parse JSON payload\n{text}")


def advice(name: str, suite: str):
    if suite == "micro":
        if name.startswith("float_"):
            return "Finish native float lowering and remove boxed-float callouts"
        if name in {"mapcar", "reduce"}:
            return "Lower closure/lambda HOF calls to direct JIT targets"
        if name.startswith("sort_"):
            return "Optimize comparator dispatch and recursive sort call paths"
        if name == "string_concat":
            return "Specialize concatenate/string builder path"
        if name == "intern":
            return "Reduce interner contention and string formatting overhead"
        if name in {"assoc", "list_append"}:
            return "Inline hot cons/list traversal primitives in JIT"
        return "Profile and eliminate remaining VM fallback in hot path"

    if name == "limit":
        return "RCA limit recursion/dispatch hotspot and reduce simplifier churn"
    if name == "diff":
        return "Optimize symbolic diff dispatch and simplifya interactions"
    if name in {"factor", "ratsimp"}:
        return "Target rational/factor core loops and reduce allocation pressure"
    if name in {"solve", "determinant"}:
        return "Stabilize remaining module-load gaps and fast-path matrix/solver ops"
    return "Profile CAS opcode mix and remove interpreter/JIT boundary overhead"


def must_ok(result: dict, label: str):
    if result.get("status") == "ok":
        return
    error = result.get("error") or "unknown error"
    stderr = result.get("stderr")
    if stderr:
        raise RuntimeError(f"{label} failed: {error}\nstderr:\n{stderr}")
    raise RuntimeError(f"{label} failed: {error}")


def collect_micro(iters: int, with_ocaml: bool):
    habu_run = bench_pack.run_workload_runtime("habu", "micro", iters=iters, mode="jit")
    sbcl_run = bench_pack.run_workload_runtime("sbcl", "micro", iters=iters, mode="jit")
    ocaml_run = bench_pack.run_workload_runtime("ocaml", "micro", iters=iters, mode="jit") if with_ocaml else None

    must_ok(habu_run, "micro habu runner")
    must_ok(sbcl_run, "micro sbcl runner")

    entries = []
    errs = {}
    ocaml_errs = {}
    sbcl = sbcl_run.get("workloads", {})
    habu = habu_run.get("workloads", {})
    for name in habu_run.get("workload_order", []):
        hb = habu.get(name, {})
        sb = sbcl.get(name, {})
        hb_status = hb.get("status")
        sb_status = sb.get("status")
        hb_ns = int(hb.get("ns", 0))
        sb_ns = int(sb.get("ns", 0))
        if hb_status != "ok" or sb_status != "ok" or hb_ns <= 0 or sb_ns <= 0:
            errs[name] = "habu={hs}:{he} sbcl={ss}:{se}".format(
                hs=hb_status or "missing",
                he=hb.get("error"),
                ss=sb_status or "missing",
                se=sb.get("error"),
            )
            if ocaml_run:
                oc = ocaml_run.get("workloads", {}).get(name, {})
                if oc.get("status") != "ok":
                    ocaml_errs[name] = "ocaml={st}:{err}".format(
                        st=oc.get("status") or "missing",
                        err=oc.get("error"),
                    )
            continue

        ratio = sb_ns / hb_ns
        entries.append(
            Entry(
                suite="micro",
                name=name,
                habu_ns=hb_ns,
                sbcl_ns=sb_ns,
                ratio=ratio,
                note=advice(name, "micro"),
            )
        )
        if ocaml_run:
            oc = ocaml_run.get("workloads", {}).get(name, {})
            if oc.get("status") != "ok":
                ocaml_errs[name] = "ocaml={st}:{err}".format(
                    st=oc.get("status") or "missing",
                    err=oc.get("error"),
                )

    return entries, errs, ocaml_errs, {"habu": habu_run, "sbcl": sbcl_run, "ocaml": ocaml_run}


def mutator_phase(gc_phase: dict):
    wb_calls = int(gc_phase.get("wb_calls", 0))
    wb_ns = int(gc_phase.get("wb_ns", 0))
    wb_jit_calls = int(gc_phase.get("wb_jit_calls", 0))
    wb_jit_ns = int(gc_phase.get("wb_jit_ns", 0))
    wb_vm_calls = max(0, wb_calls - wb_jit_calls)
    wb_vm_ns = max(0, wb_ns - wb_jit_ns)
    sp_vm_calls = int(gc_phase.get("safepoint_vm_calls", 0))
    sp_vm_ns = int(gc_phase.get("safepoint_vm_ns", 0))
    sp_jit_calls = int(gc_phase.get("safepoint_jit_calls", 0))
    sp_jit_ns = int(gc_phase.get("safepoint_jit_ns", 0))
    return {
        "wb_calls": wb_calls,
        "wb_ns": wb_ns,
        "wb_ns_per_call": (wb_ns / wb_calls) if wb_calls else 0.0,
        "wb_vm_calls": wb_vm_calls,
        "wb_vm_ns": wb_vm_ns,
        "wb_vm_ns_per_call": (wb_vm_ns / wb_vm_calls) if wb_vm_calls else 0.0,
        "wb_jit_calls": wb_jit_calls,
        "wb_jit_ns": wb_jit_ns,
        "wb_jit_ns_per_call": (wb_jit_ns / wb_jit_calls) if wb_jit_calls else 0.0,
        "safepoint_vm_calls": sp_vm_calls,
        "safepoint_vm_ns": sp_vm_ns,
        "safepoint_vm_ns_per_call": (sp_vm_ns / sp_vm_calls) if sp_vm_calls else 0.0,
        "safepoint_jit_calls": sp_jit_calls,
        "safepoint_jit_ns": sp_jit_ns,
        "safepoint_jit_ns_per_call": (sp_jit_ns / sp_jit_calls) if sp_jit_calls else 0.0,
    }


def collect_maxima(scale: int, heap_mb: int, profile_mutator: bool, with_ocaml: bool):
    env = os.environ.copy()
    if profile_mutator:
        env["HABU_PROFILE_MUTATOR"] = "1"

    habu_run = bench_pack.run_workload_runtime(
        "habu",
        "maxima",
        scale=scale,
        heap_mb=heap_mb,
        env=env,
    )
    sbcl_run = bench_pack.run_workload_runtime(
        "sbcl",
        "maxima",
        scale=scale,
        heap_mb=heap_mb,
    )
    ocaml_run = (
        bench_pack.run_workload_runtime("ocaml", "maxima", scale=scale, heap_mb=heap_mb) if with_ocaml else None
    )

    must_ok(habu_run, "maxima habu runner")
    must_ok(sbcl_run, "maxima sbcl runner")

    entries = []
    errs = {}
    ocaml_errs = {}
    for name in habu_run.get("workload_order", []):
        hb = habu_run.get("workloads", {}).get(name, {})
        sb = sbcl_run.get("workloads", {}).get(name, {})
        hb_status = hb.get("status")
        sb_status = sb.get("status")
        hb_ns = int(hb.get("ns", 0))
        sb_ns = int(sb.get("ns", 0))

        if hb_status != "ok" or sb_status != "ok" or hb_ns <= 0 or sb_ns <= 0:
            errs[name] = "habu={hs}:{he} sbcl={ss}:{se}".format(
                hs=hb_status or "missing",
                he=hb.get("error"),
                ss=sb_status or "missing",
                se=sb.get("error"),
            )
            if ocaml_run:
                oc = ocaml_run.get("workloads", {}).get(name, {})
                if oc.get("status") != "ok":
                    ocaml_errs[name] = "ocaml={st}:{err}".format(
                        st=oc.get("status") or "missing",
                        err=oc.get("error"),
                    )
            continue

        ratio = sb_ns / hb_ns
        entries.append(
            Entry(
                suite="maxima",
                name=name,
                habu_ns=hb_ns,
                sbcl_ns=sb_ns,
                ratio=ratio,
                note=advice(name, "maxima"),
            )
        )
        if ocaml_run:
            oc = ocaml_run.get("workloads", {}).get(name, {})
            if oc.get("status") != "ok":
                ocaml_errs[name] = "ocaml={st}:{err}".format(
                    st=oc.get("status") or "missing",
                    err=oc.get("error"),
                )

    habu = habu_run.get("payload", {})
    sbcl = sbcl_run.get("payload", {})
    gc = habu.get("gc", {})
    mutator_profile = {
        "enabled": bool(profile_mutator),
        "load": mutator_phase(gc.get("load", {})),
        "run": mutator_phase(gc.get("run", {})),
    }
    return (
        entries,
        errs,
        ocaml_errs,
        habu.get("loader", {}),
        sbcl.get("loader", {}),
        mutator_profile,
        {"habu": habu_run, "sbcl": sbcl_run, "ocaml": ocaml_run},
    )


def collect_gc_gates(
    gc_iters: int,
    gc_live_mb: int,
    gc_heap_mb: int,
    gate_level: str,
    with_ocaml: bool,
    gc_runs: int,
):
    base_cmd = [
        "tools/gc-compare",
        "--json",
        f"--iters={gc_iters}",
        f"--live-mb={gc_live_mb}",
        f"--heap-mb={gc_heap_mb}",
        f"--gate-level={gate_level}",
    ]
    if with_ocaml:
        base_cmd.append("--with-ocaml")

    runs = []
    for _ in range(max(1, gc_runs)):
        out = run_cmd(base_cmd)
        runs.append(parse_mixed_json(out))
    return runs


def gc_run_stats(gc_runs: list):
    fields = ("avg_pause_ratio", "p95_pause_ratio", "throughput_ratio", "rss_ratio")
    values = {field: [] for field in fields}
    for run in gc_runs:
        metrics = run.get("metrics", {})
        for field in fields:
            val = metrics.get(field)
            if isinstance(val, (int, float)):
                values[field].append(float(val))

    means = {}
    stdev = {}
    cv = {}
    confidence_by_metric = {}

    for field, vals in values.items():
        if not vals:
            continue
        mu = sum(vals) / float(len(vals))
        var = 0.0
        for v in vals:
            diff = v - mu
            var += diff * diff
        sigma = math.sqrt(var / float(len(vals)))
        denom = abs(mu)
        coeff = (sigma / denom) if denom > 1e-12 else (0.0 if sigma == 0.0 else 1.0)
        conf = 1.0 / (1.0 + coeff)
        means[field] = mu
        stdev[field] = sigma
        cv[field] = coeff
        confidence_by_metric[field] = conf

    conf_fields = ("avg_pause_ratio", "p95_pause_ratio", "throughput_ratio")
    conf_vals = [confidence_by_metric[f] for f in conf_fields if f in confidence_by_metric]
    confidence = (sum(conf_vals) / float(len(conf_vals))) if conf_vals else 1.0

    return {
        "runs": len(gc_runs),
        "means": means,
        "stdev": stdev,
        "cv": cv,
        "confidence": confidence,
        "confidence_by_metric": confidence_by_metric,
    }


