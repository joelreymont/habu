    args = parse_args()
    os.chdir(os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))

    micro_entries, micro_errs, micro_ocaml_errs, micro_runners = collect_micro(args.iters, args.with_ocaml)
    maxima_entries, maxima_errs, maxima_ocaml_errs, h_loader, s_loader, mutator_profile, maxima_runners = collect_maxima(
        args.scale, args.heap_mb, args.profile_mutator, args.with_ocaml
    )
    gc_runs = collect_gc_gates(
        args.gc_iters,
        args.gc_live_mb,
        args.gc_heap_mb,
        args.gate_level,
        args.with_ocaml,
        args.gc_runs,
    )
    gc_compare = gc_runs[-1]
    gc_stats = gc_run_stats(gc_runs)
    gate_pass = bool(gc_compare.get("gate_pass", False))
    gc_norm = gc_summary(gc_compare, args.gate_level)
    gc_actions = rank_gc_actions(gc_compare, gc_norm, gc_stats)
    gc_validation = validate_gc_report(gc_norm, gc_actions)
    if not gc_validation["ok"]:
