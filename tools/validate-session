#!/bin/bash
# Focused validation harness for session-sized batch changes.
# Codifies the 2026-02-25/26 workflow lessons:
# - run focused, evidence-bearing tests first
# - run explicit MAXIMA macro-hang repro/proof script
# - attempt full suite once with timeout and report blocker if it times out
#
# Usage:
#   tools/validate-session --profile maxima-macro-hang
#   tools/validate-session --profile maxima-macro-hang --strict-full
#   tools/validate-session --profile maxima-macro-hang --no-full

set -euo pipefail

cd "$(dirname "$0")/.."

PROFILE=""
FULL_TIMEOUT_SEC="${FULL_TIMEOUT_SEC:-900}"
TRACE_TIMEOUT_SEC="${TRACE_TIMEOUT_SEC:-600}"
RUN_FULL=1
STRICT_FULL=0
MAXIMA_TIMEOUT_SEC="${MAXIMA_TIMEOUT_SEC:-1200}"

usage() {
  cat <<'EOF'
Usage: tools/validate-session --profile <name> [options]

Profiles:
  maxima-macro-hang

Options:
  --full-timeout <sec>   Timeout for full 'zig build test' attempt (default: 900)
  --trace-timeout <sec>  Timeout for profile runtime trace script (default: 600)
  --maxima-timeout <sec> Timeout for bench-maxima jit/interp smoke runs (default: 1200)
  --no-full              Skip full-suite attempt
  --strict-full          Treat full-suite timeout as failure
  -h|--help              Show help

Notes:
- Focused checks are always strict (non-zero on failure).
- Full-suite timeout (rc=124/137) is reported as blocker unless --strict-full is set.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --profile)
      PROFILE="$2"
      shift 2
      ;;
    --full-timeout)
      FULL_TIMEOUT_SEC="$2"
      shift 2
      ;;
    --trace-timeout)
      TRACE_TIMEOUT_SEC="$2"
      shift 2
      ;;
    --maxima-timeout)
      MAXIMA_TIMEOUT_SEC="$2"
      shift 2
      ;;
    --no-full)
      RUN_FULL=0
      shift
      ;;
    --strict-full)
      STRICT_FULL=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "error: unknown arg: $1" >&2
      usage
      exit 2
      ;;
  esac
done

if [[ -z "$PROFILE" ]]; then
  echo "error: --profile is required" >&2
  usage
  exit 2
fi

run_with_timeout() {
  local secs="$1"
  shift
  if command -v timeout >/dev/null 2>&1; then
    timeout "$secs" "$@"
    return $?
  fi
  if command -v gtimeout >/dev/null 2>&1; then
    gtimeout "$secs" "$@"
    return $?
  fi
  "$@"
}

run_step() {
  local label="$1"
  shift
  echo "[validate] ${label}" >&2
  "$@"
}

run_step_timeout() {
  local label="$1"
  local secs="$2"
  shift 2
  echo "[validate] ${label} (timeout ${secs}s)" >&2
  run_with_timeout "$secs" "$@"
}

run_maxima_compile_run_smoke() {
  local jit_out interp_out jit_err interp_err
  jit_out="$(mktemp -t habu-validate-maxima-jit.XXXXXX)"
  interp_out="$(mktemp -t habu-validate-maxima-interp.XXXXXX)"
  jit_err="$(mktemp -t habu-validate-maxima-jit-err.XXXXXX)"
  interp_err="$(mktemp -t habu-validate-maxima-interp-err.XXXXXX)"

  run_step_timeout "bench-maxima jit smoke" "$MAXIMA_TIMEOUT_SEC" \
    zig build -Duse-hoist=true bench-maxima -- \
      --json --scale=1 --heap-mb=1024 --nursery-mb=32 --promote-age=2 \
      --jit=on --workloads=factor,ratsimp >"$jit_out" 2>"$jit_err"

  run_step_timeout "bench-maxima interp smoke" "$MAXIMA_TIMEOUT_SEC" \
    zig build -Duse-hoist=true bench-maxima -- \
      --json --scale=1 --heap-mb=1024 --nursery-mb=32 --promote-age=2 \
      --jit=off --workloads=factor,ratsimp >"$interp_out" 2>"$interp_err"

  run_step "verify maxima compile+run smoke" python3 - "$jit_out" "$interp_out" <<'PY'
import json
import re
import sys
from pathlib import Path


def parse_tail(path: str) -> dict:
    text = Path(path).read_text()
    m = re.search(r"\{.*\}\s*$", text, re.S)
    if not m:
        raise RuntimeError(f"missing trailing JSON payload in {path}")
    return json.loads(m.group(0))


def check_payload(payload: dict, label: str):
    loader = payload.get("loader", {})
    ok = int(loader.get("ok", 0))
    total = int(loader.get("total", 0))
    fail = int(loader.get("fail", 0))
    if total <= 0 or ok != total or fail != 0:
        raise RuntimeError(
            f"{label}: loader incomplete ok={ok} total={total} fail={fail}"
        )

    bad = []
    for row in payload.get("benches", []):
        if row.get("error") not in (None, "", False):
            bad.append((row.get("name"), row.get("error")))
    if bad:
        raise RuntimeError(f"{label}: workload errors present: {bad}")


jit = parse_tail(sys.argv[1])
interp = parse_tail(sys.argv[2])
check_payload(jit, "jit")
check_payload(interp, "interp")

jit_comp = int(jit.get("jit_compiled", 0))
interp_comp = int(interp.get("jit_compiled", 0))
if jit_comp <= interp_comp:
    raise RuntimeError(
        f"compile delta check failed: jit_compiled={jit_comp} interp_compiled={interp_comp}"
    )

print(
    "[validate] maxima smoke ok: "
    f"loader={jit.get('loader', {}).get('ok', 0)}/{jit.get('loader', {}).get('total', 0)} "
    f"jit_compiled={jit_comp} interp_compiled={interp_comp}"
)
PY
}

run_maxima_macro_hang_profile() {
  run_step "zig build" zig build

  local tests=(
    "stdlib append function designators stay variadic"
    "compileChunk JIT OOM relay propagates OutOfMemory"
    "translateVar remap hit returns scoped local"
    "jit hash helpers handle non-table and table entry paths"
    "findMatchingChunk"
  )

  local t
  for t in "${tests[@]}"; do
    run_step "zig build test -Dtest-filter='${t}'" \
      zig build test -Dtest-filter="${t}"
  done

  run_maxima_compile_run_smoke

  local trace_script="/tmp/mforma_trace.lisp"
  if [[ ! -f "$trace_script" ]]; then
    echo "error: required trace script missing: $trace_script" >&2
    return 1
  fi

  local trace_out
  trace_out="$(mktemp -t habu-validate-session-trace.XXXXXX)"
  if ! run_step_timeout "mforma trace proof" "$TRACE_TIMEOUT_SEC" \
      ./zig-out/bin/habu "$trace_script" >"$trace_out" 2>&1; then
    echo "error: mforma trace execution failed; output: $trace_out" >&2
    tail -40 "$trace_out" >&2 || true
    return 1
  fi

  if ! rg -q "\[PHASE\] mforma done" "$trace_out"; then
    echo "error: mforma trace did not reach completion marker" >&2
    echo "error: expected '[PHASE] mforma done' in $trace_out" >&2
    tail -80 "$trace_out" >&2 || true
    return 1
  fi

  echo "[validate] trace proof ok: [PHASE] mforma done" >&2

  if [[ "$RUN_FULL" -eq 1 ]]; then
    echo "[validate] full-suite attempt: zig build test (timeout ${FULL_TIMEOUT_SEC}s)" >&2
    set +e
    run_with_timeout "$FULL_TIMEOUT_SEC" zig build test
    local full_rc=$?
    set -e

    if [[ "$full_rc" -eq 0 ]]; then
      echo "[validate] full-suite pass" >&2
    elif [[ "$full_rc" -eq 124 || "$full_rc" -eq 137 ]]; then
      if [[ "$STRICT_FULL" -eq 1 ]]; then
        echo "error: full-suite timed out (rc=${full_rc}) under --strict-full" >&2
        return "$full_rc"
      fi
      echo "[validate] full-suite blocker: timed out rc=${full_rc} (recorded, focused suite already passed)" >&2
    else
      echo "error: full-suite failed rc=${full_rc}" >&2
      return "$full_rc"
    fi
  else
    echo "[validate] full-suite attempt skipped (--no-full)" >&2
  fi
}

case "$PROFILE" in
  maxima-macro-hang)
    run_maxima_macro_hang_profile
    ;;
  *)
    echo "error: unknown profile: $PROFILE" >&2
    usage
    exit 2
    ;;
esac

echo "[validate] profile '${PROFILE}' complete" >&2
