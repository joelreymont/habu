#!/usr/bin/env python3
import argparse
import json
import re
import subprocess
import sys
from pathlib import Path


DEFAULT_WORKLOADS = [
    "integrate",
    "ratsimp",
    "factor",
    "solve",
    "determinant",
]

ADM_FIELDS = [
    ("cand", "cand"),
    ("elig", "elig"),
    ("comp", "comp"),
    ("sk_speed", "sk_speed"),
    ("sk_safety", "sk_safety"),
    ("sk_assert", "sk_assert"),
    ("sk_caps", "sk_caps"),
    ("sk_opt", "sk_opt"),
    ("sk_key", "sk_key"),
    ("sk_rest", "sk_rest"),
    ("sk_chunk", "sk_chunk"),
    ("fail_unsupported", "fail_unsup"),
    ("fail_other", "fail_other"),
    ("cache_comp", "cache_comp"),
    ("cache_unsupported", "cache_unsup"),
    ("cache_failed", "cache_fail"),
]


def parse_json_tail(text: str, label: str) -> dict:
    m = re.search(r"\{.*\}\s*$", text, re.S)
    if not m:
        raise RuntimeError(f"{label}: could not locate trailing JSON payload")
    return json.loads(m.group(0))


def ensure_bench_binary() -> Path:
    build_cmd = ["zig", "build", "-Duse-hoist=true"]
    build_proc = subprocess.run(build_cmd, capture_output=True, text=True)
    build_out = (build_proc.stdout or "") + (build_proc.stderr or "")
    if build_proc.returncode != 0:
        raise RuntimeError(f"build failed ({build_proc.returncode})\n{build_out}")

    bench_bin = Path("zig-out/bin/maxima_workload_bench")
    if not bench_bin.exists():
        raise RuntimeError(f"missing benchmark binary: {bench_bin}")
    return bench_bin


def run_bench(
    bench_bin: Path,
    jit_enabled: bool,
    scale: int,
    heap_mb: int,
    nursery_mb: int,
    promote_age: int,
    workloads: list[str],
) -> dict:
    mode = "jit" if jit_enabled else "interp"
    workloads_csv = ",".join(workloads)
    cmd = [
        str(bench_bin),
        "--json",
        f"--scale={scale}",
        f"--heap-mb={heap_mb}",
        f"--nursery-mb={nursery_mb}",
        f"--promote-age={promote_age}",
        f"--jit={'on' if jit_enabled else 'off'}",
        f"--workloads={workloads_csv}",
    ]
    proc = subprocess.run(cmd, capture_output=True, text=True)
    out = (proc.stdout or "") + (proc.stderr or "")
    if proc.returncode != 0:
        raise RuntimeError(f"{mode} run failed ({proc.returncode})\n{out}")
    return parse_json_tail(out, mode)


def benches_by_name(payload: dict) -> dict:
    result = {}
    for b in payload.get("benches", []):
        name = b.get("name")
        if isinstance(name, str):
            result[name] = b
    return result


def summarize(jit: dict, interp: dict, workloads: list[str]) -> dict:
    jit_map = benches_by_name(jit)
    interp_map = benches_by_name(interp)
    rows = []
    for name in workloads:
        jb = jit_map.get(name)
        ib = interp_map.get(name)
        if jb is None or ib is None:
            continue
        jns = int(jb.get("ns", 0))
        ins = int(ib.get("ns", 0))
        speedup = (ins / jns) if jns > 0 else None
        rows.append(
            {
                "name": name,
                "jit_ns": jns,
                "interp_ns": ins,
                "speedup_interp_over_jit": speedup,
                "jit_error": jb.get("error"),
                "interp_error": ib.get("error"),
            }
        )
    rows.sort(key=lambda r: r["jit_ns"], reverse=True)
    jit_adm = jit.get("jit_adm", {}) if isinstance(jit.get("jit_adm", {}), dict) else {}
    interp_adm = interp.get("jit_adm", {}) if isinstance(interp.get("jit_adm", {}), dict) else {}

    def run_call_shape(payload: dict) -> dict:
        call_shape = payload.get("call_shape", {})
        if not isinstance(call_shape, dict):
            return {}
        run = call_shape.get("run", {})
        if not isinstance(run, dict):
            return {}
        out = {}
        for k in ("total", "fixed", "optional", "key", "rest", "dynamic", "tail"):
            v = run.get(k)
            if isinstance(v, int):
                out[k] = int(v)
        return out

    return {
        "workloads": rows,
        "jit_loader_ns": int(jit.get("loader", {}).get("ns", 0)),
        "interp_loader_ns": int(interp.get("loader", {}).get("ns", 0)),
        "jit_compiled": int(jit.get("jit_compiled", 0)),
        "interp_compiled": int(interp.get("jit_compiled", 0)),
        "jit_direct_calls_jit": int(jit.get("jit_direct_calls", 0)),
        "jit_direct_calls_interp": int(interp.get("jit_direct_calls", 0)),
        "jit_adm": {k: int(v) for k, v in jit_adm.items() if isinstance(v, int)},
        "interp_adm": {k: int(v) for k, v in interp_adm.items() if isinstance(v, int)},
        "jit_call_shape": run_call_shape(jit),
        "interp_call_shape": run_call_shape(interp),
    }


def evaluate_gate(summary: dict, min_interp_jit: float, min_jit_wins: int, min_jit_compiled: int) -> dict:
    wins = 0
    checked = 0
    for row in summary.get("workloads", []):
        if row.get("jit_error") is not None or row.get("interp_error") is not None:
            continue
        sp = row.get("speedup_interp_over_jit")
        if sp is None:
            continue
        checked += 1
        if float(sp) >= min_interp_jit:
            wins += 1

    jit_compiled = int(summary.get("jit_compiled", 0))
    interp_compiled = int(summary.get("interp_compiled", 0))

    checks = {
        "wins": {
            "actual": wins,
            "target_min": min_jit_wins,
            "pass": wins >= min_jit_wins,
            "checked": checked,
        },
        "compiled_min": {
            "actual": jit_compiled,
            "target_min": min_jit_compiled,
            "pass": jit_compiled >= min_jit_compiled,
        },
        "compiled_delta": {
            "actual": jit_compiled - interp_compiled,
            "target_min": 1,
            "pass": jit_compiled > interp_compiled,
        },
    }
    gate_pass = all(item["pass"] for item in checks.values())
    return {
        "pass": gate_pass,
        "min_interp_jit": min_interp_jit,
        "checks": checks,
    }


def format_adm_pair(jit_adm: dict, interp_adm: dict) -> str:
    parts = []
    for key, label in ADM_FIELDS:
        parts.append(f"{label}={jit_adm.get(key, 0)}/{interp_adm.get(key, 0)}")
    return " ".join(parts)


def format_text(summary: dict) -> str:
    lines = []
    lines.append("name               jit_ns        interp_ns     interp/jit")
    lines.append("----------------------------------------------------------")
    for row in summary["workloads"]:
        sp = row["speedup_interp_over_jit"]
        sp_txt = f"{sp:.3f}" if sp is not None else "n/a"
        lines.append(
            f"{row['name']:<18} {row['jit_ns']:>12} {row['interp_ns']:>12} {sp_txt:>11}"
        )
    lines.append("")
    lines.append(f"promote_age={summary.get('promote_age', 0)}")
    lines.append(f"loader_ns jit={summary['jit_loader_ns']} interp={summary['interp_loader_ns']}")
    lines.append(f"jit_compiled jit={summary.get('jit_compiled', 0)} interp={summary.get('interp_compiled', 0)}")
    lines.append(
        f"jit_direct_calls jit={summary.get('jit_direct_calls_jit', 0)} interp={summary.get('jit_direct_calls_interp', 0)}"
    )
    if isinstance(summary.get("jit_adm"), dict):
        j = summary.get("jit_adm", {})
        i = summary.get("interp_adm", {})
        lines.append(f"jit_adm {format_adm_pair(j, i)}")
    if isinstance(summary.get("jit_call_shape"), dict):
        j = summary.get("jit_call_shape", {})
        i = summary.get("interp_call_shape", {})
        lines.append(
            "call_shape(run) total={jt}/{it} fixed={jf}/{ifx} optional={jo}/{io} key={jk}/{ik} rest={jr}/{ir} dynamic={jd}/{idn} tail={jtl}/{itl}".format(
                jt=j.get("total", 0),
                it=i.get("total", 0),
                jf=j.get("fixed", 0),
                ifx=i.get("fixed", 0),
                jo=j.get("optional", 0),
                io=i.get("optional", 0),
                jk=j.get("key", 0),
                ik=i.get("key", 0),
                jr=j.get("rest", 0),
                ir=i.get("rest", 0),
                jd=j.get("dynamic", 0),
                idn=i.get("dynamic", 0),
                jtl=j.get("tail", 0),
                itl=i.get("tail", 0),
            )
        )
    gate = summary.get("jit_gate")
    if isinstance(gate, dict):
        lines.append(
            "jit_gate pass={p} wins={w}/{n} min_speedup={s:.3f} compiled={c} delta={d}".format(
                p=gate.get("pass"),
                w=gate.get("checks", {}).get("wins", {}).get("actual", 0),
                n=gate.get("checks", {}).get("wins", {}).get("checked", 0),
                s=gate.get("min_interp_jit", 0.0),
                c=gate.get("checks", {}).get("compiled_min", {}).get("actual", 0),
                d=gate.get("checks", {}).get("compiled_delta", {}).get("actual", 0),
            )
        )
    return "\n".join(lines)


def format_markdown(summary: dict, scale: int, heap_mb: int, nursery_mb: int, promote_age: int) -> str:
    lines = []
    lines.append("# Maxima Hotspots")
    lines.append("")
    lines.append(f"- scale: `{scale}`")
    lines.append(f"- heap_mb: `{heap_mb}`")
    lines.append(f"- nursery_mb: `{nursery_mb}`")
    lines.append(f"- promote_age: `{promote_age}`")
    lines.append("")
    lines.append("| workload | jit_ns | interp_ns | interp/jit |")
    lines.append("|---|---:|---:|---:|")
    for row in summary["workloads"]:
        sp = row["speedup_interp_over_jit"]
        sp_txt = f"{sp:.3f}" if sp is not None else "n/a"
        lines.append(
            f"| {row['name']} | {row['jit_ns']} | {row['interp_ns']} | {sp_txt} |"
        )
    lines.append("")
    lines.append(
        f"- loader_ns: jit=`{summary['jit_loader_ns']}`, interp=`{summary['interp_loader_ns']}`"
    )
    lines.append(
        f"- jit_compiled: jit=`{summary.get('jit_compiled', 0)}`, interp=`{summary.get('interp_compiled', 0)}`"
    )
    lines.append(
        f"- jit_direct_calls: jit=`{summary.get('jit_direct_calls_jit', 0)}`, interp=`{summary.get('jit_direct_calls_interp', 0)}`"
    )
    if isinstance(summary.get("jit_adm"), dict):
        j = summary.get("jit_adm", {})
        i = summary.get("interp_adm", {})
        parts = [f"{label}=`{j.get(key, 0)}/{i.get(key, 0)}`" for key, label in ADM_FIELDS]
        lines.append("- jit_adm: " + ", ".join(parts))
    if isinstance(summary.get("jit_call_shape"), dict):
        j = summary.get("jit_call_shape", {})
        i = summary.get("interp_call_shape", {})
        lines.append(
            "- call_shape(run): total=`{jt}/{it}`, fixed=`{jf}/{ifx}`, optional=`{jo}/{io}`, key=`{jk}/{ik}`, rest=`{jr}/{ir}`, dynamic=`{jd}/{idn}`, tail=`{jtl}/{itl}`".format(
                jt=j.get("total", 0),
                it=i.get("total", 0),
                jf=j.get("fixed", 0),
                ifx=i.get("fixed", 0),
                jo=j.get("optional", 0),
                io=i.get("optional", 0),
                jk=j.get("key", 0),
                ik=i.get("key", 0),
                jr=j.get("rest", 0),
                ir=i.get("rest", 0),
                jd=j.get("dynamic", 0),
                idn=i.get("dynamic", 0),
                jtl=j.get("tail", 0),
                itl=i.get("tail", 0),
            )
        )
    gate = summary.get("jit_gate")
    if isinstance(gate, dict):
        wins = gate.get("checks", {}).get("wins", {})
        comp = gate.get("checks", {}).get("compiled_min", {})
        delta = gate.get("checks", {}).get("compiled_delta", {})
        lines.append(
            "- jit_gate: pass=`{p}`, wins=`{wa}/{wc}` (min speedup `{s:.3f}`, min wins `{wm}`), compiled=`{ca}` (min `{cm}`), delta=`{da}`".format(
                p=gate.get("pass"),
                wa=wins.get("actual", 0),
                wc=wins.get("checked", 0),
                s=gate.get("min_interp_jit", 0.0),
                wm=wins.get("target_min", 0),
                ca=comp.get("actual", 0),
                cm=comp.get("target_min", 0),
                da=delta.get("actual", 0),
            )
        )
    return "\n".join(lines) + "\n"


def main() -> int:
    p = argparse.ArgumentParser(description="Profile Maxima CAS workload hotspots in JIT vs interpreter modes.")
    p.add_argument("--scale", type=int, default=1)
    p.add_argument("--heap-mb", type=int, default=1024)
    p.add_argument("--nursery-mb", type=int, default=24)
    p.add_argument("--promote-age", type=int, default=2)
    p.add_argument(
        "--workloads",
        type=str,
        default=",".join(DEFAULT_WORKLOADS),
        help="comma-separated workload names from bench-maxima output",
    )
    p.add_argument("--min-interp-jit", type=float, default=1.01, help="minimum interp/jit speedup counted as a JIT win")
    p.add_argument("--min-jit-wins", type=int, default=2, help="minimum workload win count required by jit gate")
    p.add_argument(
        "--min-jit-compiled",
        type=int,
        default=None,
        help="minimum compiled-function count required by jit gate (default: number of selected workloads)",
    )
    p.add_argument("--fail-on-gate", action="store_true", help="exit non-zero when jit gate fails")
    p.add_argument("--json", action="store_true", help="print JSON summary")
    p.add_argument("--markdown-out", type=str, default="", help="write markdown report")
    args = p.parse_args()

    workloads = [w.strip() for w in args.workloads.split(",") if w.strip()]
    if not workloads:
        print("no workloads selected", file=sys.stderr)
        return 2
    if args.promote_age <= 0:
        print("promote-age must be >= 1", file=sys.stderr)
        return 2

    try:
        bench_bin = ensure_bench_binary()
        jit = run_bench(bench_bin, True, args.scale, args.heap_mb, args.nursery_mb, args.promote_age, workloads)
        interp = run_bench(bench_bin, False, args.scale, args.heap_mb, args.nursery_mb, args.promote_age, workloads)
        summary = summarize(jit, interp, workloads)
        summary["promote_age"] = int(args.promote_age)
        effective_min_jit_compiled = (
            int(args.min_jit_compiled)
            if args.min_jit_compiled is not None
            else max(1, len(workloads))
        )
        summary["jit_gate"] = evaluate_gate(
            summary,
            args.min_interp_jit,
            args.min_jit_wins,
            effective_min_jit_compiled,
        )
    except Exception as exc:
        print(str(exc), file=sys.stderr)
        return 1

    if args.json:
        print(json.dumps(summary, indent=2))
    else:
        print(format_text(summary))

    if args.markdown_out:
        md = format_markdown(summary, args.scale, args.heap_mb, args.nursery_mb, args.promote_age)
        Path(args.markdown_out).write_text(md)
        print(f"wrote {args.markdown_out}", file=sys.stderr)

    if args.fail_on_gate and not summary.get("jit_gate", {}).get("pass", False):
        return 2

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
