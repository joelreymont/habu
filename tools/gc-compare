def fmt_delta(delta):
    if isinstance(delta, (int, float)):
        return f"{delta:+.6f}"
    return "n/a"


def load_regression_baseline(path: str):
    if not path:
        return None
    if not os.path.exists(path):
        raise RuntimeError(f"regression baseline missing: {path}")
    with open(path, "r", encoding="utf-8") as fh:
        payload = json.load(fh)
    if isinstance(payload, dict) and isinstance(payload.get("metrics"), dict):
        return payload
    if isinstance(payload, dict):
        return {"metrics": payload}
    raise RuntimeError(f"invalid regression baseline format: {path}")


def eval_regressions(metrics: dict, baseline_metrics: dict, slack: float):
    checks = {}
    higher_better = ("avg_pause_ratio", "p95_pause_ratio", "throughput_ratio")
    for key in higher_better:
        base = baseline_metrics.get(key)
        actual = metrics.get(key)
        if not isinstance(base, (int, float)) or not isinstance(actual, (int, float)):
            checks[key] = {
                "actual": actual,
                "baseline": base,
                "threshold_min": None,
                "pass": False,
            }
            continue
        threshold = float(base) * max(0.0, 1.0 - slack)
        checks[key] = {
            "actual": float(actual),
            "baseline": float(base),
            "threshold_min": threshold,
            "pass": float(actual) >= threshold,
        }

    key = "rss_ratio"
    base = baseline_metrics.get(key)
    actual = metrics.get(key)
    if isinstance(base, (int, float)) and isinstance(actual, (int, float)):
        threshold = float(base) * (1.0 + max(0.0, slack))
        checks[key] = {
            "actual": float(actual),
            "baseline": float(base),
            "threshold_max": threshold,
            "pass": float(actual) <= threshold,
        }
    else:
        checks[key] = {
            "actual": actual,
            "baseline": base,
            "threshold_max": None,
            "pass": False,
        }

    return {
        "slack": slack,
        "checks": checks,
        "pass": all(check.get("pass", False) for check in checks.values()),
    }


def require_runner_ok(result, label: str):
    if result.get("status") == "ok":
        return
    error = result.get("error") or "unknown error"
    stderr = result.get("stderr")
    if stderr:
        raise RuntimeError(f"{label} failed: {error}\nstderr:\n{stderr}")
    raise RuntimeError(f"{label} failed: {error}")


def ratio_metrics(habu_payload, ref_payload, habu_rss, ref_rss):
    h_avg = habu_payload.get("avg_pause_ns", 0)
    h_p50 = habu_payload.get("p50_pause_ns", 0)
    h_p95 = habu_payload.get("p95_pause_ns", 0)
    h_p99 = habu_payload.get("p99_pause_ns", 0)
    r_avg = ref_payload.get("avg_pause_ns", 0)
    r_p50 = ref_payload.get("p50_pause_ns", 0)
    r_p95 = ref_payload.get("p95_pause_ns", 0)
    r_p99 = ref_payload.get("p99_pause_ns", 0)

    avg_ratio = (r_avg / h_avg) if h_avg > 0 else 0.0
    p50_ratio = (r_p50 / h_p50) if h_p50 > 0 else 0.0
    p95_ratio = (r_p95 / h_p95) if h_p95 > 0 else 0.0
    p99_ratio = (r_p99 / h_p99) if h_p99 > 0 else 0.0

    h_work = int(habu_payload.get("bytes_copied", 0))
    h_pause_total = int(h_avg) * int(habu_payload.get("gc_count", 0))
    r_work = int(ref_payload.get("live_mb", LIVE_MB)) * 1024 * 1024 * int(ref_payload.get("iters", ITERS))
    r_pause_total = int(r_avg) * int(ref_payload.get("iters", ITERS))
    h_tp = mib_per_sec(h_work, h_pause_total)
    r_tp = mib_per_sec(r_work, r_pause_total)
    throughput_ratio = (h_tp / r_tp) if r_tp > 0 else 0.0

    return {
        "avg_pause_ratio": avg_ratio,
        "p50_pause_ratio": p50_ratio,
        "p95_pause_ratio": p95_ratio,
        "p99_pause_ratio": p99_ratio,
        "habu_mib_per_sec": h_tp,
        "ref_mib_per_sec": r_tp,
        "throughput_ratio": throughput_ratio,
        "rss_ratio": (
            (habu_rss / ref_rss)
            if (habu_rss is not None and ref_rss is not None and ref_rss > 0)
            else None
        ),
    }


