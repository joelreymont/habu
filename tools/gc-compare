        "target_max": level["rss_ratio_max"],
        "pass": (rss_actual is not None and rss_actual <= level["rss_ratio_max"]),
    }
    out["gc_promote_threshold_in_bounds"] = {
        "actual": metrics["gc_promote_threshold_in_bounds"],
        "pass": bool(metrics["gc_promote_threshold_in_bounds"]),
    }
    out["gc_debt_in_bounds"] = {
