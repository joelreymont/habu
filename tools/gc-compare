def parity_rows(gates, level_name: str):
    if not gates:
        return None
    level = gates.get(level_name)
    if not isinstance(level, dict):
        return None
    rows = []
    for metric, detail in level.items():
        if metric == "pass" or not isinstance(detail, dict) or "pass" not in detail:
            continue
        actual = detail.get("actual")
        target_kind = None
        target = None
        delta = None
        if "target_min" in detail:
            target_kind = "min"
            target = detail.get("target_min")
            if isinstance(actual, (int, float)) and isinstance(target, (int, float)):
                delta = float(actual) - float(target)
        elif "target_max" in detail:
            target_kind = "max"
            target = detail.get("target_max")
            if isinstance(actual, (int, float)) and isinstance(target, (int, float)):
                delta = float(target) - float(actual)

        rows.append(
            {
                "metric": metric,
                "actual": actual,
                "target_kind": target_kind,
                "target": target,
                "delta_to_target": delta,
                "pass": bool(detail.get("pass")),
            }
        )
    rows.sort(key=lambda row: row["metric"])
    return rows


