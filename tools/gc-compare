def parse_mixed_json(text: str, label: str):
    starts = [i for i, ch in enumerate(text) if ch == '{']
    for i in reversed(starts):
        frag = text[i:].strip()
        try:
            return json.loads(frag)
        except json.JSONDecodeError:
            pass
    raise RuntimeError(f"{label}: missing JSON payload\n{text}")


def parse_rss_bytes(stderr_text: str):
    for line in stderr_text.splitlines():
        if "maximum resident set size" in line.lower():
            m = re.search(r"(\d+)", line)
            if not m:
                continue
            raw = int(m.group(1))
            if sys.platform == "darwin":
                # macOS /usr/bin/time -l reports bytes.
                return raw
            # GNU time reports kbytes.
            return raw * 1024
    return None


def run_cmd(argv, timeout=1800):
    if os.path.exists("/usr/bin/time"):
        p = subprocess.run(
            ["/usr/bin/time", "-l", *argv],
            capture_output=True,
            text=True,
            timeout=timeout,
        )
        if p.returncode == 0:
            return p, parse_rss_bytes(p.stderr)
        if "illegal option" not in p.stderr.lower():
            return p, parse_rss_bytes(p.stderr)
    p = subprocess.run(argv, capture_output=True, text=True, timeout=timeout)
    return p, None


def run_habu():
    cmd = [
        "zig",
        "build",
        "bench",
        "--",
        "--json",
        f"--iters={ITERS}",
        f"--live-mb={LIVE_MB}",
        f"--heap-mb={HEAP_MB}",
    ]
    p, rss_bytes = run_cmd(cmd, timeout=1800)
    if p.returncode != 0:
        raise RuntimeError(f"habu gc bench failed\nstdout:\n{p.stdout}\nstderr:\n{p.stderr}")
    return parse_mixed_json(p.stdout, "habu"), rss_bytes


def run_sbcl():
    cmd = [
        "sbcl",
        "--script",
        "bench/sbcl_gc.lisp",
        "--json",
        f"--iters={ITERS}",
        f"--live-mb={LIVE_MB}",
    ]
    p, rss_bytes = run_cmd(cmd, timeout=1800)
    if p.returncode != 0:
        raise RuntimeError(f"sbcl gc bench failed\nstdout:\n{p.stdout}\nstderr:\n{p.stderr}")
    return parse_mixed_json(p.stdout, "sbcl"), rss_bytes


def run_maxima():
    cmd = [
        "tools/maxima-bench",
        "--json",
        f"--scale={MAXIMA_SCALE}",
        f"--heap-mb={MAXIMA_HEAP_MB}",
        f"--nursery-mb={MAXIMA_NURSERY_MB}",
    ]
    p, _ = run_cmd(cmd, timeout=3600)
    if p.returncode != 0:
        raise RuntimeError(f"maxima bench failed\nstdout:\n{p.stdout}\nstderr:\n{p.stderr}")
    return parse_mixed_json(p.stdout, "maxima")


def mib_per_sec(work_bytes: int, total_pause_ns: int):
    if work_bytes <= 0 or total_pause_ns <= 0:
        return 0.0
    return (work_bytes / (1024.0 * 1024.0)) / (total_pause_ns / 1e9)


def hot_alloc_class(habu_payload):
    best_name = "none"
    best_n = 0
    for name, key in ALLOC_CLASS_KEYS:
        n = int(habu_payload.get(key, 0))
        if n > best_n:
            best_name = name
            best_n = n
    return best_name, best_n


